{
  "packId": "studio",
  "homeRouteId": "home",
  "root": {
    "kind": "local-origin",
    "note": "Producer serves Studio on this machine, so the root is the origin it runs on."
  },
  "routes": [
    {
      "body": "plain",
      "data": {
        "loader": "home"
      },
      "inputs": {
        "sections.studio.home": "home"
      },
      "manifest": {
        "navigator": "outline",
        "modules": [
          {
            "id": "outline",
            "icon": "assets.icon-outline",
            "label": "Outline",
            "section": "sections.module.outline",
            "source": "page.outline",
            "shortcut": "o"
          },
          {
            "id": "checks",
            "icon": "assets.icon-checks",
            "label": "Checks",
            "section": "sections.module.checks",
            "source": "page.checks",
            "shortcut": "c"
          }
        ],
        "actions": [],
        "wiring": [
          {
            "do": "open outline",
            "expect": "outline open"
          },
          {
            "do": "open checks",
            "expect": "checks open"
          },
          {
            "do": "select outline",
            "expect": "target in view and highlighted"
          },
          {
            "do": "cmdk",
            "expect": "every popover listed with its shortcut"
          },
          {
            "do": "key o",
            "expect": "outline open"
          },
          {
            "do": "key escape",
            "expect": "popover closed"
          },
          {
            "do": "click outside",
            "expect": "popover closed"
          }
        ]
      },
      "instanceId": "home",
      "path": "/",
      "label": "Home"
    },
    {
      "body": "plain",
      "data": {
        "loader": "gallery",
        "agent": "director"
      },
      "inputs": {
        "sections.studio.agent-gallery": "gallery"
      },
      "leaf": {
        "param": "slug",
        "body": "detail",
        "data": {
          "loader": "leaf",
          "agent": "director"
        },
        "sections": [
          "sections.studio.leaf-header",
          "sections.studio.specimen",
          "sections.studio.options",
          "sections.studio.checks",
          "sections.studio.contract",
          "sections.studio.history",
          "sections.studio.references"
        ],
        "inputs": {
          "sections.studio.leaf-header": "header",
          "sections.studio.specimen": "specimen",
          "sections.studio.options": "options",
          "sections.studio.checks": "checks",
          "sections.studio.contract": "contract",
          "sections.studio.history": "history",
          "sections.studio.references": "references"
        },
        "manifest": {
          "navigator": "outline",
          "modules": [
            {
              "id": "outline",
              "icon": "assets.icon-outline",
              "label": "Outline",
              "section": "sections.module.outline",
              "source": "page.outline",
              "shortcut": "o"
            },
            {
              "id": "checks",
              "icon": "assets.icon-checks",
              "label": "Checks",
              "section": "sections.module.checks",
              "source": "page.checks",
              "shortcut": "c"
            },
            {
              "id": "versions",
              "icon": "assets.icon-versions",
              "label": "Versions",
              "section": "sections.module.outline",
              "source": "page.versions",
              "shortcut": "v"
            }
          ],
          "actions": [
            {
              "id": "request-change",
              "icon": "assets.icon-request",
              "label": "Request change",
              "handler": {
                "kind": "copy-prompt",
                "prompt": "Ask {agent} to change {title} ({url}).\n\nWhat should change:"
              },
              "shortcut": "r"
            }
          ],
          "wiring": [
            {
              "do": "open outline",
              "expect": "outline open"
            },
            {
              "do": "open checks",
              "expect": "checks open"
            },
            {
              "do": "open versions",
              "expect": "versions open"
            },
            {
              "do": "open request-change",
              "expect": "request-change open"
            },
            {
              "do": "select outline",
              "expect": "target in view and highlighted"
            },
            {
              "do": "select versions",
              "expect": "target in view and highlighted"
            },
            {
              "do": "copy request-change",
              "expect": "clipboard prompt"
            },
            {
              "do": "cmdk",
              "expect": "every popover listed with its shortcut"
            },
            {
              "do": "key o",
              "expect": "outline open"
            },
            {
              "do": "key escape",
              "expect": "popover closed"
            },
            {
              "do": "click outside",
              "expect": "popover closed"
            }
          ]
        }
      },
      "manifest": {
        "navigator": "explorer",
        "modules": [
          {
            "id": "explorer",
            "icon": "assets.icon-explorer",
            "label": "Explorer",
            "section": "sections.module.explorer",
