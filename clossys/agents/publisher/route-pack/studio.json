          {
            "do": "open checks",
            "expect": "checks open"
          },
          {
            "do": "select explorer",
            "expect": "target in view and highlighted"
          },
          {
            "do": "search explorer",
            "expect": "tree filtered to the match"
          },
          {
            "do": "cmdk",
            "expect": "every popover listed with its shortcut"
          },
          {
            "do": "key e",
