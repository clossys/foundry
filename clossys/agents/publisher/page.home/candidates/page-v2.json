{
  "schema": "clossys.page/1",
  "path": "/",
  "title": "Home",
  "frame": "frames.studio-shell",
  "sections": [
    "sections.studio.home"
  ],
  "copy": {},
  "nav": {
    "nav": true
  },
  "meta": {
    "source": {
      "kind": "original",
      "ref": []
    },
    "entry": {
      "fields": {
        "kind": "page",
        "icon": "assets.icon-home",
        "note": "STUDIO-PUB 2026-10-31: the page is a Publisher assembly of frames.studio-shell plus Designer Studio sections; the agent gallery serves at /<agent> and its leaves at /<agent>/<slug>."
      },
      "blocks": {
        "Actions": [
          {
            "id": "needs",
            "label": "Needs",
            "icon": "assets.icon-needs",
            "defaultOpen": false,
            "module": {
              "section": "sections.task-list",
              "source": "home.open-requests"
            }
          }
        ],
        "Route": {
          "body": "plain",
          "data": {
            "loader": "home"
          },
          "inputs": {
            "sections.studio.home": "home"
          },
          "manifest": {
            "navigator": "outline",
            "modules": [
              {
                "id": "outline",
                "icon": "assets.icon-outline",
                "label": "Outline",
                "section": "sections.module.outline",
                "source": "page.outline",
                "shortcut": "o"
              },
              {
                "id": "checks",
                "icon": "assets.icon-checks",
                "label": "Checks",
                "section": "sections.module.checks",
                "source": "page.checks",
                "shortcut": "c"
              }
            ],
            "actions": [
              {
                "id": "copy-link",
                "icon": "assets.icon-link",
                "label": "Copy link",
                "handler": {
                  "kind": "copy-link"
                },
                "shortcut": "l"
              }
            ],
            "wiring": [
              {
                "do": "open outline",
                "expect": "outline open"
              },
              {
                "do": "open checks",
                "expect": "checks open"
              },
              {
                "do": "open copy-link",
                "expect": "copy-link open"
              },
              {
                "do": "select outline",
                "expect": "target in view and highlighted"
              },
              {
                "do": "copy copy-link",
                "expect": "clipboard link"
              },
              {
                "do": "cmdk",
                "expect": "every popover listed with its shortcut"
              },
              {
                "do": "key o",
                "expect": "outline open"
              },
              {
                "do": "key escape",
                "expect": "popover closed"
              },
              {
                "do": "click outside",
                "expect": "popover closed"
              }
            ]
          }
        }
      },
      "publication": "studio",
      "entryId": "home",
      "entryMeta": {
        "pin": {
          "nav": true
        }
      }
    }
  }
}
