    {
      "path": "message-example.tsx",
      "type": "registry:example",
      "content": "import type { UIMessage } from \"ai\"\n\nimport { createChat } from \"@/lib/ai\"\nimport { type MessagePartRenderProps } from \"@/components/message-parts\"\nimport {\n  Example,\n  ExampleWrapper,\n} from \"@/components/example\"\nimport {\n  Attachment,\n  AttachmentAction,\n  AttachmentActions,\n  AttachmentContent,\n  AttachmentDescription,\n  AttachmentGroup,\n  AttachmentMedia,\n  AttachmentTitle,\n} from \"@/components/ui/attachment\"\nimport {\n  Avatar,\n  AvatarFallback,\n  AvatarImage,\n} from \"@/components/ui/avatar\"\nimport {\n  Bubble,\n  BubbleContent,\n  BubbleGroup,\n  BubbleReactions,\n} from \"@/components/ui/bubble\"\nimport { Button } from \"@/components/ui/button\"\nimport {\n  Marker,\n  MarkerContent,\n  MarkerIcon,\n} from \"@/components/ui/marker\"\nimport {\n  Message,\n  MessageAvatar,\n  MessageContent,\n  MessageFooter,\n  MessageGroup,\n  MessageHeader,\n} from \"@/components/ui/message\"\nimport { Spinner } from \"@/components/ui/spinner\"\nimport { FileTextIcon, DownloadIcon, PresentationIcon, FileArchiveIcon, CopyIcon, RefreshCcwIcon, ThumbsUpIcon, ThumbsDownIcon } from \"lucide-react\"\n\ntype MessagePartsData = {\n  deployment: {\n    status: \"healthy\" | \"degraded\"\n    region: string\n    latency: number\n  }\n}\n\ntype MessagePartsTools = {\n  getDeploymentHealth: {\n    input: {\n      project: string\n      region: string\n    }\n    output: {\n      status: \"healthy\" | \"degraded\"\n      p95: number\n      errors: number\n      recommendation: string\n    }\n  }\n}\n\ntype MessagePartsMessage = UIMessage<\n  unknown,\n  MessagePartsData,\n  MessagePartsTools\n>\n\nconst messagePartsChat = createChat<MessagePartsMessage>()\n  .user(\"Can you review this screenshot and check the deployment?\", {\n    files: [\n      {\n        mediaType: \"image/jpeg\",\n        filename: \"checkout-error.jpg\",\n        url: \"https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=900&auto=format&fit=crop&q=80\",\n      },\n    ],\n  })\n  .assistant(({ writer }) => {\n    writer.reasoning(\n      \"The user included an image and asked for deployment status, so I should inspect the screenshot context and call the deployment health tool before answering.\"\n    )\n\n    const deployment = writer.tool(\"getDeploymentHealth\", {\n      title: \"Checking deployment health\",\n      input: {\n        project: \"checkout\",\n        region: \"iad1\",\n      },\n    })\n\n    deployment.output({\n      status: \"healthy\",\n      p95: 186,\n      errors: 2,\n      recommendation: \"Keep the deployment live and monitor error rate.\",\n    })\n\n    writer.data({\n      type: \"data-deployment\",\n      id: \"deployment-health\",\n      data: {\n        status: \"healthy\",\n        region: \"iad1\",\n        latency: 186,\n      },\n    })\n    writer.text(\n      \"The deployment looks healthy. P95 latency is **186ms** with **2 recent errors**, so I would keep it live and monitor error rate for the next 15 minutes.\"\n    )\n    writer.sourceUrl({\n      sourceId: \"source-deployment-docs\",\n      title: \"Deployment health checks\",\n      url: \"https://vercel.com/docs/deployments\",\n    })\n    writer.sourceDocument({\n      sourceId: \"source-runbook\",\n      title: \"Checkout release runbook\",\n      filename: \"checkout-release-runbook.md\",\n      mediaType: \"text/markdown\",\n    })\n  })\n\nconst messagePartsMessages = messagePartsChat.get()\n\ntype MessagePartsPart = MessagePartsMessage[\"parts\"][number]\n\nexport default function MessageExample() {\n  return (\n    <ExampleWrapper>\n      <MessageDefault />\n      <MessageWithAvatar />\n      <MessageGroupExample />\n      <MessageGroupChat />\n      <MessageHeaderFooter />\n      <MessageActions />\n      <MessageAttachment />\n      <MessageAttachmentGroup />\n    </ExampleWrapper>\n  )\n}\n\nfunction MessageTextPart({\n  part,\n  message,\n}: MessagePartRenderProps<MessagePartsPart, MessagePartsMessage>) {\n  if (part.type !== \"text\") {\n    return null\n  }\n\n  return (\n    <Bubble\n      align={message.role === \"user\" ? \"end\" : \"start\"}\n      variant={message.role === \"user\" ? \"default\" : \"ghost\"}\n    >\n      <BubbleContent>\n        <span className=\"whitespace-pre-wrap\">{part.text}</span>\n      </BubbleContent>\n    </Bubble>\n  )\n}\n\nfunction MessageDefault() {\n  return (\n    <Example title=\"Message\">\n      <div className=\"flex w-full max-w-md min-w-0 flex-col gap-10\">\n        <Message align=\"end\">\n          <MessageContent>\n            <Bubble>\n              <BubbleContent>Deploying to prod real quick.</BubbleContent>\n            </Bubble>\n          </MessageContent>\n        </Message>\n        <Message>\n          <MessageContent>\n            <Bubble variant=\"muted\">\n              <BubbleContent>It&apos;s 4:55 PM. On a Friday.</BubbleContent>\n            </Bubble>\n          </MessageContent>\n        </Message>\n        <Message align=\"end\">\n          <MessageContent>\n            <Bubble>\n              <BubbleContent>It&apos;s a one-line change.</BubbleContent>\n            </Bubble>\n          </MessageContent>\n        </Message>\n        <Message>\n          <MessageContent>\n            <BubbleGroup>\n              <Bubble variant=\"muted\">\n                <BubbleContent>\n                  It&apos;s always a one-line change 😭. Make sure to run the\n                  tests this time.\n                </BubbleContent>\n              </Bubble>\n              <Bubble variant=\"muted\">\n                <BubbleContent>Alright, go for it.</BubbleContent>\n              </Bubble>\n            </BubbleGroup>\n          </MessageContent>\n        </Message>\n      </div>\n    </Example>\n  )\n}\n\nfunction MessageWithAvatar() {\n  return (\n    <Example title=\"Avatar\">\n      <div className=\"flex w-full max-w-md flex-col gap-10\">\n        <Message>\n          <MessageAvatar>\n            <Avatar>\n              <AvatarImage\n                src=\"https://github.com/shadcn.png\"\n                alt=\"@shadcn\"\n                className=\"grayscale\"\n              />\n              <AvatarFallback>CN</AvatarFallback>\n            </Avatar>\n          </MessageAvatar>\n          <MessageContent>\n            <Bubble variant=\"muted\">\n              <BubbleContent>Something went wrong. Any idea?</BubbleContent>\n            </Bubble>\n          </MessageContent>\n        </Message>\n        <Message>\n          <MessageAvatar>\n            <Avatar>\n              <AvatarImage\n                src=\"https://github.com/evilrabbit.png\"\n                alt=\"@evilrabbit\"\n              />\n              <AvatarFallback>ER</AvatarFallback>\n            </Avatar>\n          </MessageAvatar>\n          <MessageContent>\n            <Bubble variant=\"muted\">\n              <BubbleContent>\n                I checked the latest deployment and found the build failed\n                during dependency installation.\n              </BubbleContent>\n            </Bubble>\n          </MessageContent>\n        </Message>\n        <Message align=\"end\">\n          <MessageAvatar>\n            <Avatar>\n              <AvatarImage\n                src=\"https://github.com/evilrabbit.png\"\n                alt=\"@evilrabbit\"\n              />\n              <AvatarFallback>ER</AvatarFallback>\n            </Avatar>\n          </MessageAvatar>\n          <MessageContent>\n            <Bubble variant=\"muted\">\n              <BubbleContent>Something went wrong. Any idea?</BubbleContent>\n            </Bubble>\n          </MessageContent>\n        </Message>\n        <Message>\n          <MessageAvatar>\n            <Avatar>\n              <AvatarImage\n                src=\"https://avatar.vercel.sh/shadcn\"\n                alt=\"@shadcn\"\n              />\n              <AvatarFallback>CN</AvatarFallback>\n            </Avatar>\n          </MessageAvatar>\n          <MessageContent>\n            <Bubble variant=\"muted\">\n              <BubbleContent className=\"space-y-2\">\n                <div>\n                  I checked the latest deployment and found the build failed\n                  during dependency installation.\n                </div>\n                <div>Can you share the exact error message from the logs?</div>\n              </BubbleContent>\n            </Bubble>\n          </MessageContent>\n        </Message>\n        <Message>\n          <MessageAvatar>\n            <Avatar>\n              <AvatarFallback>CN</AvatarFallback>\n            </Avatar>\n          </MessageAvatar>\n          <MessageContent>\n            <Bubble variant=\"destructive\">\n              <BubbleContent>Something went wrong. Any idea?</BubbleContent>\n            </Bubble>\n          </MessageContent>\n        </Message>\n      </div>\n    </Example>\n  )\n}\n\nfunction MessageGroupExample() {\n  return (\n    <Example title=\"Group\">\n      <div className=\"flex w-full max-w-md flex-col gap-10\">\n        <MessageGroup>\n          <Message>\n            <MessageContent>\n              <Bubble variant=\"muted\">\n                <BubbleContent>I checked the registry addresses.</BubbleContent>\n              </Bubble>\n            </MessageContent>\n          </Message>\n          <Message>\n            <MessageContent>\n              <Bubble variant=\"muted\">\n                <BubbleContent>\n                  The component and example JSON now live under the UI registry.\n                </BubbleContent>\n              </Bubble>\n            </MessageContent>\n          </Message>\n        </MessageGroup>\n        <MessageGroup>\n          <Message align=\"end\">\n            <MessageContent>\n              <Bubble variant=\"muted\">\n                <BubbleContent>I checked the registry addresses.</BubbleContent>\n              </Bubble>\n            </MessageContent>\n          </Message>\n          <Message align=\"end\">\n            <MessageContent>\n              <Bubble variant=\"muted\">\n                <BubbleContent>\n                  The component and example JSON now live under the UI registry.\n                </BubbleContent>\n              </Bubble>\n            </MessageContent>\n          </Message>\n        </MessageGroup>\n        <MessageGroup>\n          <Message align=\"end\">\n            <MessageAvatar />\n            <MessageContent>\n              <Bubble variant=\"muted\">\n                <BubbleContent>I checked the registry addresses.</BubbleContent>\n              </Bubble>\n            </MessageContent>\n          </Message>\n          <Message align=\"end\">\n            <MessageAvatar>\n              <Avatar>\n                <AvatarImage\n                  src=\"https://avatar.vercel.sh/shadcn\"\n                  alt=\"@shadcn\"\n                />\n                <AvatarFallback>CN</AvatarFallback>\n              </Avatar>\n            </MessageAvatar>\n            <MessageContent>\n              <Bubble variant=\"muted\">\n                <BubbleContent>\n                  The component and example JSON now live under the UI registry.\n                </BubbleContent>\n              </Bubble>\n            </MessageContent>\n          </Message>\n        </MessageGroup>\n        <MessageGroup>\n          <Message>\n            <MessageAvatar />\n            <MessageContent>\n              <Bubble variant=\"muted\">\n                <BubbleContent>I checked the registry addresses.</BubbleContent>\n              </Bubble>\n            </MessageContent>\n          </Message>\n          <Message>\n            <MessageAvatar>\n              <Avatar>\n                <AvatarImage\n                  src=\"https://avatar.vercel.sh/shadcn\"\n                  alt=\"@shadcn\"\n                />\n                <AvatarFallback>CN</AvatarFallback>\n              </Avatar>\n            </MessageAvatar>\n            <MessageContent>\n              <Bubble variant=\"muted\">\n                <BubbleContent>\n                  The component and example JSON now live under the UI registry.\n                </BubbleContent>\n              </Bubble>\n            </MessageContent>\n          </Message>\n        </MessageGroup>\n      </div>\n    </Example>\n  )\n}\n\nfunction MessageGroupChat() {\n  return (\n    <Example title=\"Group Chat\">\n      <div className=\"flex w-full max-w-md flex-col gap-10\">\n        <Message align=\"end\">\n          <MessageContent>\n            <Bubble variant=\"tinted\">\n              <BubbleContent>\n                Why is the dashboard showing zero users\n              </BubbleContent>\n            </Bubble>\n          </MessageContent>\n        </Message>\n        <MessageGroup>\n          <Message>\n            <MessageAvatar />\n            <MessageContent>\n              <Bubble variant=\"muted\">\n                <BubbleContent>Define &quot;zero.&quot;</BubbleContent>\n              </Bubble>\n            </MessageContent>\n          </Message>\n          <Message>\n            <MessageAvatar>\n              <Avatar>\n                <AvatarImage\n                  src=\"https://github.com/evilrabbit.png\"\n                  alt=\"@evilrabbit\"\n                />\n                <AvatarFallback>ER</AvatarFallback>\n              </Avatar>\n            </MessageAvatar>\n            <MessageContent>\n              <Bubble variant=\"muted\">\n                <BubbleContent>What do you mean?</BubbleContent>\n              </Bubble>\n            </MessageContent>\n          </Message>\n        </MessageGroup>\n        <Message align=\"end\">\n          <MessageContent>\n            <Bubble variant=\"tinted\">\n              <BubbleContent>\n                <span className=\"font-medium\">@eve</span> can you check?\n              </BubbleContent>\n            </Bubble>\n          </MessageContent>\n        </Message>\n        <Message>\n          <Marker role=\"status\">\n            <MarkerIcon>\n              <Spinner />\n            </MarkerIcon>\n            <MarkerContent>Checking the logs...</MarkerContent>\n          </Marker>\n        </Message>\n        <Message>\n          <MessageContent>\n            <MessageHeader>Eve</MessageHeader>\n            <Bubble variant=\"ghost\">\n              <BubbleContent>\n                <span className=\"whitespace-pre-wrap\">\n                  {`I found the following error in the logs:\n\n- Error: No users found\n- Stack trace:\n  - at src/example.ts:123\n  - at src/example.ts:230\n\nCan you check if the users are being created?`}\n                </span>\n              </BubbleContent>\n            </Bubble>\n          </MessageContent>\n        </Message>\n      </div>\n    </Example>\n  )\n}\n\nfunction MessageHeaderFooter() {\n  return (\n    <Example title=\"Header and Footer\">\n      <div className=\"flex w-full max-w-md flex-col gap-12\">\n        <Message align=\"end\">\n          <MessageContent>\n            <MessageHeader className=\"justify-end\">You</MessageHeader>\n            <Bubble>\n              <BubbleContent>\n                Can we keep this style quiet and send the update today?\n              </BubbleContent>\n            </Bubble>\n            <MessageFooter className=\"gap-2\">\n              <span>Delivered</span>\n              <Button variant=\"ghost\" size=\"xs\">\n                Undo\n              </Button>\n            </MessageFooter>\n          </MessageContent>\n        </Message>\n        <Message align=\"start\">\n          <MessageContent>\n            <MessageHeader>\n              <span>Olivia</span>\n              <span className=\"ml-auto font-normal\">1m ago</span>\n            </MessageHeader>\n            <Bubble variant=\"muted\">\n              <BubbleContent>\n                I checked the logs. The retry finished and the missing invoices\n                are included now.\n              </BubbleContent>\n              <BubbleReactions>\n                <Button variant=\"ghost\" size=\"xs\">\n                  Thanks\n                </Button>\n              </BubbleReactions>\n            </Bubble>\n            <MessageFooter className=\"gap-2\">\n              <span>From Support queue</span>\n              <Button variant=\"ghost\" size=\"xs\">\n                Copy\n              </Button>\n            </MessageFooter>\n          </MessageContent>\n        </Message>\n        <Message align=\"end\">\n          <MessageContent>\n            <MessageHeader>Marina</MessageHeader>\n            <Bubble variant=\"outline\">\n              <BubbleContent>\n                I drafted the reply with the exact filter path and a link to the\n                export history.\n              </BubbleContent>\n            </Bubble>\n            <MessageFooter className=\"gap-2\">\n              <span>Draft ready</span>\n              <Button variant=\"outline\" size=\"xs\">\n                Review\n              </Button>\n              <Button size=\"xs\">Send</Button>\n            </MessageFooter>\n          </MessageContent>\n        </Message>\n        <Message align=\"start\">\n          <MessageContent>\n            <MessageHeader>Assistant note</MessageHeader>\n            <Bubble variant=\"ghost\">\n              <BubbleContent>\n                Ghost messages keep long-form assistant notes aligned with the\n                surrounding text instead of adding a frame.\n              </BubbleContent>\n            </Bubble>\n            <MessageFooter className=\"gap-2\">\n              <span>Internal only</span>\n              <Button variant=\"ghost\" size=\"xs\">\n                Pin\n              </Button>\n            </MessageFooter>\n          </MessageContent>\n        </Message>\n        <Message align=\"end\">\n          <MessageContent>\n            <MessageHeader className=\"justify-end\">\n              Automation warning\n            </MessageHeader>\n            <Bubble variant=\"destructive\">\n              <BubbleContent>\n                The old export link expires in 10 minutes. Regenerate before\n                sending this transcript externally.\n              </BubbleContent>\n            </Bubble>\n            <MessageFooter className=\"gap-2\">\n              <span>Needs action</span>\n              <Button variant=\"destructive\" size=\"xs\">\n                Regenerate\n              </Button>\n            </MessageFooter>\n          </MessageContent>\n        </Message>\n      </div>\n    </Example>\n  )\n}\n\nfunction MessageAttachment() {\n  return (\n    <Example title=\"Attachment\">\n      <div className=\"flex w-full max-w-sm flex-col gap-8\">\n        <Message align=\"end\">\n          <MessageContent>\n            <Attachment orientation=\"vertical\">\n              <AttachmentMedia variant=\"image\">\n                <img\n                  src=\"https://images.unsplash.com/photo-1497366754035-f200968a6e72?w=900&auto=format&fit=crop&q=80\"\n                  alt=\"Workspace\"\n                />\n              </AttachmentMedia>\n            </Attachment>\n            <Bubble>\n              <BubbleContent>\n                Here&apos;s the image. Can you add it to the PDF? Use it for the\n                cover page.\n              </BubbleContent>\n            </Bubble>\n          </MessageContent>\n        </Message>\n        <Message>\n          <MessageContent>\n            <Bubble variant=\"muted\">\n              <BubbleContent>\n                Done. Here&apos;s the PDF with the image added as the cover\n                page.\n              </BubbleContent>\n            </Bubble>\n            <Attachment>\n              <AttachmentMedia>\n                <FileTextIcon\n                />\n              </AttachmentMedia>\n              <AttachmentContent>\n                <AttachmentTitle>sales-dashboard.pdf</AttachmentTitle>\n                <AttachmentDescription>PDF · 2.4 MB</AttachmentDescription>\n              </AttachmentContent>\n              <AttachmentActions>\n                <AttachmentAction\n                  type=\"button\"\n                  aria-label=\"Download\"\n                  size=\"icon-sm\"\n                  variant=\"secondary\"\n                >\n                  <DownloadIcon\n                  />\n                </AttachmentAction>\n              </AttachmentActions>\n            </Attachment>\n          </MessageContent>\n        </Message>\n        <Message align=\"end\">\n          <MessageContent>\n            <Bubble>\n              <BubbleContent>Thanks. Looks good.</BubbleContent>\n            </Bubble>\n          </MessageContent>\n        </Message>\n      </div>\n    </Example>\n  )\n}\n\nfunction MessageAttachmentGroup() {\n  return (\n    <Example title=\"Attachment Group\">\n      <div className=\"flex w-full max-w-sm flex-col gap-8\">\n        <Message align=\"end\">\n          <MessageContent>\n            <AttachmentGroup className=\"w-[80%]\">\n              <Attachment orientation=\"vertical\">\n                <AttachmentMedia variant=\"image\">\n                  <img\n                    src=\"https://images.unsplash.com/photo-1497366754035-f200968a6e72?w=900&auto=format&fit=crop&q=80\"\n                    alt=\"Workspace\"\n                  />\n                </AttachmentMedia>\n              </Attachment>\n              <Attachment orientation=\"vertical\">\n                <AttachmentMedia variant=\"image\">\n                  <img\n                    src=\"https://images.unsplash.com/photo-1497215728101-856f4ea42174?w=900&auto=format&fit=crop&q=80\"\n                    alt=\"Desk\"\n                  />\n                </AttachmentMedia>\n              </Attachment>\n              <Attachment orientation=\"vertical\">\n                <AttachmentMedia variant=\"image\">\n                  <img\n                    src=\"https://images.unsplash.com/photo-1497366811353-6870744d04b2?w=900&auto=format&fit=crop&q=80\"\n                    alt=\"Office\"\n                  />\n                </AttachmentMedia>\n              </Attachment>\n            </AttachmentGroup>\n            <Bubble>\n              <BubbleContent>\n                Here are the brand photos. Can you add them to the deck?\n              </BubbleContent>\n            </Bubble>\n          </MessageContent>\n        </Message>\n        <Message>\n          <MessageContent>\n            <Bubble variant=\"muted\">\n              <BubbleContent>\n                Done. Here&apos;s the draft deck and the exported assets.\n              </BubbleContent>\n            </Bubble>\n            <AttachmentGroup className=\"w-full\">\n              <Attachment className=\"w-64\">\n                <AttachmentMedia>\n                  <FileTextIcon\n                  />\n                </AttachmentMedia>\n                <AttachmentContent>\n                  <AttachmentTitle>brand-deck.pdf</AttachmentTitle>\n                  <AttachmentDescription>PDF · 3.1 MB</AttachmentDescription>\n                </AttachmentContent>\n                <AttachmentActions>\n                  <AttachmentAction\n                    type=\"button\"\n                    aria-label=\"Download brand-deck.pdf\"\n                    size=\"icon-sm\"\n                    variant=\"secondary\"\n                  >\n                    <DownloadIcon\n                    />\n                  </AttachmentAction>\n                </AttachmentActions>\n              </Attachment>\n              <Attachment className=\"w-64\">\n                <AttachmentMedia>\n                  <PresentationIcon\n                  />\n                </AttachmentMedia>\n                <AttachmentContent>\n                  <AttachmentTitle>brand-deck.key</AttachmentTitle>\n                  <AttachmentDescription>Keynote · 9 MB</AttachmentDescription>\n                </AttachmentContent>\n                <AttachmentActions>\n                  <AttachmentAction\n                    type=\"button\"\n                    aria-label=\"Download brand-deck.key\"\n                    size=\"icon-sm\"\n                    variant=\"secondary\"\n                  >\n                    <DownloadIcon\n                    />\n                  </AttachmentAction>\n                </AttachmentActions>\n              </Attachment>\n              <Attachment className=\"w-64\">\n                <AttachmentMedia>\n                  <FileArchiveIcon\n                  />\n                </AttachmentMedia>\n                <AttachmentContent>\n                  <AttachmentTitle>brand-assets.zip</AttachmentTitle>\n                  <AttachmentDescription>ZIP · 4.2 MB</AttachmentDescription>\n                </AttachmentContent>\n                <AttachmentActions>\n                  <AttachmentAction\n                    type=\"button\"\n                    aria-label=\"Download brand-assets.zip\"\n                    size=\"icon-sm\"\n                    variant=\"secondary\"\n                  >\n                    <DownloadIcon\n                    />\n                  </AttachmentAction>\n                </AttachmentActions>\n              </Attachment>\n            </AttachmentGroup>\n          </MessageContent>\n        </Message>\n      </div>\n    </Example>\n  )\n}\n\nfunction MessageActions() {\n  return (\n    <Example title=\"Actions\">\n      <div className=\"flex w-full max-w-md flex-col gap-10\">\n        <Message align=\"end\">\n          <MessageContent>\n            <Bubble>\n              <BubbleContent>\n                What is the status of the deployment?\n              </BubbleContent>\n            </Bubble>\n            <MessageFooter>\n              <Button variant=\"ghost\" size=\"icon\" aria-label=\"Copy\">\n                <CopyIcon\n                />\n              </Button>\n              <Button variant=\"ghost\" size=\"icon\" aria-label=\"Retry\">\n                <RefreshCcwIcon\n                />\n              </Button>\n            </MessageFooter>\n          </MessageContent>\n        </Message>\n        <Message>\n          <MessageAvatar>\n            <Avatar>\n              <AvatarImage\n                src=\"https://github.com/evilrabbit.png\"\n                alt=\"@evilrabbit\"\n              />\n              <AvatarFallback>ER</AvatarFallback>\n            </Avatar>\n          </MessageAvatar>\n          <MessageContent>\n            <Bubble variant=\"muted\">\n              <BubbleContent>\n                The install failure is coming from the workspace package. I can\n                open the exact log line or retry the deployment.\n              </BubbleContent>\n            </Bubble>\n            <MessageFooter>\n              <Button variant=\"ghost\" size=\"icon\" aria-label=\"Copy\">\n                <CopyIcon\n                />\n              </Button>\n              <Button variant=\"ghost\" size=\"icon\" aria-label=\"Like: thumbs up\">\n                <ThumbsUpIcon\n                />\n              </Button>\n              <Button\n                variant=\"ghost\"\n                size=\"icon\"\n                aria-label=\"Like: thumbs down\"\n              >\n                <ThumbsDownIcon\n                />\n              </Button>\n            </MessageFooter>\n          </MessageContent>\n        </Message>\n        <Message align=\"end\">\n          <MessageContent>\n            <Bubble>\n              <BubbleContent>\n                Okay drop me a link. I&apos;ll check it out.\n              </BubbleContent>\n            </Bubble>\n            <MessageFooter className=\"gap-2\">\n              <span className=\"font-normal text-destructive\">\n                Failed to send\n              </span>\n              <Button variant=\"secondary\" size=\"xs\">\n                Retry\n              </Button>\n            </MessageFooter>\n          </MessageContent>\n        </Message>\n      </div>\n    </Example>\n  )\n}\n"
    }
  ],
