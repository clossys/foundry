      {
        "name": "team",
        "kind": "data",
        "required": true,
        "description": "The resolved team label and one card per roster entry (plus Unassigned while a step has no holder): id, name, initial, seat-kind labels, tier label, one-line description, step-count label, lane link, link label and whether its lane is highlighted."
      }
    ],
