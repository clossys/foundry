{
  "name": "@clossys/reviewer",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "bin": {
    "reviewer-check": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "skill",
    "intake-question-cards.json",
    "fit-signal-declarations.json",
    "loop-matrix.json",
    "!dist/**/*.test.*"
  ],
  "sideEffects": false,
  "foundry": {
    "assessment": {
      "bin": "reviewer-check",
      "invocation": "single-json-input"
    },
    "intake": "intake-question-cards.json",
    "outputs": [
      "clossys/reviewer/status.json"
    ],
    "status": {
      "bin": "reviewer-check",
      "invocation": "single-json-input"
    },
    "fit": "fit-signal-declarations.json",
    "solves": [],
    "needs": [],
    "feeds": [],
    "capabilities": [
      {
        "id": "confirm-scaffold-conformance",
        "subQuestion": "Does @clossys/reviewer's own scaffolded starting point already conform to the Stage A framework?",
        "worldClass": "A newly scaffolded package reports zero gaps against every Stage A framework definition on day one (issue #1203).",
        "inputs": [],
        "outputs": [
          "clossys/reviewer/status.json"
        ],
        "proofCase": null,
        "maturity": "planned",
        "v0": false,
        "businessLifecycleStage": "build"
      }
    ]
  },
  "description": "The reviewer role, a factory agent for how Foundry itself is built: it runs the mechanical checks first, reads the diff for what no check covers, and confirms the change works where it ships. Its stages are Checks, Judgement and Production; it ships its skill, the rules it owns, and a status probe (reviewer-check) that checks the skill lists exactly the rules it owns.",
  "keywords": [
    "reviewer",
    "checks",
    "judgement",
    "production",
    "factory"
  ],
  "author": "Clossys",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clossys/foundry.git",
    "directory": "packages/reviewer"
  },
  "bugs": {
    "url": "https://github.com/clossys/foundry/issues"
  },
  "homepage": "https://github.com/clossys/foundry/tree/main/packages/reviewer#readme",
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "~6.0.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "node ../../scripts/check-name-collision.mjs . && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run && npm run --prefix ../.. check:fast-before-review && npm run --prefix ../.. check:review-fail-closed"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
