{
  "schema": "clossys.standard/1",
  "id": "brief.list",
  "kinds": [
    "brief"
  ],
  "mode": "craft",
  "craftTier": "mid",
  "seeds": [],
  "createOnly": true,
  "createOnlyReason": "Director briefs are derived from the consumer engagement and upstream facts; no seed registry exists for a brief, so every brief without a package default is created by the Director craft recipe.",
  "requirements": [
    {
      "check": "brief.sections",
      "params": {}
    },
    {
      "check": "brief.keys",
      "params": {
        "contract": "$contract"
      }
    },
    {
      "check": "brief.derived-upstream",
      "params": {}
    },
    {
      "check": "brief.because-cited",
      "params": {}
    },
    {
      "check": "brief.watch-trigger",
      "params": {}
    },
    {
      "check": "brief.plain-direction",
      "params": {}
    },
    {
      "check": "brief.direction-values",
      "params": {
        "maxWords": 45,
        "maxSentences": 2
      }
    }
  ],
  "preview": {
    "card": {
      "method": "inline",
      "intrinsicWidth": null,
      "mustContain": [
        "ol[data-brief-list] > li"
      ],
      "states": [
        "loading",
        "not-needed",
        "no-preview",
        "failed",
        "not-pinned"
      ]
    }
  }
}
