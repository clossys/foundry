{
  "schema": "clossys.standard/1",
  "id": "brief.measure",
  "kinds": [
    "brief"
  ],
  "mode": "craft",
  "craftTier": "mid",
  "seeds": [],
  "createOnly": true,
  "createOnlyReason": "Measures are the consumer own numbers derived from upstream briefs; no seed registry exists for a brief, so every measure without a package default is created by the Director craft recipe.",
  "requirements": [
    {
      "check": "brief.sections",
      "params": {}
    },
    {
      "check": "brief.keys",
      "params": {
        "contract": "$contract"
      }
    },
    {
      "check": "brief.derived-upstream",
      "params": {}
    },
    {
      "check": "brief.because-cited",
      "params": {}
    },
    {
      "check": "brief.watch-trigger",
      "params": {}
    },
    {
      "check": "brief.plain-direction",
      "params": {}
    },
    {
      "check": "brief.quantified",
      "params": {
        "min": 2
      }
    },
    {
      "check": "brief.direction-values",
      "params": {
        "maxWords": 45,
        "maxSentences": 2
      }
    }
  ],
  "preview": {
    "card": {
      "method": "inline",
      "intrinsicWidth": null,
      "mustContain": [
        "[data-brief-metric]",
        "[data-brief-metric-name]"
      ],
      "states": [
        "loading",
        "not-needed",
        "no-preview",
        "failed",
        "not-pinned"
      ]
    }
  }
}
