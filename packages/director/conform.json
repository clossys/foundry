{
  "schema": "clossys.conform-adapter/1",
  "agent": "director",
  "trees": [
    {
      "file": "src/catalog/ia/strategy.json",
      "freeze": "src/catalog/ia/strategy.leaf-freeze.json"
    }
  ],
  "kinds": [
    "brief"
  ],
  "defaults": [
    "src/catalog/defaults"
  ],
  "recipes": [
    {
      "dir": "recipes/create.statement"
    },
    {
      "dir": "recipes/create.structured"
    }
  ],
  "derive": [],
  "edgeFiles": [
    {
      "file": "src/slot-contracts/contracts.json",
      "format": "slots",
      "feedsTo": "writer"
    }
  ],
  "loops": ["loop.scope", "loop.slot", "loop.create", "loop.choose", "loop.cascade"],
  "skill": "skill/SKILL.md",
  "skills": {
    "scope": "packages/director/actions/director.scope/skill.md",
    "slot": "packages/director/actions/director.slot/skill.md",
    "create": "packages/director/actions/director.candidates/skill.md",
    "choose": "packages/director/actions/pick.director/skill.md",
    "cascade": "packages/director/actions/director.cascade/skill.md"
  },
  "requests": {
    "issuing": [],
    "handling": {
      "slot": {"skill": "packages/director/actions/director.slot/skill.md", "loop": "loop.slot"},
      "change": {"skill": "packages/director/actions/director.candidates/skill.md", "loop": "loop.create"},
      "fix": {"skill": "packages/director/actions/director.candidates/skill.md", "loop": "loop.create"}
    }
  }
}
