{
  "name": "@vespeneventures/ui",
  "version": "0.4.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "description": "React components for @vespeneventures/tokens: atoms and blocks layers built on react-aria-components for behavior and accessibility, styled with Tailwind utility classes generated from the tokens themselves.",
  "keywords": [
    "react",
    "components",
    "design-system",
    "react-aria",
    "tailwindcss",
    "accessibility",
    "typescript"
  ],
  "author": "Calvin Hung",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vespeneventures/foundry.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/vespeneventures/foundry/issues"
  },
  "homepage": "https://github.com/vespeneventures/foundry/tree/main/packages/ui#readme",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    "./atoms": {
      "types": "./dist/atoms/index.d.ts",
      "import": "./dist/atoms/index.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.js"
    },
    "./charts": {
      "types": "./dist/charts/index.d.ts",
      "import": "./dist/charts/index.js"
    },
    "./blocks": {
      "types": "./dist/blocks/index.d.ts",
      "import": "./dist/blocks/index.js"
    },
    "./views": {
      "types": "./dist/views/index.d.ts",
      "import": "./dist/views/index.js"
    },
    "./shell": {
      "types": "./dist/shell/index.d.ts",
      "import": "./dist/shell/index.js"
    },
    "./gate": {
      "types": "./dist/gate-index.d.ts",
      "import": "./dist/gate-index.js"
    }
  },
  "bin": {
    "ui-token-check": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "generate:icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.3",
    "@vespeneventures/tokens": "~0.6.0",
    "react-aria-components": "^1.20.0",
    "tailwind-merge": "^3.0.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "tailwindcss": "^4.0.0",
    "@vespeneventures/tokens": "^0.6.0"
  },
  "devDependencies": {
    "@vespeneventures/tokens": "^0.6.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.24.0",
    "jsdom": "^26.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "vitest": "^4.1.9"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
