{
  "name": "@clossys/messenger",
  "version": "0.1.3",
  "private": false,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./providers/resend": {
      "types": "./dist/providers/resend/index.d.ts",
      "import": "./dist/providers/resend/index.js"
    }
  },
  "bin": {
    "messenger-check": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "description": "The messenger role: deliver authorized, finished communications through a durable dispatch boundary and measure timely delivery from independent outcome evidence.",
  "keywords": [
    "messaging",
    "delivery",
    "communications",
    "idempotency",
    "typescript"
  ],
  "author": "Calvin Hung",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clossys/foundry.git",
    "directory": "packages/messenger"
  },
  "bugs": {
    "url": "https://github.com/clossys/foundry/issues"
  },
  "homepage": "https://github.com/clossys/foundry/tree/main/packages/messenger#readme",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "node ../../scripts/check-name-collision.mjs . && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "resend": "^6.19.0",
    "typescript": "~6.0.0",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "resend": "^6.19.0"
  },
  "peerDependenciesMeta": {
    "resend": {
      "optional": true
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
