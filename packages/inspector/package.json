{
  "name": "@vespeneventures/inspector",
  "version": "0.1.5",
  "private": false,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./secret-scan": {
      "types": "./dist/secret-scan/index.d.ts",
      "import": "./dist/secret-scan/index.js"
    },
    "./documents/*": "./documents/*"
  },
  "bin": {
    "inspector": "./dist/bin.js"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "documents",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "description": "Judges a change before it lands: a secret-scan attempt (attested, or actually run via the ./secret-scan subpath's verified gitleaks acquisition), a change's task record, its review evidence, and policy drift, each reported as satisfied/violated/indeterminate and folded into a 0/1/2 exit contract, with a caller-visible minimum-safe-version floor.",
  "keywords": [
    "ci-gate",
    "gate-result",
    "fail-closed",
    "secret-scan",
    "gitleaks",
    "review-evidence",
    "policy-drift",
    "typescript"
  ],
  "author": "Calvin Hung",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vespeneventures/foundry.git",
    "directory": "packages/inspector"
  },
  "bugs": {
    "url": "https://github.com/vespeneventures/foundry/issues"
  },
  "homepage": "https://github.com/vespeneventures/foundry/tree/main/packages/inspector#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@vespeneventures/controller": "~0.4.0",
    "adm-zip": "^0.6.0",
    "tar": "^7.5.22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "~6.0.0",
    "vitest": "^4.1.9"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
