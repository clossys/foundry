{
  "name": "@clossys/launcher",
  "version": "0.1.6",
  "private": false,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "launcher": "dist/cli.js",
    "launcher-check": "dist/check-cli.js"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "skeleton",
    "skill-catalogue",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "description": "Foundry workspace scaffolder: create, resume, or adopt a GitHub repository as the account hub. Executable tooling, not a role.",
  "keywords": [
    "workspace",
    "github",
    "npx",
    "onboarding",
    "typescript"
  ],
  "author": "Clossys",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clossys/foundry.git",
    "directory": "packages/launcher"
  },
  "bugs": {
    "url": "https://github.com/clossys/foundry/issues"
  },
  "homepage": "https://github.com/clossys/foundry/tree/main/packages/launcher#readme",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/pack-skills.mjs && tsc -p tsconfig.json",
    "prepublishOnly": "node ../../scripts/check-name-collision.mjs . && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "typescript": "~6.0.0",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
