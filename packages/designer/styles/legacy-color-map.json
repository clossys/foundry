{
  "schema": "clossys.legacy-color-map/1",
  "decidedBy": "planner:GATES-RED round 4 (G7 inverse swap; round 3 map)",
  "rule": "Each legacy Foundry colour key (a `--color-<name>` in styles/theme-keys.css `@theme inline`) maps to the stock shadcn semantic variable with the same role, or to null when no shadcn variable has that role. The legacy brand/action colour maps to `primary`; a hover or highlight surface maps to shadcn `accent`. The inverse plate is the shadcn foreground/background swap: the plate is `foreground`, its raised plate `card-foreground`, its ink and focus ring `background`, its action colour `primary-foreground`; an inverse state that was a translucent or muted tone of that ink keeps the opacity its legacy key had, as `alpha` (a percentage modifier on the same variable, never a new variable). The remaining state and variant keys (hover, pressed, tint, text), glass tones, status hues, the neutral scale and the scrim have no shadcn role and stay null: no variable is invented for them.",
  "map": {
    "accent": { "shadcn": "primary", "role": "brand/action colour (the approved action-colour slot)" },
    "accent-hover": { "shadcn": null, "role": "action colour, hover state" },
    "accent-on-inverse": { "shadcn": "primary-foreground", "role": "action colour on the inverse plate" },
    "accent-text": { "shadcn": null, "role": "action colour as accessible text variant" },
    "accent-tint": { "shadcn": "accent", "role": "highlight surface" },
    "action": { "shadcn": "primary", "role": "brand/action colour (the approved action-colour slot)" },
    "action-hover": { "shadcn": null, "role": "action colour, hover state" },
    "action-on-inverse": { "shadcn": "primary-foreground", "role": "action colour on the inverse plate" },
    "action-on-inverse-hover": { "shadcn": "primary-foreground", "alpha": 90, "role": "action colour on the inverse plate, hover state" },
    "action-pressed": { "shadcn": null, "role": "action colour, pressed state" },
    "control-quiet": { "shadcn": null, "role": "quiet control ink" },
    "control-tonal": { "shadcn": "secondary", "role": "tonal (secondary) control surface" },
    "control-tonal-hover": { "shadcn": null, "role": "tonal control surface, hover state" },
    "control-tonal-inverse": { "shadcn": "background", "alpha": 12, "role": "tonal control surface on the inverse plate" },
    "control-tonal-inverse-hover": { "shadcn": "background", "alpha": 16, "role": "tonal control surface on the inverse plate, hover state" },
    "focus-ring": { "shadcn": "ring", "role": "focus ring" },
    "focus-ring-on-inverse": { "shadcn": "background", "role": "focus ring on the inverse plate" },
    "ink-link": { "shadcn": null, "role": "link text" },
    "ink-muted": { "shadcn": "muted-foreground", "role": "de-emphasised text" },
    "ink-on-accent": { "shadcn": "primary-foreground", "role": "text on the brand/action colour" },
    "ink-on-action": { "shadcn": "primary-foreground", "role": "text on the brand/action colour" },
    "ink-on-inverse": { "shadcn": "background", "role": "text on the inverse plate" },
    "ink-on-inverse-muted": { "shadcn": "background", "alpha": 75, "role": "de-emphasised text on the inverse plate" },
    "ink-primary": { "shadcn": "foreground", "role": "default text" },
    "ink-secondary": { "shadcn": "muted-foreground", "role": "supporting text" },
    "line-base": { "shadcn": "border", "role": "default border" },
    "line-control": { "shadcn": "input", "role": "form control border" },
    "line-on-inverse": { "shadcn": "background", "alpha": 14, "role": "border on the inverse plate" },
    "line-panel": { "shadcn": "border", "role": "panel border" },
    "line-strong": { "shadcn": null, "role": "emphasised border" },
    "neutral-50": { "shadcn": null, "role": "neutral scale step" },
    "neutral-100": { "shadcn": null, "role": "neutral scale step" },
    "neutral-200": { "shadcn": null, "role": "neutral scale step" },
    "neutral-300": { "shadcn": null, "role": "neutral scale step" },
    "neutral-400": { "shadcn": null, "role": "neutral scale step" },
    "neutral-500": { "shadcn": null, "role": "neutral scale step" },
    "neutral-600": { "shadcn": null, "role": "neutral scale step" },
    "neutral-700": { "shadcn": null, "role": "neutral scale step" },
    "neutral-800": { "shadcn": null, "role": "neutral scale step" },
    "neutral-900": { "shadcn": null, "role": "neutral scale step" },
    "neutral-950": { "shadcn": null, "role": "neutral scale step" },
    "overlay-border": { "shadcn": "border", "role": "overlay (popover) border" },
    "overlay-scrim": { "shadcn": null, "role": "modal scrim" },
    "overlay-surface": { "shadcn": "popover", "role": "overlay (popover) surface" },
    "skeleton-fill": { "shadcn": null, "role": "loading placeholder fill" },
    "status-danger": { "shadcn": "destructive", "role": "destructive/danger colour" },
    "status-danger-text": { "shadcn": null, "role": "danger colour as text variant" },
    "status-danger-tint": { "shadcn": null, "role": "danger tint surface" },
    "status-info": { "shadcn": null, "role": "info status hue" },
    "status-info-text": { "shadcn": null, "role": "info status text" },
    "status-info-tint": { "shadcn": null, "role": "info tint surface" },
    "status-success": { "shadcn": null, "role": "success status hue" },
    "status-success-text": { "shadcn": null, "role": "success status text" },
    "status-success-tint": { "shadcn": null, "role": "success tint surface" },
    "status-warning": { "shadcn": null, "role": "warning status hue" },
    "status-warning-text": { "shadcn": null, "role": "warning status text" },
    "status-warning-tint": { "shadcn": null, "role": "warning tint surface" },
    "surface-aside": { "shadcn": "sidebar", "role": "side region surface" },
    "surface-base": { "shadcn": "background", "role": "page ground" },
    "surface-glass": { "shadcn": null, "role": "translucent glass surface" },
    "surface-glass-inverse": { "shadcn": null, "role": "translucent glass surface on the inverse plate" },
    "surface-inverse": { "shadcn": "foreground", "role": "inverse plate" },
    "surface-inverse-raised": { "shadcn": "card-foreground", "role": "raised surface on the inverse plate" },
    "surface-raised": { "shadcn": "card", "role": "raised (card) surface" },
    "surface-selected": { "shadcn": "accent", "role": "highlight (selected) surface" },
    "surface-sunken": { "shadcn": "muted", "role": "sunken (muted) surface" }
  }
}
