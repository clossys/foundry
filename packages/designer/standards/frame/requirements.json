{
  "schema": "clossys.standard/1",
  "id": "frame",
  "kinds": [
    "element/frame"
  ],
  "mode": "craft",
  "craftTier": "mid",
  "seeds": [],
  "createOnly": true,
  "createOnlyReason": "Frames are crafted compositions of pinned sections and components; this craft standard has no seed registry, so every frame without a package default is created.",
  "requirements": [
    {
      "check": "compose.layers",
      "params": {
        "layers": [
          "components",
          "sections"
        ]
      }
    },
    {
      "check": "source.ref",
      "params": {
        "kinds": [
          "registry",
          "composition",
          "npm",
          "derived",
          "original"
        ],
        "registries": [
          "shadcn-aria",
          "shadcn",
          "magicui",
          "tailark-oss",
          "assistant-ui",
          "reactflow",
          "npm"
        ],
        "licenses": [
          "MIT",
          "Apache-2.0"
        ]
      }
    },
    {
      "check": "tokens.only",
      "params": {}
    }
  ],
  "preview": {
    "card": {
      "method": "frame",
      "intrinsicWidth": 1280,
      "mustContain": [
        "iframe[data-specimen]"
      ],
      "states": [
        "loading",
        "not-needed",
        "no-preview",
        "failed",
        "not-pinned"
      ]
    }
  }
}
