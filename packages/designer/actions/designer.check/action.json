{
  "schema": "clossys.action/1",
  "id": "designer.check",
  "agent": "designer",
  "kind": "plumb",
  "stage": "publish.check",
  "summary": "Check Designer traceability (read-only).",
  "run": "clossys design --check",
  "inputs": [
    {
      "glob": "clossys/agents/designer/*/pin.json",
      "schema": "pin"
    },
    {
      "glob": "clossys/agents/designer/*/candidates/*",
      "schema": "candidate-element"
    },
    {
      "glob": "clossys/agents/director/*/pin.json",
      "schema": "pin"
    }
  ],
  "outputs": [],
  "pass": {
    "command": "clossys design --check",
    "exit": {
      "pass": [
        0
      ],
      "fail": [
        1
      ],
      "error": [
        2
      ]
    }
  },
  "record": "clossys.pipeline-run/1",
  "checks": [
    "workspace"
  ],
  "uses": []
}
