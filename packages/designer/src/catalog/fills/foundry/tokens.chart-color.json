{
  "$extensions": {
    "com.clossys.fill": {
      "author": "foundry",
      "builtOn": [],
      "conforms": [
        "dtcg#format",
        "dtcg#alias",
        "wcag-2.2#1.4.3"
      ],
      "evidence": [
        {
          "check": "C1",
          "clause": "dtcg#format"
        },
        {
          "check": "C2",
          "clause": "dtcg#alias"
        },
        {
          "check": "C9",
          "clause": "wcag-2.2#1.4.3"
        }
      ],
      "id": "foundry/tokens.chart-color",
      "license": "MIT",
      "mode": "implementation",
      "relation": "same-contract",
      "slot": "tokens.chart-color",
      "source": "foundry",
      "sourceAddress": "styles/tokens.css",
      "status": "draft",
      "trust": "foundry"
    }
  },
  "tokens": {
    "chart-color": {
      "axis": {
        "$type": "color",
        "$value": "{tokens.border-color.strong}"
      },
      "axis-label": {
        "$type": "color",
        "$value": "{tokens.text-color.muted}"
      },
      "grid": {
        "$extensions": {
          "com.clossys.css": {
            "raw": "oklch(0.91 0 0)"
          },
          "com.clossys.modes": {
            "dark": {
              "colorSpace": "oklch",
              "components": [
                0.32,
                0,
                0
              ]
            }
          }
        },
        "$type": "color",
        "$value": {
          "colorSpace": "oklch",
          "components": [
            0.91,
            0,
            0
          ]
        }
      },
      "surface": {
        "$type": "color",
        "$value": "{tokens.surface-color.raised}"
      }
    }
  }
}
