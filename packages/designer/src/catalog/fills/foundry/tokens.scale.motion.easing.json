        "dtcg#alias"
      ],
      "evidence": [
        {
          "check": "C1",
          "clause": "dtcg#format"
        },
        {
          "check": "C2",
          "clause": "dtcg#alias"
        }
      ],
      "id": "foundry/tokens.scale.motion.easing",
      "license": "MIT",
      "mode": "implementation",
      "relation": "same-contract",
      "slot": "tokens.scale.motion.easing",
      "source": "foundry",
      "sourceAddress": "styles/tokens.css",
      "status": "draft",
      "trust": "foundry"
    }
  },
  "tokens": {
    "scale": {
      "motion": {
        "easing": {
          "accelerate": {
            "$extensions": {
              "com.clossys.css": {
                "raw": "cubic-bezier(.4, 0, 1, 1)"
              }
            },
            "$type": "cubicBezier",
            "$value": [
              0.4,
              0,
              1,
              1
            ]
          },
          "bounce": {
            "$extensions": {
              "com.clossys.css": {
                "raw": "cubic-bezier(.2, .8, .2, 1)"
              }
            },
            "$type": "cubicBezier",
            "$value": [
              0.2,
              0.8,
              0.2,
              1
            ]
          },
          "decelerate": {
            "$extensions": {
              "com.clossys.css": {
                "raw": "cubic-bezier(0, 0, .2, 1)"
              }
            },
            "$type": "cubicBezier",
            "$value": [
              0,
              0,
              0.2,
              1
            ]
          },
          "default": {
            "$extensions": {
              "com.clossys.css": {
                "raw": "cubic-bezier(.2, 0, 0, 1)"
              }
            },
            "$type": "cubicBezier",
            "$value": [
              0.2,
              0,
              0,
              1
            ]
          }
        }
      }
    }
