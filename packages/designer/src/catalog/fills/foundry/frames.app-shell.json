      "license": "MIT",
      "mode": "implementation",
      "pin": {
        "export": "./frames#AppFrame",
        "package": "@clossys/designer",
        "version": "0.12.0"
      },
      "relation": "subset",
      "slot": "frames.app-shell",
      "source": "foundry",
      "sourceAddress": "./frames#AppFrame",
      "status": "draft",
      "trust": "foundry",
      "unmapped": [
        "slot.progress"
      ]
    }
  },
  "frames": {
    "app-shell": {
