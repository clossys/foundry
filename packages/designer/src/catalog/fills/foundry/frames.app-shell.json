        "layout.standard",
        "stage.contained",
        "stage.full",
        "theme.dark",
        "theme.light",
        "theme.system"
      ],
      "propMap": {
        "layout.immersive": "layout=immersive",
        "layout.standard": "layout=standard",
        "stage.contained": "stage=contained",
        "stage.full": "stage=full",
        "theme.dark": "theme.defaultPreference=dark",
        "theme.light": "theme.defaultPreference=light",
        "theme.system": "theme.defaultPreference=system"
      },
      "slot": "frames.app-shell",
      "slots": {
        "command": "commands",
        "header": "context",
        "inspector": "rightPanel",
        "main": "children",
        "sidebar": "navigation",
        "skip-link": "skipLabel",
        "toasts": "toasts"
      },
      "statePorts": {
        "inspector-collapsed": "rightPanel.collapsed/rightPanel.onCollapsedChange",
        "sidebar-collapsed": "navigation.collapsed/navigation.onCollapsedChange",
        "theme": "theme.preference/theme.onPreferenceChange",
        "width": "rightPanel.value/rightPanel.onChange"
      }
    }
