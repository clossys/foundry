{
  "$extensions": {
    "com.clossys.fill": {
      "author": "foundry",
      "builtOn": [],
      "conforms": [
        "dtcg#format",
        "dtcg#alias"
      ],
      "evidence": [
        {
          "check": "C1",
          "clause": "dtcg#format"
        },
        {
          "check": "C2",
          "clause": "dtcg#alias"
        }
      ],
      "id": "foundry/tokens.role.depth.elevation",
      "license": "MIT",
      "mode": "implementation",
      "relation": "same-contract",
      "slot": "tokens.role.depth.elevation",
      "source": "foundry",
      "sourceAddress": "styles/tokens.css",
      "status": "draft",
      "trust": "foundry"
    }
  },
  "tokens": {
    "role": {
      "depth": {
        "elevation": {
          "floating": {
            "$extensions": {
              "com.clossys.css": {
                "raw": "0 8px 24px rgba(0, 0, 0, 0.10)"
              },
              "com.clossys.modes": {
                "dark": "0 8px 24px rgba(0, 0, 0, 0.6)"
              }
            },
            "$type": "shadow",
            "$value": "0 8px 24px rgba(0, 0, 0, 0.10)"
          },
          "none": {
            "$extensions": {
              "com.clossys.css": {
                "raw": "none"
              }
            },
            "$type": "shadow",
            "$value": "none"
          },
          "panel": {
            "$type": "shadow",
            "$value": "{tokens.role.depth.elevation.floating}"
          },
          "raised": {
            "$extensions": {
              "com.clossys.css": {
                "raw": "0 1px 0 var(--color-line-base, oklch(0.8761 0 0))",
                "reads": [
                  "tokens.role.color.border.base"
                ]
              }
            },
            "$type": "shadow",
            "$value": "0 1px 0 var(--color-line-base, oklch(0.8761 0 0))"
          }
        }
      }
    }
  }
}
