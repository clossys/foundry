{
  "schema": "clossys.designer-ia-extension/1",
  "id": "slides",
  "owns": "The Slides medium (foundry-build-0027). foundry-build-0032 (audit P3): the deck frame is registered in the frames layer (ia/frames.json, slots/frames.json), and the six slide sections are retired in place, each deduped into a medium config of its live twin (`retired` below): the twin's contract declares media slide and web, and Writer copy for a slide is the twin's section copy. The slide ids stay placed so they are never reused. `slots` and the slide package defaults stay as the record of what each slide was and the render source a deck reads until Publisher repoints its deck layout to the twins; frames.deck there mirrors its registered contract until Publisher reads slots/frames.json.",
  "families": [
    {
      "layer": "sections",
      "l1": "sections",
      "node": {
        "id": "sections-slides",
        "label": "Slides",
        "leaves": [
          "sections.slide-title",
          "sections.slide-agenda",
          "sections.slide-statement",
          "sections.slide-two-column",
          "sections.slide-quote",
          "sections.slide-closing"
        ]
      }
    }
  ],
  "retired": [
    { "id": "sections.slide-title", "retiredAt": "2026-11-16", "replacedBy": "sections.hero", "config": "medium.slide", "decidedBy": "owner 2026-11-16 (go with your recommendation); foundry-build-0032 audit P3", "reason": "pairwise dedupe: a title slide is the hero on the slide medium" },
    { "id": "sections.slide-agenda", "retiredAt": "2026-11-16", "replacedBy": "sections.table-of-contents", "config": "medium.slide", "decidedBy": "owner 2026-11-16 (go with your recommendation); foundry-build-0032 audit P3", "reason": "pairwise dedupe: an agenda slide is the table of contents on the slide medium" },
    { "id": "sections.slide-statement", "retiredAt": "2026-11-16", "replacedBy": "sections.content", "config": "medium.slide layout.stacked", "decidedBy": "owner 2026-11-16 (go with your recommendation); foundry-build-0032 audit P3", "reason": "pairwise dedupe: a statement slide is stacked content on the slide medium (sections.band declares no copy)" },
    { "id": "sections.slide-two-column", "retiredAt": "2026-11-16", "replacedBy": "sections.content", "config": "medium.slide layout.split-start", "decidedBy": "owner 2026-11-16 (go with your recommendation); foundry-build-0032 audit P3", "reason": "pairwise dedupe: a two-column slide is split content on the slide medium" },
    { "id": "sections.slide-quote", "retiredAt": "2026-11-16", "replacedBy": "sections.testimonials", "config": "medium.slide layout.single", "decidedBy": "owner 2026-11-16 (go with your recommendation); foundry-build-0032 audit P3", "reason": "pairwise dedupe: a quote slide is a single testimonial on the slide medium" },
    { "id": "sections.slide-closing", "retiredAt": "2026-11-16", "replacedBy": "sections.call-to-action", "config": "medium.slide", "decidedBy": "owner 2026-11-16 (go with your recommendation); foundry-build-0032 audit P3", "reason": "pairwise dedupe: a closing slide is the call to action on the slide medium" }
  ],
  "slots": {
    "frames.deck": {
      "kind": "frame",
      "root": "main",
      "canvas": { "aspect": "16:9", "width": 1920, "height": 1080 },
      "chrome": [],
      "slots": [{ "id": "slide", "accepts": "sections.slide-*", "required": true, "max": 1 }],
      "variants": { "aspect": ["16:9"] },
      "surface": "deck"
    },
    "sections.slide-title": {
      "kind": "section",
      "root": "section",
      "media": ["slide", "web"],
      "variants": { "medium": ["web", "slide"] },
      "copy": { "fields": [
        { "key": "heading", "kind": "plain", "role": "heading", "required": true, "maxLength": { "en": 60 } },
        { "key": "subheading", "kind": "plain", "role": "subheading", "required": false, "maxLength": { "en": 120 } },
        { "key": "eyebrow", "kind": "plain", "role": "eyebrow", "required": false, "maxLength": { "en": 40 } }
      ] }
    },
    "sections.slide-agenda": {
      "kind": "section",
      "root": "section",
      "media": ["slide", "web"],
      "variants": { "medium": ["web", "slide"] },
      "copy": { "fields": [
        { "key": "heading", "kind": "plain", "role": "heading", "required": true, "maxLength": { "en": 60 } },
        { "key": "items", "kind": "list", "role": "item", "required": true, "max": 6, "maxLength": { "en": 80 } }
      ] }
    },
    "sections.slide-statement": {
      "kind": "section",
      "root": "section",
      "media": ["slide", "web"],
      "variants": { "medium": ["web", "slide"] },
      "copy": { "fields": [
        { "key": "statement", "kind": "plain", "role": "statement", "required": true, "maxLength": { "en": 140 } },
        { "key": "support", "kind": "plain", "role": "body", "required": false, "maxLength": { "en": 200 } }
      ] }
    },
    "sections.slide-two-column": {
      "kind": "section",
      "root": "section",
      "media": ["slide", "web"],
      "variants": { "medium": ["web", "slide"] },
      "copy": { "fields": [
        { "key": "heading", "kind": "plain", "role": "heading", "required": true, "maxLength": { "en": 60 } },
        { "key": "left.heading", "kind": "plain", "role": "heading", "required": false, "maxLength": { "en": 40 } },
        { "key": "left.body", "kind": "plain", "role": "body", "required": true, "maxLength": { "en": 280 } },
        { "key": "right.heading", "kind": "plain", "role": "heading", "required": false, "maxLength": { "en": 40 } },
        { "key": "right.body", "kind": "plain", "role": "body", "required": true, "maxLength": { "en": 280 } }
      ] }
    },
    "sections.slide-quote": {
      "kind": "section",
      "root": "figure",
      "media": ["slide", "web"],
      "variants": { "medium": ["web", "slide"] },
      "copy": { "fields": [
        { "key": "quote", "kind": "plain", "role": "quote", "required": true, "maxLength": { "en": 240 } },
        { "key": "attribution", "kind": "plain", "role": "attribution", "required": true, "maxLength": { "en": 60 } },
        { "key": "title", "kind": "plain", "role": "caption", "required": false, "maxLength": { "en": 60 } }
      ] }
    },
    "sections.slide-closing": {
      "kind": "section",
      "root": "section",
      "media": ["slide", "web"],
      "variants": { "medium": ["web", "slide"] },
      "copy": { "fields": [
        { "key": "heading", "kind": "plain", "role": "heading", "required": true, "maxLength": { "en": 60 } },
        { "key": "body", "kind": "plain", "role": "body", "required": false, "maxLength": { "en": 160 } },
        { "key": "contact", "kind": "plain", "role": "caption", "required": false, "maxLength": { "en": 80 } }
      ] }
    }
  }
}
