// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`server-safe BarChart > keeps the published default DOM and corner byte for byte 1`] = `"<figure class="m-0 flex flex-col gap-sm"><figcaption class="text-body-s text-ink-secondary font-body">Sample counts</figcaption><svg viewBox="0 0 480 280" width="480" height="280" role="img" aria-labelledby="_R_0_" aria-describedby="_R_0H1_" data-chart-part="frame"><title id="_R_0_">Sample counts</title><desc id="_R_0H1_">Counts by period</desc><g data-chart-part="grid"></g><g data-chart-part="axis"><line x1="48" x2="464" y1="248" y2="248" stroke="var(--color-chart-axis, var(--color-line-strong, oklch(0.7763 0 0)))" stroke-width="1"></line></g><g data-chart-part="ticks" fill="var(--color-chart-axis-label, var(--color-ink-muted, oklch(0.54 0 0)))" font-size="11" font-family="var(--font-body, ui-sans-serif, system-ui, -apple-system, &quot;Segoe UI&quot;, sans-serif)"></g><g data-chart-part="marks"><g data-chart-part="grid"><line x1="48" x2="464" y1="306" y2="306" stroke="var(--color-chart-grid, oklch(0.91 0 0))" stroke-width="1"></line><line x1="48" x2="464" y1="209.33333333333334" y2="209.33333333333334" stroke="var(--color-chart-grid, oklch(0.91 0 0))" stroke-width="1"></line><line x1="48" x2="464" y1="112.66666666666666" y2="112.66666666666666" stroke="var(--color-chart-grid, oklch(0.91 0 0))" stroke-width="1"></line><line x1="48" x2="464" y1="16" y2="16" stroke="var(--color-chart-grid, oklch(0.91 0 0))" stroke-width="1"></line></g><g data-chart-part="ticks" font-size="11" fill="var(--color-chart-axis-label, var(--color-ink-muted, oklch(0.54 0 0)))" font-family="var(--font-body, ui-sans-serif, system-ui, -apple-system, &quot;Segoe UI&quot;, sans-serif)"><text x="40" y="306" text-anchor="end" dominant-baseline="middle">-5</text><text x="40" y="209.33333333333334" text-anchor="end" dominant-baseline="middle">0</text><text x="40" y="112.66666666666666" text-anchor="end" dominant-baseline="middle">5</text><text x="40" y="16" text-anchor="end" dominant-baseline="middle">10</text><text x="152" y="264" text-anchor="middle">First</text><text x="360" y="264" text-anchor="middle">Next</text></g><g data-chart-part="cluster"><g><rect x="128" y="16" width="22" height="193.33333333333334" rx="4" fill="var(--color-chart-categorical-1, #2a78d6)" fill-opacity="1" stroke="none" stroke-width="0" tabindex="0" role="img" aria-label="Group A, First: 10"><title>Group A, First: 10</title></rect></g><g><rect x="152" y="132" width="22" height="77.33333333333334" rx="4" fill="var(--color-chart-categorical-2, #eb6834)" fill-opacity="1" stroke="none" stroke-width="0" tabindex="0" role="img" aria-label="Group B, First: 4"><title>Group B, First: 4</title></rect></g></g><g data-chart-part="cluster"><g><rect x="336" y="209.33333333333334" width="22" height="38.66666666666666" rx="4" fill="var(--color-chart-categorical-1, #2a78d6)" fill-opacity="1" stroke="none" stroke-width="0" tabindex="0" role="img" aria-label="Group A, Next: -2"><title>Group A, Next: -2</title></rect><text x="347" y="205.33333333333334" text-anchor="middle" font-size="11" fill="var(--color-chart-axis-label, var(--color-ink-muted, oklch(0.54 0 0)))" font-family="var(--font-body, ui-sans-serif, system-ui, -apple-system, &quot;Segoe UI&quot;, sans-serif)">-2</text></g><g><rect x="360" y="93.33333333333334" width="22" height="116" rx="4" fill="var(--color-chart-categorical-2, #eb6834)" fill-opacity="1" stroke="none" stroke-width="0" tabindex="0" role="img" aria-label="Group B, Next: 6"><title>Group B, Next: 6</title></rect><text x="371" y="89.33333333333334" text-anchor="middle" font-size="11" fill="var(--color-chart-axis-label, var(--color-ink-muted, oklch(0.54 0 0)))" font-family="var(--font-body, ui-sans-serif, system-ui, -apple-system, &quot;Segoe UI&quot;, sans-serif)">6</text></g></g></g></svg><ul data-chart-part="legend" class="m-0 flex list-none flex-wrap gap-md p-0 text-body-s text-ink-secondary font-body"><li class="inline-flex items-center gap-xs"><span aria-hidden="true" class="inline-block h-3 w-3 rounded-subtle" style="background-color:var(--color-chart-categorical-1, #2a78d6)"></span>Group A</li><li class="inline-flex items-center gap-xs"><span aria-hidden="true" class="inline-block h-3 w-3 rounded-subtle" style="background-color:var(--color-chart-categorical-2, #eb6834)"></span>Group B</li></ul><details data-chart-part="table-fallback"><summary class="text-body-s text-ink-secondary font-body cursor-pointer">View as table</summary><table class="text-body-s font-body"><caption class="sr-only">Sample counts</caption><thead><tr><th scope="col">Category</th><th scope="col">Group A</th><th scope="col">Group B</th></tr></thead><tbody><tr><td>First</td><td>10</td><td>4</td></tr><tr><td>Next</td><td>-2</td><td>6</td></tr></tbody></table></details></figure>"`;
