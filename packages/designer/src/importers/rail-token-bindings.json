{
  "version": 1,
  "utilities": [
    {
      "utility": "tracking-tight",
      "member": "themes.tracking-tight.default",
      "output": "tracking-(--tracking-meta)"
    },
    {
      "utility": "tracking-widest",
      "member": "themes.tracking-tight.default",
      "output": "tracking-(--tracking-label)"
    },
    {
      "utility": "max-w-sm",
      "output": "max-w-(--ui-width-notice-max)"
    },
    {
      "utility": "max-w-xs",
      "output": "max-w-(--ui-width-notice-max)"
    },
    {
      "utility": "max-h-72",
      "output": "max-h-(--ui-width-notice-max)"
    },
    {
      "utility": "leading-normal",
      "output": "leading-(--leading-heading)"
    },
    {
      "utility": "leading-snug",
      "output": "leading-(--leading-heading)"
    },
    {
      "utility": "h-px",
      "output": "h-(--ui-border-hairline)"
    },
    {
      "utility": "translate-x-px",
      "output": "translate-x-(--ui-border-hairline)"
    },
    {
      "utility": "-translate-x-px",
      "output": "-translate-x-(--ui-border-hairline)"
    },
    {
      "utility": "w-[2px]",
      "output": "w-(--ui-border-rule)"
