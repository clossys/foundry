    {
      "utility": "duration-150",
      "output": "duration-(--ui-duration-fast)"
    },
    {
      "utility": "ease-linear",
      "output": "ease-(--ease-default)"
    },
    {
      "utility": "ease-in-out",
      "output": "ease-(--ease-default)"
    },
    {
      "utility": "z-10",
      "output": "z-(--ui-z-sticky)"
    },
    {
      "utility": "z-20",
      "output": "z-(--ui-z-aside)"
    },
    {
      "utility": "z-50",
      "output": "z-(--ui-z-modal)"
    },
    {
      "utility": "bg-black/10",
      "output": "bg-(--color-overlay-scrim)"
    }
