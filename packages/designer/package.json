{
  "name": "@clossys/designer",
  "version": "0.2.4",
  "private": false,
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./styles/*.css"
  ],
  "description": "The designer role: is it well made? A complete visual system — design tokens, theme CSS, accessible React components, icons, charts, and visual quality gates.",
  "keywords": [
    "react",
    "components",
    "design-system",
    "react-aria",
    "tailwindcss",
    "accessibility",
    "typescript"
  ],
  "author": "Calvin Hung",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clossys/foundry.git",
    "directory": "packages/designer"
  },
  "bugs": {
    "url": "https://github.com/clossys/foundry/issues"
  },
  "homepage": "https://github.com/clossys/foundry/tree/main/packages/designer#readme",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js"
    },
    "./tokens.css": "./styles/tokens.css",
    "./theme.css": "./styles/theme.css",
    "./compiled.css": "./styles/compiled.css",
    "./brand-template.css": "./styles/brand-template.css",
    "./atoms": {
      "types": "./dist/atoms/index.d.ts",
      "import": "./dist/atoms/index.js"
    },
    "./atoms/server": {
      "types": "./dist/atoms/server.d.ts",
      "import": "./dist/atoms/server.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.js"
    },
    "./charts": {
      "types": "./dist/charts/index.d.ts",
      "import": "./dist/charts/index.js"
    },
    "./charts/server": {
      "types": "./dist/charts/server.d.ts",
      "import": "./dist/charts/server.js"
    },
    "./blocks": {
      "types": "./dist/blocks/index.d.ts",
      "import": "./dist/blocks/index.js"
    },
    "./blocks/server": {
      "types": "./dist/blocks/server.d.ts",
      "import": "./dist/blocks/server.js"
    },
    "./shell": {
      "types": "./dist/shell/index.d.ts",
      "import": "./dist/shell/index.js"
    },
    "./shell/server": {
      "types": "./dist/shell/server.d.ts",
      "import": "./dist/shell/server.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js"
    },
    "./theme/server": {
      "types": "./dist/theme/server.d.ts",
      "import": "./dist/theme/server.js"
    },
    "./gate": {
      "types": "./dist/gate-index.d.ts",
      "import": "./dist/gate-index.js"
    },
    "./render-environment": {
      "types": "./dist/render-environment.d.ts",
      "import": "./dist/render-environment.js"
    }
  },
  "bin": {
    "designer-token-check": "./dist/cli.js",
    "designer-brand-check": "./dist/tokens/cli.js",
    "designer-contrast-check": "./dist/tokens/contrast-cli.js",
    "designer-environment-check": "./dist/environment-conformance-cli.js"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "styles",
    "CHANGELOG.md",
    "README.md",
    "TOKENS.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "node ../../scripts/check-name-collision.mjs . && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "generate:icons": "node scripts/generate-icons.mjs",
    "generate:compiled-css": "npm run build && node dist/compiled-css/cli.js --write",
    "check:compiled-css": "npm run build && node dist/compiled-css/cli.js --check"
  },
  "peerDependencies": {
    "@internationalized/date": "^3.12.2",
    "react": ">=18",
    "react-dom": ">=18",
    "react-aria-components": "^1.19.0",
    "tailwind-merge": "^3.0.0",
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@internationalized/date": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-aria-components": {
      "optional": true
    },
    "tailwind-merge": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.25.12",
    "jsdom": "^26.1.0",
    "react": "^19.2.8",
    "react-aria-components": "^1.20.0",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "vitest": "^4.1.9"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
