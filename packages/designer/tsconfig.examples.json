{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "paths": {
      "@clossys/designer/atoms": [
        "./src/atoms/index.ts"
      ],
      "@clossys/designer/atoms/server": [
        "./src/atoms/server.ts"
      ],
      "@clossys/designer/blocks": [
        "./src/blocks/index.ts"
      ],
      "@clossys/designer/blocks/server": [
        "./src/blocks/server.ts"
      ],
      "@clossys/designer/charts": [
        "./src/charts/index.ts"
      ],
      "@clossys/designer/charts/server": [
        "./src/charts/server.ts"
      ],
      "@clossys/designer/gate": [
        "./src/gate-index.ts"
      ],
      "@clossys/designer/icons": [
        "./src/icons/index.ts"
      ],
      "@clossys/designer/shell": [
        "./src/shell/index.ts"
      ],
      "@clossys/designer/theme": [
        "./src/theme/index.ts"
      ],
      "@clossys/designer/tokens": [
        "./src/tokens/index.ts"
      ],
      "@clossys/designer/tokens/preview": [
        "./src/tokens/preview/index.tsx"
      ],
      "@clossys/designer/tokens/server": [
        "./src/tokens/server.ts"
      ]
    }
  },
  "include": [
    "examples/**/*"
  ],
  "exclude": []
}
