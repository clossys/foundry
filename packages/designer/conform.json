{
  "schema": "clossys.conform-adapter/1",
  "agent": "designer",
  "trees": [
    {
      "file": "src/catalog/ia/themes.json",
      "freeze": "src/catalog/ia/themes.leaf-freeze.json"
    },
    {
      "file": "src/catalog/ia/assets.json",
      "freeze": "src/catalog/ia/assets.leaf-freeze.json",
      "amendments": [
        "src/catalog/ia/assets.leaf-amendments.json",
        "src/catalog/ia/assets.draft-leaf-amendments.json"
      ]
    },
    {
      "file": "src/catalog/ia/components.json",
      "freeze": "src/catalog/ia/components.leaf-freeze.json",
      "amendments": [
        "src/catalog/ia/components.leaf-amendments.json",
        "src/catalog/ia/components.specimen-leaf-amendments.json"
      ]
    },
    {
      "file": "src/catalog/ia/sections.json",
      "freeze": "src/catalog/ia/sections.leaf-freeze.json"
    },
    {
      "file": "src/catalog/ia/frames.json",
      "freeze": "src/catalog/ia/frames.leaf-freeze.json"
    }
  ],
  "kinds": [
    "element/token",
    "element/asset",
    "element/component",
    "element/section",
    "element/frame"
  ],
  "defaults": [
    "src/catalog/defaults"
  ],
  "recipes": [
    {
      "dir": "recipes/create.app-section", "fixture": {"output": "recipes/create.app-section/fixture/sections.band.json", "slot": "sections.band"}
    },
    {
      "dir": "recipes/create.component", "fixture": {"output": "recipes/create.component/fixture/components.button.json", "slot": "components.button"}
    },
    {
      "dir": "recipes/create.element", "fixture": {"output": "recipes/create.element/fixture/assets.image.json", "slot": "assets.image"}
    },
    {
      "dir": "recipes/create.frame", "fixture": {"output": "recipes/create.frame/fixture/frames.site-shell.json", "slot": "frames.site-shell"}
    },
    {
      "dir": "recipes/create.glyph", "fixture": {"output": "recipes/create.glyph/fixture/assets.icon-chevron-up.json", "slot": "assets.icon-chevron-up"}
    },
    {
      "dir": "recipes/create.mark", "fixture": {"output": "recipes/create.mark/fixture/assets.mark.json", "slot": "assets.mark"}
    },
    {
      "dir": "recipes/create.marketing-section", "fixture": {"output": "recipes/create.marketing-section/fixture/sections.hero.json", "slot": "sections.hero"}
    },
    {
      "dir": "recipes/create.tokens", "fixture": {"output": "recipes/create.tokens/fixture/themes.primary.json", "slot": "themes.primary"}
    }
  ],
  "derive": [{"module": "src/catalog-core/index.ts"}],
  "edgeFiles": [
    {
      "file": "src/catalog/slot-contracts/themes.json",
      "format": "slot-contracts"
    },
    {
      "file": "src/catalog/slot-contracts/assets.json",
      "format": "slot-contracts"
    },
    {
      "file": "src/catalog/slot-contracts/components.json",
      "format": "slot-contracts"
    },
    {
      "file": "src/catalog/slot-contracts/sections.json",
      "format": "slot-contracts"
    },
    {
      "file": "src/catalog/slot-contracts/frames.json",
      "format": "slot-contracts"
    },
    {
      "file": "src/catalog/reports/usage-graph.json",
      "format": "usage-graph"
    }
  ],
  "loops": ["loop.scope", "loop.slot", "loop.create", "loop.choose", "loop.cascade"],
  "skill": "skill/SKILL.md",
  "skills": {
    "scope": "packages/designer/actions/designer.scope/skill.md",
    "slot": "packages/designer/actions/designer.slot/skill.md",
    "create": "packages/designer/actions/designer.candidates/skill.md",
    "choose": "packages/designer/actions/pick.designer/skill.md",
    "cascade": "packages/designer/actions/designer.cascade/skill.md"
  },
  "requests": {
    "issuing": [
      {"to": "director", "kinds": ["slot", "change"]}
    ],
    "handling": {
      "slot": {"skill": "packages/designer/actions/designer.slot/skill.md", "loop": "loop.slot"},
      "change": {"skill": "packages/designer/actions/designer.candidates/skill.md", "loop": "loop.create"},
      "fix": {"skill": "packages/designer/actions/designer.candidates/skill.md", "loop": "loop.create"}
    }
  }
}
