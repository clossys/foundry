{
  "name": "@clossys/publisher",
  "version": "0.4.26",
  "private": false,
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "description": "The publisher role: did we put it out to an audience, and can we prove what shipped? Surface composition, media registries, and channel renderers for web, email, print, images, and slides, plus a product-neutral structured-document contract, under `./core`, `./media`, `./web`, `./document`, `./email`, `./print`, `./image`, and `./slides`; an append-only, content-addressed record of what was published, to which channel, when, and citing which facts, plus a drift checker, under `./record`. One package, one version: every time the publisher runs, the record runs, and the record still does not import the composer.",
  "keywords": [
    "publisher",
    "composition",
    "render",
    "web",
    "email",
    "print",
    "image",
    "slides",
    "ledger",
    "append-only",
    "attribution",
    "drift",
    "content-addressed",
    "typescript"
  ],
  "author": "Clossys",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clossys/foundry.git",
    "directory": "packages/publisher"
  },
  "bugs": {
    "url": "https://github.com/clossys/foundry/issues"
  },
  "homepage": "https://github.com/clossys/foundry/tree/main/packages/publisher#readme",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./assessment": {
      "types": "./dist/verified-publication-rate.d.ts",
      "import": "./dist/verified-publication-rate.js"
    },
    "./media": {
      "types": "./dist/media/index.d.ts",
      "import": "./dist/media/index.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "react-server": "./dist/web/server.js",
      "import": "./dist/web/index.js"
    },
    "./document": {
      "types": "./dist/document/index.d.ts",
      "import": "./dist/document/index.js"
    },
    "./email": {
      "types": "./dist/email/index.d.ts",
      "import": "./dist/email/index.js"
    },
    "./print": {
      "types": "./dist/print/index.d.ts",
      "import": "./dist/print/index.js"
    },
    "./image": {
      "types": "./dist/image/index.d.ts",
      "import": "./dist/image/index.js"
    },
    "./slides": {
      "types": "./dist/slides/index.d.ts",
      "import": "./dist/slides/index.js"
    },
    "./record": {
      "types": "./dist/record/index.d.ts",
      "import": "./dist/record/index.js"
    }
  },
  "imports": {
    "#publisher-web-views": {
      "types": "./dist/web/views/index.d.ts",
      "react-server": "./dist/web/views/server.js",
      "default": "./dist/web/views/index.js"
    }
  },
  "bin": {
    "publisher-media-check": "dist/media/cli.js",
    "publisher-record-check": "dist/record/cli.js",
    "publisher-rate-check": "dist/verified-publication-rate-cli.js",
    "publisher-web-route-check": "dist/web/checkWebRoutesCli.js",
    "publisher-preview": "dist/preview/cli.js"
  },
  "foundry": {
    "assessment": {
      "bin": "publisher-rate-check",
      "invocation": "single-json-input"
    },
    "capabilities": [
      {
        "id": "v0-launch-pack-planning-and-inventory",
        "subQuestion": "What does this product owe its v0 Launch pack, and what already exists versus is still needed?",
        "worldClass": "Every new product gets one declared inventory of what the v0 Launch pack owes it and what state each item is actually in — never assembled ad hoc per product.",
        "inputs": [],
        "outputs": [
          "clossys/publisher/pack.json"
        ],
        "proofCase": "media-satisfied",
        "maturity": "planned",
        "v0": true,
        "businessLifecycleStage": "launch"
      },
      {
        "id": "surface-documents",
        "subQuestion": "Is every audience-facing surface declared once as a validated document, with its template and locations resolved?",
        "worldClass": "Every published surface is one validated SurfaceDocument resolving to a registered template and a real channel location — never a page composed ad hoc outside the document.",
        "inputs": [
          {
            "producerRole": "@clossys/writer",
            "artifact": "copy-registry"
          },
          {
            "producerRole": "@clossys/designer",
            "artifact": "component-roster"
          }
        ],
        "outputs": [
          "clossys/publisher/surfaces.json"
        ],
        "proofCase": "media-satisfied",
        "maturity": "built",
        "v0": true,
        "businessLifecycleStage": "launch"
      },
      {
        "id": "channel-rendering",
        "subQuestion": "Does every declared surface render correctly to its channel — web, email, image, print, document, or slides?",
        "worldClass": "A surface document renders byte-identically to its golden fixture on every channel it declares, checked, never eyeballed per release.",
        "inputs": [
          {
            "producerRole": "@clossys/designer",
            "artifact": "brand-kit"
          }
        ],
        "outputs": [
          "clossys/publisher/render-report.json"
        ],
        "proofCase": "media-satisfied",
        "maturity": "built",
        "v0": true,
        "businessLifecycleStage": "launch"
      },
      {
        "id": "templates-and-channel-specs",
        "subQuestion": "Is every channel's template and spec declared once and reused, never improvised per page?",
        "worldClass": "A channel template is data — a declared block sequence and spec — never an arbitrary per-page build function.",
        "inputs": [],
        "outputs": [
          "clossys/publisher/templates.json"
        ],
        "proofCase": "media-satisfied",
        "maturity": "built",
        "v0": true,
        "businessLifecycleStage": "build"
      },
      {
        "id": "materials-site",
        "subQuestion": "Is there one public materials site a client can point a prospect at?",
        "worldClass": "One assembled, current public site carries the product's overview, deck, and HTML-only slides — never a scatter of one-off files a client has to assemble by hand.",
        "inputs": [
          {
            "producerRole": "@clossys/writer",
            "artifact": "messaging-kit"
          },
          {
            "producerRole": "@clossys/designer",
            "artifact": "brand-kit"
          }
        ],
        "outputs": [
          "clossys/publisher/materials-site.json"
        ],
        "proofCase": "media-satisfied",
        "maturity": "partial",
        "v0": true,
        "businessLifecycleStage": "launch"
      },
      {
        "id": "channel-kits",
        "subQuestion": "Is there one governed kit — assets, copy slots, specs — per channel a client can hand to that channel's own tool?",
        "worldClass": "Every channel (email, social) has one governed kit of checked assets and copy slots at the exact sizes and roles that channel requires — never assembled by hand per send.",
        "inputs": [
          {
            "producerRole": "@clossys/designer",
            "artifact": "brand-kit"
          }
        ],
        "outputs": [
          "clossys/publisher/channel-kits.json"
        ],
        "proofCase": "media-satisfied",
        "maturity": "partial",
        "v0": true,
        "businessLifecycleStage": "launch"
      },
      {
        "id": "sealing-and-the-publication-record",
        "subQuestion": "Once published, is the exact shipped result sealed into an immutable, append-only record?",
        "worldClass": "Every publication event is appended once to an immutable record — never overwritten, never silently lost.",
        "inputs": [],
        "outputs": [
          "clossys/publisher/record.json"
        ],
        "proofCase": "media-satisfied",
        "maturity": "built",
        "v0": true,
        "businessLifecycleStage": "deliver"
      },
      {
        "id": "live-parity",
        "subQuestion": "Does what's live still match what was sealed, or has it drifted?",
        "worldClass": "Every citation in a sealed publication is re-checked against the current source value, and drift is reported, never assumed absent.",
        "inputs": [],
        "outputs": [
          "clossys/publisher/drift-report.json"
        ],
        "proofCase": "media-satisfied",
        "maturity": "built",
        "v0": false,
        "businessLifecycleStage": "operate"
      }
    ]
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "skill"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "node ../../scripts/check-name-collision.mjs . && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@clossys/writer": "^0.3.0",
    "@clossys/designer": "^0.4.0",
    "@clossys/controller": "~0.9.0"
  },
  "peerDependencies": {
    "@internationalized/date": "^3.12.2",
    "react": ">=18",
    "react-aria-components": "^1.19.0",
    "react-dom": ">=18",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@internationalized/date": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-aria-components": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "tailwind-merge": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.3.0",
    "jsdom": "^26.1.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
