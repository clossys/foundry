{
  "schema": "clossys.publisher-ia/1",
  "l0": "release",
  "label": "Release",
  "owns": "Readiness of one publication: exports, locales, gates, owner ready sign-off; versions over time. Never going live.",
  "nodes": [
    {
      "id": "release/web",
      "label": "Web",
      "children": [
        {
          "id": "release/web/site",
          "label": "Site releases",
          "leaves": [
            "release.site"
          ]
        },
        {
          "id": "release/web/docs",
          "label": "Docs releases",
          "leaves": [
            "release.docs"
          ]
        },
        {
          "id": "release/web/app",
          "label": "App releases",
          "leaves": [
            "release.app"
          ]
        },
        {
          "id": "release/web/admin",
          "label": "Admin releases",
          "leaves": [
            "release.admin"
          ]
        }
      ]
    },
    {
      "id": "release/slides",
      "label": "Slides",
      "children": [
        {
          "id": "release/slides/slides",
          "label": "Slides releases",
          "leaves": [
            "release.slides"
          ]
        }
      ]
    },
    {
      "id": "release/documents",
      "label": "Documents",
      "parked": true,
      "children": [
        {
          "id": "release/documents/document",
          "label": "Document releases",
          "parked": true,
          "leaves": [
            "release.company-one-pager"
          ]
        }
      ]
    }
  ],
  "slots": {
    "release.site": {
      "kind": "release",
      "standard": "release",
      "publication": "site",
      "exports": [
        {
          "kind": "react-static"
        },
        {
          "kind": "pdf",
          "pages": [
            "publisher/page.terms",
            "publisher/page.privacy"
          ]
        }
      ],
      "locales": {
        "from": "director/focus.reach.geography:Language"
      },
      "gates": [
        "copy.sample-remaining",
        "pins.resolve",
        "constitution.strict",
        "copy.locales",
        "release.locales"
      ],
      "signoff": {
        "by": "owner",
        "raise": "queue.approve"
      },
      "readyMeans": "pinned; not live (Distribution parked)",
      "inputs": [
        "director/focus.reach.geography",
        "publisher/page.terms",
        "publisher/page.privacy"
      ],
      "requirements": [
        {
          "check": "release.manifest"
        }
      ],
      "family": {
        "options": 1,
        "varyOn": null,
        "values": []
      }
    },
    "release.docs": {
      "kind": "release",
      "standard": "release",
      "publication": "docs",
