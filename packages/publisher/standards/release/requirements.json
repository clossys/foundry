{
  "schema": "clossys.standard/1",
  "id": "release",
  "kinds": [
    "publication"
  ],
  "mode": "craft",
  "craftTier": "mid",
  "seeds": [],
  "requirements": [
    {
      "check": "release.manifest",
      "params": {}
    }
  ],
  "preview": {
    "card": {
      "method": "inline",
      "intrinsicWidth": null,
      "mustContain": [
        "[data-release-build]",
        "[data-release-gates]",
        "[data-pin-count]"
      ],
      "states": [
        "loading",
        "not-needed",
        "no-preview",
        "failed",
        "not-pinned"
      ]
    }
  }
}
