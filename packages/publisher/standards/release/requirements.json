{
  "schema": "clossys.standard/1",
  "id": "release",
  "kinds": [
    "publication"
  ],
  "mode": "craft",
  "craftTier": "mid",
  "seeds": [],
  "createOnly": true,
  "createOnlyReason": "A release manifest records one consumer build, its exact inputs, gate results and pins, so no seed or package default can stand in for it and every release is created per consumer by the Publisher.",
  "requirements": [
    {
      "check": "release.manifest",
      "params": {}
    }
  ],
  "preview": {
    "card": {
      "method": "inline",
      "intrinsicWidth": null,
      "mustContain": [
        "[data-release-build]",
        "[data-release-gates]",
        "[data-pin-count]"
      ],
      "states": [
        "loading",
        "not-needed",
        "no-preview",
        "failed",
        "not-pinned"
      ]
    }
  }
}
