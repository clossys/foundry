{
  "clossys": {
    "schema": "clossys.candidate/1",
    "id": "publisher/loop.create/package:create-v1.json",
    "agent": "publisher",
    "kind": "candidate",
    "status": "submitted",
    "slot": "publisher/loop.create",
    "createdBy": {
      "actor": "package",
      "package": "@clossys/publisher",
      "version": "0.13.0"
    },
    "createdAt": "2026-11-17T00:00:00Z",
    "refs": [],
    "source": {
      "kind": "package-default",
      "ref": []
    },
    "rationale": []
  },
  "content": {
    "trigger": [
      "T2",
      "T3",
      "T4",
      "T5",
      "T6",
      "T7"
    ],
    "steps": [
      {
        "id": "triage",
        "does": "code reads the run's trigger: one that names one record and no rule (T1 init, T2 starter-fill, T4 add-l3, T6 failed-check, T7 upstream-cascade, T8 new-release) settles refine-brief with no tightening and keeps a settle record; only a slot-wide trigger (T3 tighten-brief, T5 owner-feedback) reaches the owner of the slot",
        "decider": {
          "by": "code"
        },
        "cli": "clossys settle brief <ref>",
        "reads": [
          "<slot>/slot.json"
        ],
        "writes": [
          ".clossys/runs/loops/*.settle/*"
        ],
        "checks": []
      },
      {
        "id": "refine-brief",
        "does": "decide whether the trigger is a rule for the whole slot (tighten the brief) or one record; often no tightening",
        "decider": {
          "by": "agent",
          "agent": "publisher",
          "verb": "refine-brief",
          "tier": "mid",
          "skill": "packages/publisher/actions/publisher.brief/skill.md"
        },
        "cli": "clossys brief <ref> --tighten --path <path> --op <op> --value <value> --why <why> --by <by>",
        "reads": [
          "<slot>/slot.json",
          "<inputs>",
          "designer/*/pin.json",
          "writer/*/pin.json"
        ],
        "writes": [
          "<slot>/slot.json"
        ],
        "checks": [
          "brief.tighten-only"
        ],
        "onFail": {
          "raise": "queue.clarify",
          "then": "retry"
        }
      },
      {
        "id": "create",
        "does": "write the slot's family of candidates against the current brief and contract: family.options distinct candidates (one when the family offers one), differing on family.varyOn across family.values, each meeting contract.requirements and contract.fixture, each submitted through the candidates verb so its ledger holds a submit record",
        "decider": {
          "by": "agent",
          "agent": "publisher",
          "verb": "create-candidates",
          "tier": "mid",
          "skill": "packages/publisher/actions/publisher.candidates/skill.md"
        },
        "cli": "clossys next <ref> --submit <file>",
        "reads": [
          "<slot>/slot.json",
          "<inputs>",
          "designer/*/pin.json",
          "writer/*/pin.json"
        ],
        "writes": [
          "<slot>/candidates/*",
          "<slot>/ledger.json"
        ],
        "checks": []
      },
      {
        "id": "certify",
        "does": "certify every candidate (schema, contract fixture, the kind certifier, the standard's and the contract's requirements) and count the submitted, certified ones against family.options",
        "decider": {
          "by": "code"
        },
        "cli": "clossys options <ref> --check",
        "reads": [
          "<slot>/slot.json",
          "<slot>/candidates/*",
          "<slot>/ledger.json"
        ],
        "writes": [
          ".clossys/checks/<agent>/<slot-id>/*"
        ],
        "checks": [
          "<slot standard>",
          "candidates.certified"
        ],
        "onFail": {
          "raise": "queue.fix",
          "then": "retry"
        }
      }
    ],
    "exit": "the slot holds family.options (else one) candidates that are submitted through the candidates verb and certified; loop.choose pins one",
    "repeat": "per slot; a failed certification raises queue.fix and creates again, up to maxRounds",
    "maxRounds": 3
  }
}
