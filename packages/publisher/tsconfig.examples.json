{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "paths": {
      "@clossys/publisher/assessment": [
        "./src/verified-publication-rate.ts"
      ],
      "@clossys/publisher/core": [
        "./src/core/index.ts"
      ],
      "@clossys/publisher/document": [
        "./src/document/index.ts"
      ],
      "@clossys/publisher/pack": [
        "./src/pack/index.ts"
      ],
      "@clossys/publisher/record": [
        "./src/record/index.ts"
      ],
      "@clossys/publisher/testing": [
        "./src/testing/index.ts"
      ],
      "@clossys/publisher/web": [
        "./src/web/index.ts"
      ],
      "@clossys/publisher/web/client": [
        "./src/web/client.ts"
      ],
      "@clossys/publisher/web/consent": [
        "./src/web/consent/index.ts"
      ]
    }
  },
  "include": [
    "examples/**/*"
  ],
  "exclude": []
}
