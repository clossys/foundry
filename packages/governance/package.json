{
  "name": "@vespeneventures/governance",
  "version": "0.15.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog/index.d.ts",
      "import": "./dist/catalog/index.js"
    },
    "./gates": {
      "types": "./dist/gates/index.d.ts",
      "import": "./dist/gates/index.js"
    },
    "./release": {
      "types": "./dist/release/index.d.ts",
      "import": "./dist/release/index.js"
    },
    "./repository": {
      "types": "./dist/repository/index.d.ts",
      "import": "./dist/repository/index.js"
    },
    "./review": {
      "types": "./dist/review/index.d.ts",
      "import": "./dist/review/index.js"
    },
    "./review/github": {
      "types": "./dist/review/github.d.ts",
      "import": "./dist/review/github.js"
    },
    "./artifacts": {
      "types": "./dist/artifacts/index.d.ts",
      "import": "./dist/artifacts/index.js"
    },
    "./cleanup": {
      "types": "./dist/cleanup/index.d.ts",
      "import": "./dist/cleanup/index.js"
    },
    "./composition": {
      "types": "./dist/composition/index.d.ts",
      "import": "./dist/composition/index.js"
    }
  },
  "bin": {
    "foundry-governance": "./dist/cli.js",
    "foundry-check": "./dist/gates/cli.js",
    "repository-check": "./dist/repository/bin.js",
    "review-check": "./dist/review/cli.js"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "description": "Deprecated compatibility entry point for @vespeneventures/controller. Its ./catalog, ./gates, ./release, ./repository, ./review, ./artifacts, ./cleanup, and ./composition subpaths, and its foundry-governance/foundry-check/repository-check/review-check commands, all forward to the matching @vespeneventures/controller subpath.",
  "keywords": [
    "governance",
    "package-lifecycle",
    "deprecation",
    "package-scaffold",
    "catalog",
    "release",
    "review",
    "typescript"
  ],
  "author": "Calvin Hung",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vespeneventures/foundry.git",
    "directory": "packages/governance"
  },
  "bugs": {
    "url": "https://github.com/vespeneventures/foundry/issues"
  },
  "homepage": "https://github.com/vespeneventures/foundry/tree/main/packages/governance#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@vespeneventures/controller": "^0.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "~6.0.0",
    "vitest": "^4.1.9"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
