{
  "name": "@clossys/builder",
  "version": "0.7.4",
  "private": false,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./deployment": {
      "types": "./dist/deployment/index.d.ts",
      "import": "./dist/deployment/index.js"
    },
    "./deployment/vercel": {
      "types": "./dist/deployment/vercel/index.d.ts",
      "import": "./dist/deployment/vercel/index.js"
    },
    "./deployment/render": {
      "types": "./dist/deployment/render/index.d.ts",
      "import": "./dist/deployment/render/index.js"
    },
    "./ci": {
      "types": "./dist/ci/index.d.ts",
      "import": "./dist/ci/index.js"
    },
    "./machine": {
      "types": "./dist/machine/index.d.ts",
      "import": "./dist/machine/index.js"
    }
  },
  "bin": {
    "builder-verify-toolchain": "./dist/ci/bin.js",
    "builder-verify-machine": "./dist/machine/bin.js"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test-helper.ts",
    "documents",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "description": "Declared reality made actual: an idempotent manifest engine and machine verification, a deployment surface contract with read-only platform adapters, a toolchain pin (runtime, package manager, build order), the liveStateSurface contract and shared CI gate mechanics that reconcile any of them against what is actually live, and an observation-bundle transport for aggregating each repository's own self-reported gate results.",
  "keywords": [
    "provisioning",
    "deployment",
    "toolchain",
    "drift-detection",
    "ci-gate",
    "gate-result",
    "fail-closed",
    "observation-bundle",
    "aggregation",
    "typescript"
  ],
  "author": "Calvin Hung",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clossys/foundry.git",
    "directory": "packages/builder"
  },
  "bugs": {
    "url": "https://github.com/clossys/foundry/issues"
  },
  "homepage": "https://github.com/clossys/foundry/tree/main/packages/builder#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@clossys/controller": "~0.8.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "node ../../scripts/check-name-collision.mjs . && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "~6.0.0",
    "vitest": "^4.1.9"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
