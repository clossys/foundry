{
  "name": "@vespeneventures/gates",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "foundry-check": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "description": "The gates layer of a small foundation: orchestrates catalog and policy into single, useful operations — one-call validation, a deterministic topological build order over the real internal-dependency graph, and aggregated policy-binding verification. Pure orchestration, zero I/O of its own beyond what catalog already does.",
  "keywords": [
    "gates",
    "build-order",
    "topological-sort",
    "catalog",
    "policy",
    "typescript"
  ],
  "author": "Calvin Hung",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vespeneventures/foundry.git",
    "directory": "packages/gates"
  },
  "bugs": {
    "url": "https://github.com/vespeneventures/foundry/issues"
  },
  "homepage": "https://github.com/vespeneventures/foundry/tree/main/packages/gates#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@vespeneventures/catalog": "^0.1.0",
    "@vespeneventures/policy": "^0.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "~6.0.0",
    "vitest": "^4.1.9"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
