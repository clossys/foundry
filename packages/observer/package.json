{
  "name": "@clossys/observer",
  "version": "0.2.4",
  "private": false,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "observer-coverage-check": "./dist/bin.js"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "description": "Telemetry contracts, redaction as a tested contract, gate efficacy measured from caller-supplied run history, and a fleet package-coverage grader with a CLI. The measurer, never the measured: this package computes whether a gate is working and never judges a change itself. The library stays zero I/O, zero network calls; only the CLI touches a filesystem, and only through an injected port.",
  "keywords": [
    "telemetry",
    "observability",
    "redaction",
    "gate-efficacy",
    "escape-rate",
    "fleet-coverage",
    "audit",
    "typescript"
  ],
  "author": "Calvin Hung",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clossys/foundry.git",
    "directory": "packages/observer"
  },
  "bugs": {
    "url": "https://github.com/clossys/foundry/issues"
  },
  "homepage": "https://github.com/clossys/foundry/tree/main/packages/observer#readme",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "node ../../scripts/check-name-collision.mjs . && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "~6.0.0",
    "vitest": "^4.1.9"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
