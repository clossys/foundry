{
  "name": "@vespeneventures/surface",
  "version": "0.6.2",
  "private": false,
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "description": "Surface composition, media registries, channel renderers for web, email, print, images, and slides, and a structured-document contract.",
  "keywords": ["surface", "composition", "render", "web", "email", "print", "image", "slides", "typescript"],
  "author": "Calvin Hung",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vespeneventures/foundry.git",
    "directory": "packages/surface"
  },
  "bugs": { "url": "https://github.com/vespeneventures/foundry/issues" },
  "homepage": "https://github.com/vespeneventures/foundry/tree/main/packages/surface#readme",
  "engines": { "node": ">=20" },
  "exports": {
    "./core": { "types": "./dist/core/index.d.ts", "import": "./dist/core/index.js" },
    "./media": { "types": "./dist/media/index.d.ts", "import": "./dist/media/index.js" },
    "./web": { "types": "./dist/web/index.d.ts", "import": "./dist/web/index.js" },
    "./document": { "types": "./dist/document/index.d.ts", "import": "./dist/document/index.js" },
    "./email": { "types": "./dist/email/index.d.ts", "import": "./dist/email/index.js" },
    "./print": { "types": "./dist/print/index.d.ts", "import": "./dist/print/index.js" },
    "./image": { "types": "./dist/image/index.d.ts", "import": "./dist/image/index.js" },
    "./slides": { "types": "./dist/slides/index.d.ts", "import": "./dist/slides/index.js" }
  },
  "bin": { "surface-media-check": "./dist/media/cli.js" },
  "files": ["dist", "src", "!src/**/*.test.ts", "!src/**/*.test.tsx", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@vespeneventures/copy": "~0.7.0",
    "@vespeneventures/ui": "~0.13.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "jsdom": "^26.1.0",
    "typescript": "~6.0.0",
    "vitest": "^4.1.9"
  },
  "publishConfig": { "registry": "https://npm.pkg.github.com" }
}
