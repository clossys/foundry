{
  "name": "@vespeneventures/comms",
  "version": "0.3.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./resend": {
      "types": "./dist/resend/index.d.ts",
      "import": "./dist/resend/index.js"
    },
    "./inbound": {
      "types": "./dist/inbound/index.d.ts",
      "import": "./dist/inbound/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "description": "Finished communication contracts, retry-safe dispatch, durable delivery events, and a Resend adapter subpath.",
  "keywords": [
    "communications",
    "email",
    "notifications",
    "delivery",
    "typescript"
  ],
  "author": "Calvin Hung",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vespeneventures/foundry.git",
    "directory": "packages/comms"
  },
  "bugs": {
    "url": "https://github.com/vespeneventures/foundry/issues"
  },
  "homepage": "https://github.com/vespeneventures/foundry/tree/main/packages/comms#readme",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "resend": "^6.19.0",
    "typescript": "~6.0.0",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "resend": "^6.19.0"
  },
  "peerDependenciesMeta": {
    "resend": { "optional": true }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
