{
  "name": "@vespeneventures/deployment",
  "version": "0.2.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vercel": {
      "types": "./dist/vercel/index.d.ts",
      "import": "./dist/vercel/index.js"
    },
    "./render": {
      "types": "./dist/render/index.d.ts",
      "import": "./dist/render/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "description": "Dependency-free deployment surface contracts, configuration planning, health evaluation, and read-only Vercel and Render adapters.",
  "keywords": [
    "deployment",
    "health",
    "vercel",
    "render",
    "typescript"
  ],
  "author": "Vespene Ventures",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vespeneventures/foundry.git",
    "directory": "packages/deployment"
  },
  "bugs": {
    "url": "https://github.com/vespeneventures/foundry/issues"
  },
  "homepage": "https://github.com/vespeneventures/foundry/tree/main/packages/deployment#readme",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "~6.0.0",
    "vitest": "^4.1.9"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
