{
  "name": "@vespeneventures/ledger",
  "version": "0.4.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "ledger-check": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "description": "The return path: an append-only record of what was published, to which channel, when, derived from which revision of strategy, citing which facts \u2014 and a drift checker that answers whether a cited fact still holds, without ever importing @vespeneventures/strategy. Records outcomes and makes them attributable; carries no opinion about whether an outcome is good and writes nothing back automatically.",
  "keywords": [
    "ledger",
    "append-only",
    "attribution",
    "drift",
    "content-addressed",
    "typescript"
  ],
  "author": "Calvin Hung",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vespeneventures/foundry.git",
    "directory": "packages/ledger"
  },
  "bugs": {
    "url": "https://github.com/vespeneventures/foundry/issues"
  },
  "homepage": "https://github.com/vespeneventures/foundry/tree/main/packages/ledger#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@vespeneventures/controller": "~0.7.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "node ../../scripts/check-name-collision.mjs . && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "~6.0.0",
    "vitest": "^4.1.9"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
