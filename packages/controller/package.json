{
  "name": "@clossys/controller",
  "version": "0.8.24",
  "private": false,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog/index.d.ts",
      "import": "./dist/catalog/index.js"
    },
    "./gates": {
      "types": "./dist/gates/index.d.ts",
      "import": "./dist/gates/index.js"
    },
    "./gates/secrets": {
      "types": "./dist/gates/secrets.d.ts",
      "import": "./dist/gates/secrets.js"
    },
    "./release": {
      "types": "./dist/release/index.d.ts",
      "import": "./dist/release/index.js"
    },
    "./repository": {
      "types": "./dist/repository/index.d.ts",
      "import": "./dist/repository/index.js"
    },
    "./contracts/repository-package-adoption-contract.json": "./contracts/repository-package-adoption-contract.json",
    "./contracts/repository-package-adoption.fixture.json": "./contracts/repository-package-adoption.fixture.json",
    "./review": {
      "types": "./dist/review/index.d.ts",
      "import": "./dist/review/index.js"
    },
    "./review/github": {
      "types": "./dist/review/github.d.ts",
      "import": "./dist/review/github.js"
    },
    "./artifacts": {
      "types": "./dist/artifacts/index.d.ts",
      "import": "./dist/artifacts/index.js"
    },
    "./cleanup": {
      "types": "./dist/cleanup/index.d.ts",
      "import": "./dist/cleanup/index.js"
    },
    "./composition": {
      "types": "./dist/composition/index.d.ts",
      "import": "./dist/composition/index.js"
    },
    "./conventions": {
      "types": "./dist/conventions/index.d.ts",
      "import": "./dist/conventions/index.js"
    },
    "./conventions/documents/*": "./conventions/documents/*",
    "./conventions/adapters/*": "./conventions/adapters/*",
    "./policy": {
      "types": "./dist/policy/index.d.ts",
      "import": "./dist/policy/index.js"
    },
    "./positions": {
      "types": "./dist/positions/index.d.ts",
      "import": "./dist/positions/index.js"
    },
    "./contracts/role-loop-archetypes.json": "./contracts/role-loop-archetypes.json",
    "./contracts/installed-position-contract.json": "./contracts/installed-position-contract.json",
    "./contracts/completion-evidence-contract.json": "./contracts/completion-evidence-contract.json"
  },
  "bin": {
    "foundry-governance": "./dist/cli.js",
    "foundry-check": "./dist/gates/cli.js",
    "repository-check": "./dist/repository/bin.js",
    "repository-profile-check": "./dist/repository/run-bin.js",
    "repository-package-adoption-check": "./dist/repository/adoption-bin.js",
    "review-check": "./dist/review/cli.js",
    "foundry-position-check": "./dist/positions/bin.js",
    "foundry-completion-evidence-check": "./dist/positions/completion-evidence-bin.js",
    "singular-authority-check": "./dist/release/singular-authority-bin.js"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "conventions",
    "contracts",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "foundry": {
    "singularAuthority": "controller"
  },
  "description": "Owns every rule: package lifecycle and process orchestration (catalog, composition, gates, release, repository-profile, review-evidence, workspace-cleanup), account-neutral agent conventions (branch provenance, skill naming, agent interoperability, routine and schedule declarations, CI gate naming, capability-first skill registry), and the zero-I/O content-addressed policy-binding primitive that binds a rule to a document without disclosing it.",
  "keywords": [
    "governance",
    "package-lifecycle",
    "deprecation",
    "package-scaffold",
    "catalog",
    "release",
    "review",
    "conventions",
    "policy",
    "digest",
    "content-addressed",
    "typescript"
  ],
  "author": "Calvin Hung",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clossys/foundry.git",
    "directory": "packages/controller"
  },
  "bugs": {
    "url": "https://github.com/clossys/foundry/issues"
  },
  "homepage": "https://github.com/clossys/foundry/tree/main/packages/controller#readme",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "node ../../scripts/check-name-collision.mjs . && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@clossys/advisor": "^0.1.2",
    "@types/node": "^22.10.0",
    "typescript": "~6.0.0",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "typescript": "~6.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
