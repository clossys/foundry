{
  "name": "@clossys/advisor",
  "version": "0.1.4",
  "private": false,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "advisor-check": "./dist/cli.js",
    "advisor-execution-readiness": "./dist/execution-readiness-cli.js"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "description": "Provider-neutral sponsor assessment, pre-work gating, and session contracts for Foundry engagements.",
  "keywords": [
    "advisory",
    "assessment",
    "readiness",
    "sponsor",
    "typescript"
  ],
  "author": "Calvin Hung",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clossys/platform.git",
    "directory": "packages/advisor"
  },
  "bugs": {
    "url": "https://github.com/clossys/platform/issues"
  },
  "homepage": "https://github.com/clossys/platform/tree/main/packages/advisor#readme",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "node ../../scripts/check-name-collision.mjs . && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "~6.0.0",
    "vitest": "^4.1.9"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
