{
  "id": "advisor/loop.update",
  "status": "draft",
  "extends": null,
  "content": {
    "trigger": ["T8"],
    "steps": [
      { "id": "doctor", "does": "check the machine prerequisites; read no file", "decider": { "by": "code" }, "cli": "advisor doctor", "reads": ["host:node", "host:npm", "host:git"], "writes": [], "checks": ["machine.tools.node", "machine.tools.npm", "machine.tools.git", "machine.repo.root"] },
      { "id": "update", "does": "install a newer pack; the same head and tree changes nothing and a lower version is refused", "decider": { "by": "code" }, "cli": "advisor update --from <pack-dir>", "reads": ["clossys/advisor/install.json", "<pack-dir>/artifacts.json"], "writes": ["vendor/clossys/", "clossys/advisor/install.json"], "checks": ["packages.record.update"] },
      { "id": "check", "does": "let Producer check the workspace against the new packages; a failure is a queue.fix entry for Producer's audit loop", "decider": { "by": "code" }, "cli": "clossys check", "reads": ["clossys/"], "writes": [], "checks": [], "onFail": { "raise": "queue.fix", "then": "loop.audit" } }
    ],
    "exit": "every step exits 0, or the check failure is raised as queue.fix for loop.audit",
    "repeat": "on each new pack (T8)",
    "maxRounds": 1
  }
}
