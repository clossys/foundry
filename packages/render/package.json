{
  "name": "@vespeneventures/render",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "description": "Renderers built against @vespeneventures/compose's ComposeDocument contract, one subpath per output channel. Ships ./web first: resolves a web ComposeDocument's bindings into the named @vespeneventures/ui view and emits framework-agnostic head metadata (title, description, OpenGraph, Twitter card, XSS-escaped JSON-LD). No root '.' export — every import names its channel, the same convention @vespeneventures/ui's subpaths already set.",
  "keywords": [
    "render",
    "compose",
    "web",
    "seo",
    "json-ld",
    "typescript"
  ],
  "author": "Calvin Hung",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vespeneventures/foundry.git",
    "directory": "packages/render"
  },
  "bugs": {
    "url": "https://github.com/vespeneventures/foundry/issues"
  },
  "homepage": "https://github.com/vespeneventures/foundry/tree/main/packages/render#readme",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    "./web": {
      "types": "./dist/web/index.d.ts",
      "import": "./dist/web/index.js"
    },
    "./email": {
      "types": "./dist/email/index.d.ts",
      "import": "./dist/email/index.js"
    },
    "./print": {
      "types": "./dist/print/index.d.ts",
      "import": "./dist/print/index.js"
    },
    "./image": {
      "types": "./dist/image/index.d.ts",
      "import": "./dist/image/index.js"
    },
    "./slides": {
      "types": "./dist/slides/index.d.ts",
      "import": "./dist/slides/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@vespeneventures/compose": "~0.2.0",
    "@vespeneventures/tokens": "~0.6.0"
  },
  "peerDependencies": {
    "@vespeneventures/ui": "^0.4.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "@vespeneventures/ui": { "optional": true },
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vespeneventures/ui": "~0.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~6.0.0",
    "vitest": "^4.1.9"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
