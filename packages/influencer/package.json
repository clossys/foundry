{
  "name": "@clossys/influencer",
  "version": "0.1.6",
  "private": false,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "influencer-check": "dist/cli.js",
    "influencer-rate-check": "dist/qualified-response-yield-cli.js"
  },
  "foundry": {
    "assessment": {
      "bin": "influencer-rate-check",
      "invocation": "single-json-input"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "skill"
  ],
  "sideEffects": false,
  "description": "The influencer role: operate a declared organizational presence and improve independently verified qualified audience response yield through bounded outbound experiments.",
  "keywords": [
    "outbound",
    "presence",
    "audience",
    "experiments",
    "typescript"
  ],
  "author": "Clossys",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clossys/foundry.git",
    "directory": "packages/influencer"
  },
  "bugs": {
    "url": "https://github.com/clossys/foundry/issues"
  },
  "homepage": "https://github.com/clossys/foundry/tree/main/packages/influencer#readme",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "node ../../scripts/check-name-collision.mjs . && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "typescript": "~6.0.0",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
