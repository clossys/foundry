{
  "schema": "clossys.standard/1",
  "id": "narrative",
  "kinds": [
    "strings/narrative"
  ],
  "mode": "craft",
  "craftTier": "mid",
  "seeds": [],
  "createOnly": true,
  "createOnlyReason": "Narratives tell the consumer own story in its pinned voice from upstream briefs; this craft standard has no seed registry, so every narrative without a package default is created.",
  "requirements": [
    {
      "check": "copy.voice-derived",
      "params": {}
    },
    {
      "check": "copy.derived-upstream",
      "params": {}
    },
    {
      "check": "copy.entries",
      "params": {}
    },
    {
      "check": "narrative.sequence",
      "params": {}
    }
  ],
  "preview": {
    "card": {
      "method": "inline",
      "intrinsicWidth": null,
      "mustContain": [
        "[data-narrative-title]",
        "ol[data-narrative-outline] > li"
      ],
      "states": [
        "loading",
        "not-needed",
        "no-preview",
        "failed",
        "not-pinned"
      ]
    }
  }
}
