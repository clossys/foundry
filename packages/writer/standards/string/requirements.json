{
  "schema": "clossys.standard/1",
  "id": "string",
  "kinds": [
    "strings/string"
  ],
  "mode": "craft",
  "craftTier": "mid",
  "seeds": [],
  "requirements": [
    {
      "check": "copy.voice-derived",
      "params": {}
    },
    {
      "check": "copy.derived-upstream",
      "params": {}
    },
    {
      "check": "copy.entries",
      "params": {}
    },
    {
      "check": "copy.plain-values",
      "params": {
        "icu": true
      }
    },
    {
      "check": "text.no-placeholder",
      "params": {}
    },
    {
      "check": "lexicon.clean",
      "params": {
        "avoid": [
          "seamless",
          "seamlessly",
          "best-in-class",
          "best in class",
          "magic",
          "magical",
          "effortless",
          "effortlessly",
          "solutions",
          "solution"
        ]
      }
    },
    {
      "check": "copy.within-limits",
      "params": {
        "contract": "$contract"
      }
    }
  ],
  "preview": {
    "card": {
      "method": "inline",
      "intrinsicWidth": null,
      "mustContain": [
        "[data-copy-row]"
      ],
      "states": [
        "loading",
        "not-needed",
        "no-preview",
        "failed",
        "not-pinned"
      ]
    }
  }
}
