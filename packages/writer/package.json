{
  "name": "@vespeneventures/writer",
  "version": "0.3.1",
  "private": false,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./voice": {
      "types": "./dist/voice/index.d.ts",
      "import": "./dist/voice/index.js"
    },
    "./voice-record.template.jsonc": "./templates/voice-record.template.jsonc"
  },
  "bin": {
    "writer-check": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "templates",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "description": "The writer role: is it well said? A consumer-owned language system: voice rules, glossary and claims validation, addressable copy records, source traceability, locale coverage, and passage-layer composition — five gates reachable from one bin. Ships machinery and templates, never a consumer's actual copy or voice.",
  "keywords": [
    "writer",
    "copy",
    "content",
    "voice",
    "i18n",
    "content-checker",
    "typescript"
  ],
  "author": "Calvin Hung",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vespeneventures/foundry.git",
    "directory": "packages/writer"
  },
  "bugs": {
    "url": "https://github.com/vespeneventures/foundry/issues"
  },
  "homepage": "https://github.com/vespeneventures/foundry/tree/main/packages/writer#readme",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "node ../../scripts/check-name-collision.mjs . && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "~6.0.0",
    "vitest": "^4.1.9"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
