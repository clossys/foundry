{
  "version": 1,
  "revision": 1,
  "state": "draft",
  "locale": "en",
  "terms": [
    {
      "concept": "Registered catalog leaf",
      "preferred": "Item",
      "avoid": [
        "leaf"
      ],
      "note": "Permanent technical IDs stay in data; show a supplied human name in the console."
    },
    {
      "concept": "Selectable implementation or candidate",
      "preferred": "Version",
      "avoid": [
        "fill",
        "candidate"
      ],
      "note": "Keep a source version distinct from an immutable revision; do not imply approval."
    },
    {
      "concept": "Governing specification",
      "preferred": "Requirements",
      "avoid": [
        "contract"
      ],
      "note": "Requirements describes what the item must satisfy."
    },
    {
      "concept": "Selectable configuration member",
      "preferred": "Option",
      "avoid": [
        "member"
      ],
      "note": "Configuration remains available for an actual group of options."
    },
    {
      "concept": "Visual example",
      "preferred": "Preview",
      "avoid": [
        "specimen"
      ],
      "note": "An available preview is not verification or publication."
    },
    {
      "concept": "User-owned content collection",
      "preferred": "Library",
      "avoid": [
        "consumer library"
      ],
      "note": "Do not expose ownership qualifiers used only by the package model."
    },
    {
      "concept": "Incoming usage",
      "preferred": "Used by",
      "avoid": [
        "used where"
      ],
      "note": "Names the items that use the selected item."
    },
    {
      "concept": "Outgoing usage",
      "preferred": "Uses",
      "avoid": [
        "reads",
        "dependencies"
      ],
      "note": "Use Contains for composition and Hosts for the distinct hosting relationship."
    },
    {
      "concept": "Check problems",
      "preferred": "Issues",
      "avoid": [
        "findings"
      ],
      "note": "Error and warning retain their specific severities; notice remains informational."
    },
    {
      "concept": "Visual or publishing verification",
      "preferred": "Checks",
      "avoid": [
        "runtime evidence",
        "production evidence"
      ],
      "note": "Live observation names evidence origin and does not mean the checks passed."
    },
    {
      "concept": "Source package revision",
      "preferred": "Source version",
      "avoid": [
        "pin"
      ],
      "note": "Do not display raw package pin JSON."
    },
    {
      "concept": "Appearance preference",
      "preferred": "Theme",
      "avoid": [
        "appearance"
      ],
      "note": "Keep System, Light and Dark as the three preference labels."
    },
    {
      "concept": "Page-side tools",
      "preferred": "Page tools",
      "avoid": [
        "page modules"
      ],
      "note": "Use Show/Hide for visibility and Resize for the handle."
    },
    {
      "concept": "Planning action",
      "preferred": "Apply plan",
      "avoid": [
        "align plan"
      ],
      "note": "Applying a plan never grants owner approval or publishing clearance."
    },
    {
      "concept": "Origin of an item",
      "preferred": "Source history",
      "avoid": [
        "provenance"
      ],
      "note": "Keep origin separate from verification status."
    },
    {
      "concept": "Agreement between design choices",
      "preferred": "Consistency",
      "avoid": [
        "coherence"
      ],
      "note": "Use one plain name for this check category."
    }
  ],
  "budgets": {
    "button": 24,
    "label": 40,
    "heading": 60,
    "navigation": 40,
    "accessible-label": 60,
    "status": 80,
    "announcement": 80,
    "counter": 60,
    "help": 160,
    "instruction": 120,
    "empty": 120,
    "empty-title": 60,
    "empty-body": 160,
    "error": 160
  },
  "voice": {
    "case": "sentence case",
    "verbs": "plain, direct actions",
    "errors": "what happened, then a supported next step",
    "approval": "Drafts never approve, activate or publish copy."
  },
