            "maxWords": 28
          },
          "undo": {
            "required": false,
            "maxChars": 80,
            "maxWords": 12,
            "maxLines": 1
          }
        }
      },
      "references": [
        {
          "id": "patterns.confirmation.guide",
          "kind": "guide",
          "guide": "Past tense, one line, and undo when the action can be reversed.",
          "exemplars": [
            {
              "fields": {
                "what-happened": "Shift moved to Thursday.",
                "undo": "Undo"
              }
            },
            {
              "fields": {
                "what-happened": "The weekly rota was sent to 18 people."
              }
            }
          ]
        }
      ],
      "checkSuiteId": "writer.copy.v1",
      "specimenKind": "text"
    },
