    {
      "id": "patterns.form-field",
      "package": "writer",
      "layer": "patterns",
      "purpose": "A complete form field: label, help, error and placeholder.",
      "inputs": [
        "director:identity.verbal.voice"
      ],
      "limits": {
        "translationHeadroom": 0.3,
        "unique": false,
        "claims": true,
        "fields": {
