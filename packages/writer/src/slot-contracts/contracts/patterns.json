{
  "schemaVersion": 1,
  "package": "@clossys/writer",
  "layer": "patterns",
  "checkSuiteId": "writer.copy.v1",
  "slots": [
    {
      "id": "patterns.headline",
      "package": "writer",
      "layer": "patterns",
      "purpose": "A single headline that states the main point of a page or section.",
      "inputs": [
        "director:advantage.proposition.promise",
        "director:identity.verbal.voice"
      ],
      "limits": {
        "translationHeadroom": 0.3,
        "unique": true,
        "claims": true,
        "fields": {
          "headline": {
            "required": true,
            "maxChars": 100,
            "maxWords": 18,
            "minWords": 2,
            "maxLines": 2
          }
        }
      },
      "references": [
        {
          "id": "patterns.headline.guide",
          "kind": "guide",
          "guide": "Lead with the outcome for the reader, in their words; one idea, no stacked clauses.",
          "exemplars": [
            {
              "fields": {
                "headline": "Rotas that fill themselves when plans change"
              }
            },
            {
              "fields": {
                "headline": "Close every booking before the patient leaves"
              }
            },
            {
              "fields": {
                "headline": "Know who is on shift without asking the group chat"
              }
            }
          ]
        }
      ],
      "checkSuiteId": "writer.copy.v1",
      "specimenKind": "text"
    },
    {
      "id": "patterns.headline-subhead",
      "package": "writer",
      "layer": "patterns",
      "purpose": "A headline with a supporting line that explains how or for whom.",
      "inputs": [
        "director:advantage.proposition.promise",
        "director:focus.segment.core",
        "director:identity.verbal.voice"
      ],
      "limits": {
        "translationHeadroom": 0.3,
        "unique": true,
        "claims": true,
        "fields": {
          "headline": {
            "required": true,
            "maxChars": 100,
            "maxWords": 18,
            "minWords": 2,
            "maxLines": 2
          },
          "subhead": {
            "required": true,
            "maxChars": 180,
            "maxWords": 32,
            "maxLines": 3
          }
        }
      },
      "references": [
        {
          "id": "patterns.headline-subhead.guide",
          "kind": "guide",
          "guide": "The headline makes the promise; the subhead says how it works or who it is for, without repeating words.",
          "exemplars": [
            {
              "fields": {
                "headline": "Shift swaps in two taps",
                "subhead": "Staff offer a shift, a qualified colleague accepts it, and the manager approves it from their phone."
              }
            },
            {
              "fields": {
                "headline": "One diary for the whole clinic",
                "subhead": "Front desk and practitioners see the same bookings, with notes attached to each one."
              }
            }
          ]
        }
      ],
      "checkSuiteId": "writer.copy.v1",
      "specimenKind": "text"
    },
    {
      "id": "patterns.eyebrow-headline",
      "package": "writer",
      "layer": "patterns",
      "purpose": "A short category label above a headline.",
      "inputs": [
        "director:advantage.proposition.promise",
        "director:identity.verbal.voice"
      ],
      "limits": {
        "translationHeadroom": 0.3,
        "unique": true,
        "claims": true,
        "fields": {
          "eyebrow": {
            "required": true,
            "maxChars": 48,
            "maxWords": 6,
            "maxLines": 1
          },
          "headline": {
            "required": true,
            "maxChars": 100,
            "maxWords": 18,
            "maxLines": 2
          }
        }
      },
      "references": [
        {
          "id": "patterns.eyebrow-headline.guide",
          "kind": "guide",
          "guide": "The eyebrow names the topic or audience in a few words; the headline carries the point.",
          "exemplars": [
            {
              "fields": {
                "eyebrow": "For small bakeries",
                "headline": "Plan the early shift the night before"
              }
            },
            {
              "fields": {
                "eyebrow": "Reporting",
                "headline": "See every overtime hour before payroll closes"
              }
            }
          ]
        }
      ],
      "checkSuiteId": "writer.copy.v1",
      "specimenKind": "text"
    },
    {
      "id": "patterns.section-title",
      "package": "writer",
      "layer": "patterns",
      "purpose": "A section title with an optional one-line description.",
      "inputs": [
        "director:identity.verbal.voice"
      ],
      "limits": {
        "translationHeadroom": 0.3,
        "unique": true,
        "claims": true,
        "fields": {
          "title": {
            "required": true,
            "maxChars": 100,
            "maxWords": 18,
            "maxLines": 2
          },
          "description": {
            "required": false,
            "maxChars": 240,
            "maxWords": 45
          }
        }
      },
      "references": [
        {
          "id": "patterns.section-title.guide",
          "kind": "guide",
          "guide": "Name what the section contains; the description adds why it matters.",
          "exemplars": [
            {
              "fields": {
                "title": "What changes on day one",
                "description": "Three things your team will notice in the first week."
              }
            },
            {
              "fields": {
                "title": "Questions from managers",
                "description": "Answers to what people ask before they switch."
              }
            }
          ]
        }
      ],
      "checkSuiteId": "writer.copy.v1",
      "specimenKind": "text"
    },
    {
      "id": "patterns.primary-action",
      "package": "writer",
      "layer": "patterns",
      "purpose": "The main call to action, written as a verb and an object.",
      "inputs": [
        "director:focus.lifecycle.acquisition",
        "director:identity.verbal.voice"
      ],
      "limits": {
        "translationHeadroom": 0.3,
        "unique": false,
        "claims": true,
        "fields": {
          "verb": {
            "required": true,
            "maxChars": 24,
            "maxWords": 3,
            "maxLines": 1
          },
          "object": {
            "required": true,
            "maxChars": 48,
            "maxWords": 6,
            "maxLines": 1
          }
        }
      },
      "references": [
        {
          "id": "patterns.primary-action.guide",
          "kind": "guide",
          "guide": "Use a specific verb and the thing the reader gets; avoid Submit and Click here.",
          "exemplars": [
            {
              "fields": {
                "verb": "Start",
                "object": "free trial"
              }
            },
            {
              "fields": {
                "verb": "Book",
                "object": "a 20-minute demo"
              }
            }
          ]
        }
      ],
      "checkSuiteId": "writer.copy.v1",
      "specimenKind": "text"
    },
    {
      "id": "patterns.secondary-action",
      "package": "writer",
      "layer": "patterns",
      "purpose": "A lower-commitment alternative to the primary action.",
      "inputs": [
        "director:focus.lifecycle.acquisition",
        "director:identity.verbal.voice"
      ],
      "limits": {
        "translationHeadroom": 0.3,
        "unique": false,
        "claims": true,
        "fields": {
          "verb": {
            "required": true,
            "maxChars": 24,
            "maxWords": 3,
            "maxLines": 1
          },
          "object": {
            "required": true,
            "maxChars": 48,
            "maxWords": 6,
            "maxLines": 1
          }
        }
      },
      "references": [
        {
          "id": "patterns.secondary-action.guide",
          "kind": "guide",
          "guide": "Offer a smaller step, such as seeing more, rather than a competing goal.",
          "exemplars": [
            {
              "fields": {
                "verb": "See",
                "object": "pricing"
              }
            },
            {
              "fields": {
                "verb": "Watch",
                "object": "the 2-minute tour"
              }
            }
          ]
        }
      ],
      "checkSuiteId": "writer.copy.v1",
      "specimenKind": "text"
    },
    {
      "id": "patterns.inline-link",
      "package": "writer",
      "layer": "patterns",
      "purpose": "Link text inside a sentence, with an optional accessible name.",
      "inputs": [
        "director:identity.verbal.voice"
      ],
      "limits": {
        "translationHeadroom": 0.3,
        "unique": false,
        "claims": true,
        "fields": {
          "label": {
            "required": true,
            "maxChars": 80,
            "maxWords": 12,
            "maxLines": 1
          },
          "accessible-name": {
            "required": false,
            "maxChars": 160,
            "maxWords": 24
          }
        }
      },
      "references": [
        {
          "id": "patterns.inline-link.guide",
          "kind": "guide",
          "guide": "The label names the destination; add an accessible name when the label alone is ambiguous.",
          "exemplars": [
            {
              "fields": {
                "label": "read the setup guide",
                "accessible-name": "Read the setup guide for shift templates"
              }
            },
            {
              "fields": {
                "label": "compare plans"
              }
            }
          ]
        }
      ],
      "checkSuiteId": "writer.copy.v1",
      "specimenKind": "text"
    },
    {
      "id": "patterns.error-message",
      "package": "writer",
      "layer": "patterns",
      "purpose": "An error message in three parts: what happened, why, and what to do next.",
      "inputs": [
        "director:identity.brand.personality",
        "director:identity.verbal.voice"
      ],
      "limits": {
        "translationHeadroom": 0.3,
        "unique": false,
        "claims": true,
        "fields": {
          "what": {
            "required": true,
            "maxChars": 160,
            "maxWords": 28,
            "minWords": 2
          },
          "why": {
            "required": true,
            "maxChars": 240,
            "maxWords": 45
          },
          "next": {
            "required": true,
            "maxChars": 160,
            "maxWords": 28
          }
        }
      },
      "references": [
        {
          "id": "patterns.error-message.guide",
          "kind": "guide",
          "guide": "Be specific and calm; the next step must be something the reader can do now.",
          "exemplars": [
            {
              "fields": {
                "what": "We could not save the rota.",
                "why": "The connection dropped while the changes were uploading.",
                "next": "Check your connection and press Save again."
              }
            },
            {
              "fields": {
                "what": "This shift overlaps another one.",
                "why": "The same person is already booked from 09:00 to 13:00.",
                "next": "Pick a different person or change the times."
              }
            }
          ]
        }
      ],
      "checkSuiteId": "writer.copy.v1",
      "specimenKind": "text"
    },
    {
      "id": "patterns.warning-message",
      "package": "writer",
      "layer": "patterns",
      "purpose": "A warning that states what will happen and its consequence.",
      "inputs": [
        "director:identity.verbal.voice"
      ],
      "limits": {
        "translationHeadroom": 0.3,
        "unique": false,
        "claims": true,
        "fields": {
          "what": {
            "required": true,
            "maxChars": 160,
            "maxWords": 28
          },
          "consequence": {
            "required": true,
            "maxChars": 200,
            "maxWords": 35
          }
        }
      },
      "references": [
        {
          "id": "patterns.warning-message.guide",
          "kind": "guide",
          "guide": "Put the consequence in concrete terms, such as how many items are affected.",
          "exemplars": [
            {
              "fields": {
                "what": "You are about to remove this location.",
                "consequence": "Its 6 rotas and their history will be deleted for everyone."
              }
            },
            {
              "fields": {
                "what": "This change applies to next week too.",
                "consequence": "People who already accepted those shifts will be notified."
              }
            }
          ]
        }
      ],
      "checkSuiteId": "writer.copy.v1",
      "specimenKind": "text"
    },
    {
      "id": "patterns.confirmation",
      "package": "writer",
      "layer": "patterns",
      "purpose": "A confirmation that says what happened, with an optional undo.",
      "inputs": [
        "director:identity.verbal.voice"
      ],
      "limits": {
        "translationHeadroom": 0.3,
        "unique": false,
        "claims": true,
        "fields": {
