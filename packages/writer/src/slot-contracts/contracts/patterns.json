            "required": true,
            "maxChars": 80,
            "maxWords": 12,
            "maxLines": 1
          },
          "help": {
            "required": false,
            "maxChars": 200,
            "maxWords": 35
          },
          "error": {
            "required": false,
            "maxChars": 240,
            "maxWords": 45
          },
          "placeholder": {
            "required": false,
            "maxChars": 80,
            "maxWords": 12,
            "maxLines": 1
          }
        }
      },
      "references": [
        {
          "id": "patterns.form-field.guide",
          "kind": "guide",
          "guide": "The label names the value, help prevents mistakes, the error explains the fix, the placeholder shows the format only.",
          "exemplars": [
            {
              "fields": {
                "label": "Team name",
                "help": "Shown to everyone you invite.",
                "error": "Enter a team name of 2 to 40 characters.",
                "placeholder": "Front of house"
              }
            },
            {
              "fields": {
                "label": "Phone number",
                "help": "Used only for shift reminders.",
                "error": "Enter the number with its country code, such as +44 7700 900123."
              }
            }
          ]
        }
      ],
      "checkSuiteId": "writer.copy.v1",
      "specimenKind": "text"
