        ],
        "countKey": "passages",
        "minCount": 1,
        "maxCount": 20
      },
      "references": [
        {
          "id": "narratives.screen.guide",
          "kind": "guide",
          "guide": "Header first, then the main task, then secondary panels; empty and error states are part of the screen.",
          "exemplars": [
            {
              "outline": [
                "page-header: Rotas",
                "resource-list: rotas by week",
                "empty-state: no rotas yet"
              ]
            },
            {
              "outline": [
                "page-header: Billing",
                "account-summary: plan and payment method",
                "usage: limits this month",
                "data-table: invoices"
              ]
            }
          ]
        }
      ],
      "checkSuiteId": "writer.copy.v1",
      "specimenKind": "text"
    },
