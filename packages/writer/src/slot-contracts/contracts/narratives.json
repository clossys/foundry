        "maxCount": 200
      },
      "references": [
        {
          "id": "narratives.release-notes.guide",
          "kind": "guide",
          "guide": "Lead with what the reader can now do; group by impact; name breaking changes plainly.",
          "exemplars": [
            {
              "outline": [
                "heading: November update",
                "list: new things you can do",
                "list: fixes",
                "callout: one change that needs action"
