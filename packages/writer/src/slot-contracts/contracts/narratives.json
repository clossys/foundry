{
  "schemaVersion": 1,
  "package": "@clossys/writer",
  "layer": "narratives",
  "checkSuiteId": "writer.copy.v1",
  "slots": [
    {
      "id": "narratives.page-story",
      "package": "writer",
      "layer": "narratives",
      "purpose": "The ordered story of a marketing or demo page, as a sequence of passages.",
      "inputs": [
        "director:advantage.proposition.promise",
        "director:advantage.proposition.proof",
        "director:focus.lifecycle.acquisition",
        "director:identity.verbal.narrative"
      ],
      "limits": {
        "translationHeadroom": 0.3,
        "unique": false,
        "claims": false,
        "fields": {},
        "shape": "page",
        "requiredProperties": [
          "frame",
          "passages"
        ],
        "countKey": "passages",
        "minCount": 3,
        "maxCount": 20
      },
      "references": [
        {
          "id": "narratives.page-story.guide",
          "kind": "guide",
          "guide": "Open with the promise, prove it, answer the main objection, then ask for one action; each passage earns its place.",
          "exemplars": [
            {
              "outline": [
                "hero: the promise for small teams",
                "features: three ways the rota fixes itself",
                "stats: pilot results with sources",
                "faq: switching questions",
                "call-to-action: start a trial"
              ]
            },
            {
              "outline": [
                "hero: one diary for the whole clinic",
                "steps: from paper book to shared diary",
                "testimonials: two front-desk quotes",
                "pricing: one plan per clinic",
                "call-to-action: book a demo"
              ]
            }
          ]
        }
      ],
      "checkSuiteId": "writer.copy.v1",
      "specimenKind": "text"
    },
    {
      "id": "narratives.screen",
      "package": "writer",
      "layer": "narratives",
      "purpose": "The ordered copy of one app or admin screen, as a sequence of passages.",
      "inputs": [
        "director:focus.offer.included",
