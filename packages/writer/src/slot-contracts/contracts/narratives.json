    {
      "id": "narratives.article",
      "package": "writer",
      "layer": "narratives",
      "purpose": "A long-form article: title, frame and ordered blocks.",
      "inputs": [
        "director:identity.verbal.narrative",
        "director:identity.verbal.voice"
      ],
      "limits": {
        "translationHeadroom": 0.3,
        "unique": false,
        "claims": false,
        "fields": {},
        "shape": "long-form",
        "requiredProperties": [
          "title",
          "frame",
          "blocks"
        ],
        "countKey": "blocks",
        "minCount": 1,
        "maxCount": 200
      },
      "references": [
        {
          "id": "narratives.article.guide",
          "kind": "guide",
          "guide": "Headline the answer, open with the reader's problem, one idea per section, end with a next step.",
          "exemplars": [
            {
              "outline": [
                "heading: how to plan around school holidays",
                "paragraph: the problem in one sentence",
                "list: four planning steps",
                "callout: what to do when cover falls through",
                "paragraph: next step"
              ]
            },
            {
              "outline": [
                "heading: why swaps need approval",
                "paragraph: what goes wrong without it",
                "quote: a manager's experience",
                "paragraph: how approval works"
              ]
            }
          ]
        }
      ],
      "checkSuiteId": "writer.copy.v1",
      "specimenKind": "text"
    },
    {
      "id": "narratives.guide",
      "package": "writer",
      "layer": "narratives",
      "purpose": "A how-to guide with ordered, checkable steps.",
      "inputs": [
        "director:focus.offer.included",
        "director:identity.verbal.voice"
      ],
      "limits": {
        "translationHeadroom": 0.3,
