        "requiredProperties": [
          "title",
          "frame",
          "blocks"
        ],
        "countKey": "blocks",
        "minCount": 1,
        "maxCount": 200
      },
      "references": [
        {
          "id": "narratives.guide.guide",
          "kind": "guide",
          "guide": "State the outcome and prerequisites first; each step is one action and its visible result.",
          "exemplars": [
            {
              "outline": [
                "heading: import staff from a spreadsheet",
                "paragraph: what you need first",
                "list: five steps with results",
                "callout: common import errors"
              ]
            },
            {
              "outline": [
                "heading: set up shift swaps",
                "list: three steps",
                "figure: the approval screen",
                "paragraph: what staff see"
              ]
            }
          ]
        }
      ],
      "checkSuiteId": "writer.copy.v1",
      "specimenKind": "text"
