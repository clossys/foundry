{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clossys.facts/1",
  "title": "Owner facts",
  "description": "Workspace-root clossys/facts.json: owner fact records that Prose pieces cite ({fact:<id>}, refs to: facts with key). Values are set by the owner, never invented by an agent; a Prose package default fails facts.owner until the facts it cites exist (writer.md 2 Prose, N7).",
  "type": "object",
  "required": ["schema", "id", "status", "createdBy", "createdAt", "facts"],
  "properties": {
    "schema": { "const": "clossys.facts/1" },
    "id": { "const": "facts" },
    "status": { "enum": ["draft", "live"] },
    "createdBy": {
      "type": "object",
      "required": ["actor", "ref"],
      "properties": { "actor": { "const": "owner" }, "ref": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    },
    "createdAt": { "$ref": "#/$defs/iso" },
    "updatedAt": { "$ref": "#/$defs/iso" },
    "facts": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)*$" },
      "additionalProperties": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          { "type": "number" },
          { "type": "boolean" },
          { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        ]
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "iso": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" }
  }
}
