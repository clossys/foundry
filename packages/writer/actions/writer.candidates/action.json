{
  "schema": "clossys.action/1",
  "id": "writer.candidates",
  "agent": "writer",
  "kind": "decide:creative",
  "stage": "design.make",
  "summary": "Create Writer candidates: one immutable file per option, per L3 slot.",
  "run": "clossys next writer/<slot> --submit <file> --model <model> --tier <tier> --basis <basis> --skill <file> --rung <rung> [--seed <id>] [--reason <text>]",
  "inputs": [
    {
      "glob": "clossys/agents/director/*/pin.json",
      "schema": "pin"
    },
    {
      "glob": "clossys/agents/director/*/candidates/*",
      "schema": "candidate-brief"
    },
    {
      "glob": "clossys/agents/designer/*/candidates/*",
      "schema": "candidate-element"
    },
    {
      "glob": "clossys/agents/writer/*/slot.json",
      "schema": "slot"
    }
  ],
  "outputs": [
    {
      "glob": "clossys/agents/writer/*/candidates/*",
      "schema": "candidate-strings"
    }
  ],
  "pass": {
    "command": "clossys check",
    "exit": {
      "pass": [
        0
      ],
      "fail": [
        1
      ],
      "error": [
        2
      ]
    }
  },
  "record": "clossys.pipeline-run/1",
  "checks": [
    "workspace"
  ],
  "uses": [
    "skill/SKILL.md"
  ],
  "decider": "agent",
  "packet": {
    "inputs": [
      "clossys/agents/director/*/pin.json",
      "clossys/agents/director/*/candidates/*",
      "clossys/agents/designer/*/candidates/*",
      "clossys/agents/writer/*/slot.json"
    ],
    "write": [
      {
        "glob": "clossys/agents/writer/*/candidates/*",
        "schema": "candidate-strings"
      }
    ],
    "checks": [
      "workspace"
    ]
  },
  "skill": "skill.md",
  "open": "slots-without-candidates:writer"
}
