{
  "schema": "clossys.action/1",
  "id": "build.receipt",
  "agent": "producer",
  "kind": "plumb",
  "stage": "publish.check",
  "summary": "Record the page-check source receipt in the build output.",
  "run": "clossys pipeline trace build.receipt -- node scripts/generate-page-check-receipt.mjs",
  "inputs": [
    {
      "glob": "clossys/agents/*/ia.json",
      "schema": "ia"
    },
    {
      "glob": "clossys/agents/*/*/slot.json",
      "schema": "slot"
    },
    {
      "glob": "clossys/agents/*/*/pin.json",
      "schema": "pin"
    },
    {
      "glob": "clossys/agents/director/*/candidates/*",
      "schema": "candidate-brief"
    },
    {
      "glob": "clossys/agents/designer/*/candidates/*",
      "schema": "candidate-element"
    },
    {
      "glob": "clossys/agents/writer/*/candidates/*",
      "schema": "candidate-strings"
    },
    {
      "glob": "clossys/agents/publisher/*/candidates/*",
      "schema": "candidate-publisher"
    },
    {
      "glob": "pkg:studio/compile.lock.json",
      "schema": "compile-lock"
    }
  ],
  "outputs": [
    {
      "glob": "pkg:dist/check/source-receipt.json",
      "schema": "source-receipt"
    }
  ],
  "pass": {
    "command": "clossys check",
    "exit": {
      "pass": [
        0
      ],
      "fail": [
        1
      ],
      "error": [
        2
      ]
    }
  },
  "record": "clossys.pipeline-run/1",
  "checks": [
    "workspace"
  ],
  "uses": []
}
