{
  "schema": "clossys.action/1",
  "id": "publisher.check",
  "agent": "producer",
  "kind": "plumb",
  "stage": "publish.check",
  "summary": "Publisher page checks (catalog, instance key, inline copy) over every consumer page candidate; any finding exits 1.",
  "run": "clossys publisher check",
  "inputs": [
    {
      "glob": "consumer:agents/publisher/*/pin.json",
      "schema": "pin"
    },
    {
      "glob": "consumer:agents/publisher/*/candidates/*",
      "schema": "candidate-publisher"
    }
  ],
  "outputs": [],
  "pass": {
    "command": "clossys check",
    "exit": {
      "pass": [
        0
      ],
      "fail": [
        1
      ],
      "error": [
        2
      ]
    }
  },
  "record": "clossys.pipeline-run/1",
  "checks": [
    "workspace"
  ],
  "uses": []
}
