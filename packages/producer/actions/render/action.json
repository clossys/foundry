{
  "schema": "clossys.action/1",
  "id": "render",
  "agent": "producer",
  "kind": "plumb",
  "stage": "publish.assemble",
  "summary": "Render one Designer candidate in context for P2, cached by (candidate sha256, dependency pin-set hash).",
  "run": "clossys render <slot> <candidate>",
  "chain": {
    "skip": "render draws one candidate a P2 craft run names; P2 and its blind critic run it"
  },
  "inputs": [
    {
      "glob": "consumer:agents/*/ia.json",
      "schema": "ia"
    },
    {
      "glob": "consumer:agents/designer/*/slot.json",
      "schema": "slot"
    },
    {
      "glob": "consumer:agents/designer/*/pin.json",
      "schema": "pin"
    },
    {
      "glob": "consumer:agents/designer/*/candidates/*",
      "schema": "candidate-element"
    },
    {
      "glob": "consumer:agents/writer/*/pin.json",
      "schema": "pin"
    },
    {
      "glob": "consumer:agents/writer/*/candidates/*",
      "schema": "candidate-strings"
    }
  ],
  "outputs": [
    {
      "glob": "node_modules/.cache/clossys/render/**",
      "schema": "specimen-thumbnail"
    }
  ],
  "pass": {
    "command": "clossys render <slot> <candidate>",
    "exit": {
      "pass": [
        0
      ],
      "fail": [
        1
      ],
      "error": [
        2
      ]
    }
  },
  "record": "clossys.pipeline-run/1",
  "checks": [
    "every-candidate-previewable"
  ],
  "uses": []
}
