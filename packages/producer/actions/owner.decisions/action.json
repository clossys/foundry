{
  "schema": "clossys.action/1",
  "id": "owner.decisions",
  "agent": "owner",
  "kind": "decide:judgment",
  "stage": "direct.brief",
  "summary": "Owner decisions an --owner-ref may cite: the ledger comment, its date, scope and summary (clossys owner-decision).",
  "run": "clossys owner-decision add --ref <ledger-ref> --scope <scope> --quote-file <file>",
  "inputs": [],
  "outputs": [
    {
      "glob": "clossys/owner-decisions.json",
      "schema": "owner-decisions"
    }
  ],
  "pass": {
    "command": "clossys pipeline trace check:pipeline -- npm run check:pipeline",
    "exit": {
      "pass": [
        0
      ],
      "fail": [
        1
      ],
      "error": [
        2
      ]
    }
  },
  "record": "clossys.pipeline-run/1",
  "checks": [
    "pipeline"
  ],
  "uses": [
    "skill/SKILL.md"
  ],
  "decider": "owner",
  "packet": {
    "inputs": [],
    "write": [
      {
        "glob": "clossys/owner-decisions.json",
        "schema": "owner-decisions"
      }
    ],
    "checks": [
      "pipeline"
    ]
  },
  "skill": "skill.md"
}
