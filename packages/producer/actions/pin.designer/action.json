{
  "schema": "clossys.action/1",
  "id": "pin.designer",
  "agent": "owner",
  "kind": "decide:judgment",
  "stage": "design.pin",
  "summary": "Pin one candidate per Designer L3 slot, or mark the slot not needed.",
  "run": "clossys pin designer/<slot> <candidate-id>",
  "inputs": [
    {
      "glob": "clossys/agents/designer/*/candidates/*",
      "schema": "candidate-element"
    },
    {
      "glob": "clossys/agents/designer/*/slot.json",
      "schema": "slot"
    }
  ],
  "outputs": [
    {
      "glob": "clossys/agents/designer/*/pin.json",
      "schema": "pin"
    },
    {
      "glob": "clossys/agents/designer/*/slot.json#notNeeded",
      "schema": "slot"
    }
  ],
  "pass": {
    "command": "clossys pipeline trace check:slot-pins -- npm run check:slot-pins",
    "exit": {
      "pass": [
        0
      ],
      "fail": [
        1
      ],
      "error": [
        2
      ]
    }
  },
  "record": "clossys.pipeline-run/1",
  "checks": [
    "decisions",
    "slot-state",
    "slot-pins",
    "pin-propagation",
    "every-candidate-previewable"
  ],
  "uses": [
    "skill/SKILL.md"
  ],
  "decider": "owner",
  "packet": {
    "inputs": [
      "clossys/agents/designer/*/candidates/*",
      "clossys/agents/designer/*/slot.json"
    ],
    "write": [
      {
        "glob": "clossys/agents/designer/*/pin.json",
        "schema": "pin"
      },
      {
        "glob": "clossys/agents/designer/*/slot.json#notNeeded",
        "schema": "slot"
      }
    ],
    "checks": [
      "slot-pins",
      "decisions"
    ]
  },
  "skill": "skill.md",
  "open": "slots-undecided:designer"
}
