{
  "schema": "clossys.action/1",
  "id": "migrate",
  "agent": "producer",
  "kind": "plumb",
  "stage": "publish.assemble",
  "summary": "One-shot codemod: migrate copy keys to port ids (--check reports only).",
  "run": "clossys migrate copy-keys",
  "inputs": [
    {
      "glob": "clossys/agents/director/*/candidates/*",
      "schema": "candidate-brief"
    },
    {
      "glob": "clossys/agents/designer/*/candidates/*",
      "schema": "candidate-element"
    },
    {
      "glob": "clossys/agents/writer/*/candidates/*",
      "schema": "candidate-strings"
    },
    {
      "glob": "clossys/agents/publisher/*/candidates/*",
      "schema": "candidate-publisher"
    }
  ],
  "outputs": [],
  "pass": {
    "command": "clossys migrate copy-keys --check",
    "exit": {
      "pass": [
        0
      ],
      "fail": [
        1
      ],
      "error": [
        2
      ]
    }
  },
  "record": "clossys.pipeline-run/1",
  "checks": [
    "workspace"
  ],
  "uses": []
}
