{
  "schema": "clossys.action/1",
  "id": "migrate",
  "agent": "producer",
  "kind": "plumb",
  "stage": "publish.assemble",
  "summary": "One-shot codemods: copy keys to port ids, and the ledger backfill from git history (clossys migrate ledger). It owns every ledger.json file; its events field has one claimer (verdict), and every other verb appends through the one ledger append in records/slot-write.ts instead of claiming it; --check reports only.",
  "run": "clossys migrate copy-keys",
  "inputs": [
    {
      "glob": "clossys/agents/director/*/candidates/*",
      "schema": "candidate-brief"
    },
    {
      "glob": "clossys/agents/designer/*/candidates/*",
      "schema": "candidate-element"
    },
    {
      "glob": "clossys/agents/writer/*/candidates/*",
      "schema": "candidate-strings"
    },
    {
      "glob": "clossys/agents/publisher/*/candidates/*",
      "schema": "candidate-publisher"
    }
  ],
  "outputs": [
    {
      "glob": "clossys/agents/*/ledger.json",
      "schema": "ledger"
    },
    {
      "glob": "clossys/agents/*/*/ledger.json",
      "schema": "ledger"
    }
  ],
  "pass": {
    "command": "clossys migrate copy-keys --check",
    "exit": {
      "pass": [
        0
      ],
      "fail": [
        1
      ],
      "error": [
        2
      ]
    }
  },
  "record": "clossys.pipeline-run/1",
  "checks": [
    "workspace"
  ],
  "uses": []
}
