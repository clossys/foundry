{
  "schema": "clossys.action/1",
  "id": "options",
  "agent": "producer",
  "kind": "plumb",
  "stage": "publish.assemble",
  "summary": "Candidate options: write slot.json options/varyOn from the class mapping, list a slot's options, or print the brief for fresh ones.",
  "run": "clossys options --classes",
  "inputs": [
    {
      "glob": "clossys/agents/*/ia.json",
      "schema": "ia"
    },
    {
      "glob": "clossys/agents/*/*/slot.json",
      "schema": "slot"
    },
    {
      "glob": "clossys/agents/*/*/pin.json",
      "schema": "pin"
    },
    {
      "glob": "clossys/agents/director/*/candidates/*",
      "schema": "candidate-brief"
    },
    {
      "glob": "clossys/agents/designer/*/candidates/*",
      "schema": "candidate-element"
    },
    {
      "glob": "clossys/agents/writer/*/candidates/*",
      "schema": "candidate-strings"
    },
    {
      "glob": "clossys/agents/publisher/*/candidates/*",
      "schema": "candidate-publisher"
    }
  ],
  "outputs": [
    {
      "glob": "clossys/agents/*/*/slot.json#options",
      "schema": "slot"
    },
    {
      "glob": "clossys/agents/*/*/slot.json#varyOn",
      "schema": "slot"
    }
  ],
  "pass": {
    "command": "clossys options --classes --check",
    "exit": {
      "pass": [
        0
      ],
      "fail": [
        1
      ],
      "error": [
        2
      ]
    }
  },
  "record": "clossys.pipeline-run/1",
  "checks": [
    "slot-options"
  ],
  "uses": []
}
