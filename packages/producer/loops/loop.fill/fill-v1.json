{
  "clossys": {
    "schema": "clossys.candidate/1",
    "id": "producer/loop.fill/package:fill-v1.json",
    "agent": "producer",
    "kind": "candidate",
    "status": "submitted",
    "slot": "producer/loop.fill",
    "createdBy": {
      "actor": "package",
      "package": "@clossys/producer",
      "version": "0.1.0"
    },
    "createdAt": "2026-11-15T00:00:00Z",
    "refs": [],
    "source": {
      "kind": "package-default",
      "ref": []
    },
    "rationale": []
  },
  "content": {
    "trigger": [
      "T1",
      "T2",
      "T4"
    ],
    "steps": [
      {
        "id": "triage",
        "does": "code reads the run's trigger: one that names one record and no rule (T1 init, T2 starter-fill, T4 add-l3, T6 failed-check, T7 upstream-cascade, T8 new-release) settles refine-brief with no tightening and keeps a settle record; only a slot-wide trigger (T3 tighten-brief, T5 owner-feedback) reaches the owner of the slot",
        "decider": {
          "by": "code"
        },
        "cli": "clossys settle brief <ref>",
        "reads": [
          "<slot>/slot.json"
        ],
        "writes": [
          "clossys/.state/runs/loops/*.settle/*"
        ],
        "checks": [],
        "onFail": {
          "raise": "queue.clarify",
          "then": "retry"
        }
      },
      {
        "id": "refine-brief",
        "does": "decide whether the trigger is a rule for the whole slot (tighten the brief) or one record; often no tightening",
        "decider": {
          "by": "agent",
          "agent": "<owner of slot>",
          "verb": "refine-brief",
          "tier": "mid",
          "skill": "packages/<agent>/actions/<agent>.brief/skill.md"
        },
        "cli": "clossys brief <ref> --tighten --path <path> --op <op> --value <value> --why <why> --by <by>",
        "reads": [
          "<slot>/slot.json",
          "<inputs>"
        ],
        "writes": [
          "<slot>/slot.json"
        ],
        "checks": [
          "brief.tighten-only"
        ],
        "onFail": {
          "raise": "queue.clarify",
          "then": "retry"
        }
      },
      {
        "id": "adopt",
        "does": "code reads the slot's contract: a Designer components slot under an adopt-first standard (not a consumer asset, one option) that holds no candidate, whose contract fixture a shadcn-aria or diceui stock item ships with every import locked, gets that item unmodified at rung L1 (submitted by code:adopt through the candidate guard) and settles create with a settle record; certify judges it like any candidate, and every other slot, a refused submit or a failed certify reaches the agent's create",
        "decider": {
          "by": "code"
        },
        "cli": "clossys settle adopt <ref>",
        "reads": [
          "<slot>/slot.json",
          "<slot>/candidates/*",
          "<slot>/ledger.json"
        ],
        "writes": [
          "<slot>/candidates/*",
          "<slot>/ledger.json",
          "clossys/.state/runs/loops/*.settle/*"
        ],
        "checks": [],
        "onFail": {
          "raise": "queue.clarify",
          "then": "retry"
        }
      },
      {
        "id": "create",
        "does": "write one to three new candidates against the current brief",
        "decider": {
          "by": "agent",
          "agent": "<owner of slot>",
          "verb": "create-candidates",
          "tier": "mid",
          "skill": "packages/<agent>/actions/<agent>.candidates/skill.md"
        },
        "cli": "clossys next <ref> --submit <file>",
        "reads": [
          "<slot>/slot.json",
          "<inputs>"
        ],
        "writes": [
          "<slot>/candidates/*"
        ],
        "checks": []
      },
      {
        "id": "check",
        "does": "run the slot's standard and acceptance checks",
        "decider": {
          "by": "code"
        },
        "cli": "clossys check --constitution --slot <ref>",
        "reads": [
          "<slot>/candidates/*"
        ],
        "writes": [
          "clossys/.state/checks/<agent>/<slot-id>/*"
        ],
        "checks": [
          "<slot standard>"
        ],
        "onFail": {
          "raise": "queue.fix",
          "then": "retry"
        }
      },
      {
        "id": "owner-pick",
        "does": "owner picks among the passing candidates in chat (Director slots and legal prose); the pin is the owner's, and the agent pick does not run for these slots",
        "decider": {
          "by": "human",
          "who": "owner",
          "raise": "queue.pick"
        },
        "cli": "clossys answer <entry> <candidate> --by owner --via chat --quote <words>",
        "reads": [],
        "writes": [
          "<slot>/pin.json"
        ],
        "checks": [
          "answer.quote-required",
          "pins.resolve"
        ],
        "when": {
          "ia": [
            "director"
          ],
          "slots": [
            "writer/narratives.legal-document"
          ]
        }
      },
      {
        "id": "score",
        "does": "code reads the pin gate's scorecard: when one submitted, certified candidate is strictly ahead of every other, on a slot with no owner-pick or confirm step and no owner or planner pin, code pins it through the pin gate (basis scorecard, decidedBy code:scorecard) and settles pick with a settle record; a tie, an owner step or a held human decision reaches the agent pick, and a refused pin defers to it",
        "decider": {
          "by": "code"
        },
        "cli": "clossys settle pick <ref>",
        "reads": [
          "<slot>/candidates/*",
          "<slot>/ledger.json",
          "clossys/.state/checks/<agent>/<slot-id>/*",
          "<upstream>/*/pin.json"
        ],
        "writes": [
          "<slot>/pin.json",
          "clossys/.state/checks/<agent>/<slot-id>/scorecard.json",
          "clossys/.state/runs/loops/*.settle/*"
        ],
        "checks": [],
        "onFail": {
          "raise": "queue.clarify",
          "then": "retry"
        }
      },
      {
        "id": "pick",
        "does": "judge the passing candidates and pin one (status confirm when an owner step follows); skipped for a slot the owner picks",
        "decider": {
          "by": "agent",
          "agent": "<owner of slot>",
          "verb": "pick",
          "tier": "mid",
          "skill": "packages/<agent>/actions/pick.<agent>/skill.md"
        },
        "cli": "clossys pick <ref> <candidate> --by agent:<agent>",
        "reads": [
          "clossys/.state/checks/<agent>/<slot-id>/*"
        ],
        "writes": [
          "<slot>/pin.json"
        ],
        "checks": [
          "pins.resolve"
        ]
      },
      {
        "id": "confirm",
        "does": "owner reads the pick and its rationale in chat (Theme, Art and Voice)",
        "decider": {
          "by": "human",
          "who": "owner",
          "raise": "queue.approve"
        },
        "cli": "clossys answer <entry> approve --by owner --via chat --quote <words>",
        "reads": [],
        "writes": [
          "<slot>/pin.json"
        ],
        "checks": [
          "answer.quote-required"
        ],
        "when": {
          "ia": [
            "designer/themes",
            "designer/assets",
            "writer/voice"
          ]
        }
      },
      {
        "id": "cascade",
        "does": "re-verdict every pin whose pinSet this repin changed (loop.cascade); a failing dependant is marked needs-refresh and goes to its owner as a queue.fix",
        "decider": {
          "by": "code"
        },
        "cli": "clossys check <dependants>",
        "reads": [
          "<slot>/slot.json"
        ],
        "writes": [
          "<dependant>/slot.json"
        ],
        "checks": [
          "refs.dangling"
        ]
      }
    ],
    "exit": "no consumed slot is on a package default, except Writer copy the owner left on sample",
    "repeat": "the next unfilled slot in chain order (Director, Designer and Writer, Publisher; then IA order), one ledger entry per slot",
    "maxRounds": 3
  }
}
