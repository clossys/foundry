    "rationale": []
  },
  "content": {
    "trigger": [
      "T6"
    ],
    "steps": [
      {
        "id": "strict",
        "does": "run the strict checks, the orphan check and the dangling-ref check",
        "decider": {
          "by": "code"
        },
        "cli": "clossys check --strict",
        "reads": [
          "clossys/agents/"
        ],
        "writes": [
          "clossys/.state/checks/"
        ],
        "checks": [
          "constitution.strict",
          "ia.orphans",
          "refs.dangling"
        ]
      },
      {
        "id": "route",
        "does": "route each finding: queue.fix to the owning agent, queue.clarify to the owner; one entry per subject",
        "decider": {
          "by": "code"
        },
        "cli": "clossys check --route",
        "reads": [
          "clossys/.state/checks/"
        ],
        "writes": [
          "producer/queue.fix/entries/",
          "producer/queue.clarify/entries/"
        ],
        "checks": []
      },
      {
        "id": "e2e",
        "does": "prove a fresh consumer end to end: pack the installed cohort, install the tarballs into an empty directory, drive the shipped scenario with public verbs only and assert the rendered page",
        "decider": {
          "by": "code"
        },
        "cli": "clossys check --e2e",
        "reads": [
          "node_modules/@clossys/"
        ],
        "writes": [],
        "checks": [
          "consumer.e2e"
        ],
        "onFail": {
          "raise": "queue.clarify",
          "then": "loop.refine"
        }
      }
    ],
    "exit": "a run raises no new entry",
    "repeat": "none inside a run: each raised entry starts a loop.refine run",
    "maxRounds": 1
  }
