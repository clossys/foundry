{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clossys.com/schemas/producer/constitution/slot.schema.json",
  "title": "Live slot (slot.json), constitution target shape",
  "description": "Drafted read-only from validate.ts validateSlotDoc. Target shape: no notNeeded key (R04, D4); the contract is an object whose per-kind schema (and fixture, R01.3) is owned by a later unit.",
  "type": "object",
  "required": [
    "schema",
    "id",
    "agent",
    "ia",
    "kind",
    "contract",
    "inputs",
    "uses"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "clossys.slot/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*){1,3}$"
    },
    "agent": {
      "enum": [
        "director",
        "designer",
        "writer",
        "publisher"
      ]
    },
    "ia": {
      "type": "object",
      "required": [
        "l1",
        "l2",
        "order"
      ],
      "additionalProperties": false,
      "properties": {
        "l0": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "l1": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "l2": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "kind": {
      "enum": [
        "brief",
        "element",
        "strings",
        "page",
        "publication"
      ]
    },
    "contract": {
      "type": "object"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*){1,3}$"
      }
    },
    "uses": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*){1,3}$"
      }
    },
    "options": {
      "enum": [
        1,
        2,
        3
      ]
    },
    "varyOn": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "extension": {
      "description": "A consumer extension leaf (R01.14): listed in ia.json extensions and placed under a Foundry L1. A leaf property, never a tab.",
      "type": "boolean"
    }
  },
  "anyOf": [
    {
      "properties": {
        "agent": {
          "const": "director"
        },
        "kind": {
          "const": "brief"
        }
      }
    },
    {
      "properties": {
        "agent": {
          "const": "designer"
        },
        "kind": {
          "const": "element"
        }
      }
    },
    {
      "properties": {
        "agent": {
          "const": "writer"
        },
        "kind": {
          "const": "strings"
        }
      }
    },
    {
      "properties": {
        "agent": {
          "const": "publisher"
        },
        "kind": {
          "enum": [
            "page",
            "publication"
          ]
        }
      }
    }
  ]
}
