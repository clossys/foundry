{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clossys.com/schemas/producer/constitution/candidate.schema.json",
  "title": "Candidate record shapes, by kind",
  "description": "Drafted read-only from validate.ts validateCandidate. A .md candidate (brief, strings) is validated as its frontmatter object; a .json candidate (element, page, publication) as the parsed file. Body rules (brief headings, strings locale sections) and the R05 certifier stay in code.",
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "kind",
        "ref"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "registry",
            "derived",
            "original",
            "composition",
            "npm",
            "interactive-backdrop"
          ]
        },
        "ref": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "slot",
              "files"
            ],
            "additionalProperties": false,
            "properties": {
              "slot": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*){1,3}$"
              },
              "files": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "hash": {
          "type": "string"
        },
        "license": {
          "type": "string"
        }
      }
    },
    "vary": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
      }
    },
    "briefFrontmatter": {
      "type": "object",
      "required": [
        "slot",
        "source",
        "feeds",
        "functions"
      ],
      "additionalProperties": false,
      "properties": {
        "slot": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*){1,3}$"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "feeds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "functions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": "string"
        },
        "vary": {
          "$ref": "#/$defs/vary"
        }
      }
    },
    "stringsFrontmatter": {
      "type": "object",
      "required": [
        "slot",
        "source",
        "locales"
      ],
      "additionalProperties": false,
      "properties": {
        "slot": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*){1,3}$"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "locales": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "vary": {
          "$ref": "#/$defs/vary"
        }
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/source"
        },
        "vary": {
          "$ref": "#/$defs/vary"
        },
        "slot": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*){1,3}$"
        }
      }
    },
    "element": {
      "type": "object",
      "required": [
        "name",
        "type",
        "files",
        "meta"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "registry:ui",
            "registry:block",
            "registry:component",
            "registry:lib",
            "registry:hook",
            "registry:page",
            "registry:file",
            "registry:style",
            "registry:theme",
            "registry:item",
            "registry:base",
            "registry:font"
          ]
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "type",
              "content"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "content": {
                "type": "string"
              },
              "target": {
                "type": "string"
              }
            }
          }
        },
        "registryDependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cssVars": {
          "type": "object"
        },
        "meta": {
          "$ref": "#/$defs/meta"
        }
      }
    },
    "page": {
      "type": "object",
      "required": [
        "schema",
        "title",
        "frame",
        "sections",
        "copy",
        "meta"
      ],
      "properties": {
        "schema": {
          "const": "clossys.page/1"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        },
        "frame": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*){1,3}$"
            }
          ]
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*){1,3}$"
          }
        },
        "copy": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*){1,3}#\\S+$"
          }
        },
        "bindings": {
          "type": "object"
        },
        "meta": {
          "$ref": "#/$defs/meta"
        }
      },
      "oneOf": [
        {
          "required": [
            "path"
          ]
        },
        {
          "required": [
            "slug"
          ]
        }
      ]
    },
    "publication": {
      "type": "object",
      "required": [
        "schema",
        "format",
        "entryOrder",
        "meta"
      ],
      "properties": {
        "schema": {
          "const": "clossys.publication/1"
        },
        "format": {
          "type": "string",
          "minLength": 1
        },
        "entryOrder": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "meta": {
          "$ref": "#/$defs/meta"
        }
      }
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/element"
    },
    {
      "$ref": "#/$defs/page"
    },
    {
      "$ref": "#/$defs/publication"
    },
    {
      "$ref": "#/$defs/briefFrontmatter"
    },
    {
      "$ref": "#/$defs/stringsFrontmatter"
    }
  ]
}
