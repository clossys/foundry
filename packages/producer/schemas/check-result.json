{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clossys.check-result/1",
  "title": "Check result",
  "description": "Result of clossys check for one candidate, at clossys/.state/checks/<agent>/<slot-id>/<candidate>.json (system.md 4, 6.4).",
  "type": "object",
  "required": [
    "schema",
    "subject",
    "subjectSha256",
    "briefSha256",
    "standard",
    "ranAt",
    "by",
    "status",
    "results"
  ],
  "properties": {
    "schema": {
      "const": "clossys.check-result/1"
    },
    "subject": {
      "type": "string",
      "pattern": "^(director|designer|writer|publisher|producer)/[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*){1,3}/(package:)?[a-z0-9][a-z0-9.-]*-v[1-9][0-9]*\\.(md|json|svg)$"
    },
    "subjectSha256": {
      "$ref": "#/$defs/sha256"
    },
    "briefSha256": {
      "$ref": "#/$defs/sha256"
    },
    "standard": {
      "type": "string",
      "minLength": 1
    },
    "ranAt": {
      "$ref": "#/$defs/iso"
    },
    "by": {
      "$ref": "#/$defs/codeActor"
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "error"
      ]
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "check",
          "status"
        ],
        "properties": {
          "check": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "skip"
            ]
          },
          "field": {
            "type": "string",
            "minLength": 1
          },
          "locale": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "agentId": {
      "enum": [
        "director",
        "designer",
        "writer",
        "publisher",
        "producer"
      ]
    },
    "slotId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*){1,3}$"
    },
    "candidateName": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*-v[1-9][0-9]*\\.(md|json|svg)$"
    },
    "iso": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "codeActor": {
      "type": "object",
      "required": [
        "actor",
        "cli",
        "version"
      ],
      "properties": {
        "actor": {
          "const": "code"
        },
        "cli": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
