{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clossys.ledger-entry/1",
  "title": "Ledger entry",
  "description": "One loop run; never edited (system.md 6.5).",
  "type": "object",
  "required": [
    "schema",
    "id",
    "agent",
    "kind",
    "status",
    "createdBy",
    "createdAt",
    "refs",
    "loop",
    "loopVersion",
    "trigger",
    "steps",
    "checks",
    "decisions",
    "outcome"
  ],
  "properties": {
    "schema": {
      "const": "clossys.ledger-entry/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{4}Z-[a-z0-9][a-z0-9-]*$"
    },
    "agent": {
      "$ref": "#/$defs/agentId"
    },
    "kind": {
      "const": "ledger-entry"
    },
    "status": {
      "enum": [
        "done",
        "stopped",
        "pinned-ready"
      ]
    },
    "createdBy": {
      "$ref": "#/$defs/actor"
    },
    "createdAt": {
      "$ref": "#/$defs/iso"
    },
    "updatedAt": {
      "$ref": "#/$defs/iso"
    },
    "refs": {
      "$ref": "#/$defs/refs"
    },
    "loop": {
      "type": "string",
      "pattern": "^loop\\.[a-z][a-z0-9-]*$"
    },
    "loopVersion": {
      "$ref": "#/$defs/candidateName"
    },
    "trigger": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "$ref": "#/$defs/ref"
        }
      },
      "additionalProperties": false
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "decider",
          "cli",
          "exit",
          "wrote"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "decider": {
            "$ref": "#/$defs/decider"
          },
          "cli": {
            "type": "string",
            "minLength": 1
          },
          "exit": {
            "enum": [
              0,
              1,
              2
            ]
          },
          "wrote": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "file",
                "sha256"
              ],
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/sha256"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "pass",
          "fail"
        ]
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "entry",
          "answer"
        ],
        "properties": {
          "entry": {
            "type": "string",
            "minLength": 1
          },
          "answer": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "outcome": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "$defs": {
    "agentId": {
      "enum": [
        "director",
        "designer",
        "writer",
        "publisher",
        "producer"
      ]
    },
    "slotId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*){1,3}$"
    },
    "candidateName": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*-v[1-9][0-9]*\\.(md|json|svg)$"
    },
    "iso": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tier": {
      "enum": [
        "low",
        "mid",
        "high"
      ]
    },
    "actor": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "actor",
            "package",
            "version"
          ],
          "properties": {
            "actor": {
              "const": "package"
            },
            "package": {
              "type": "string",
              "pattern": "^@clossys/(director|designer|writer|publisher|producer)$"
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "actor",
            "agent",
            "skill",
            "skillSha256",
            "model",
            "tier"
          ],
          "properties": {
            "actor": {
              "const": "agent"
            },
            "agent": {
              "$ref": "#/$defs/agentId"
            },
            "skill": {
              "type": "string",
              "minLength": 1
            },
            "skillSha256": {
              "$ref": "#/$defs/sha256"
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "tier": {
              "$ref": "#/$defs/tier"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "actor",
            "ref"
          ],
          "properties": {
            "actor": {
              "const": "owner"
            },
            "ref": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "actor",
            "ref"
          ],
          "properties": {
            "actor": {
              "const": "planner"
            },
            "ref": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "actor",
            "cli",
            "version"
          ],
          "properties": {
            "actor": {
              "const": "code"
            },
            "cli": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "ref": {
      "type": "object",
      "required": [
        "to",
        "rel"
      ],
      "properties": {
        "to": {
          "type": "string",
          "pattern": "^(facts|(director|designer|writer|publisher|producer)/[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*){1,3}(/(package:)?[a-z0-9][a-z0-9.-]*-v[1-9][0-9]*\\.(md|json|svg))?)$"
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "record": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "rel": {
          "enum": [
            "input",
            "uses",
            "consumedBy",
            "places",
            "cites",
            "raisedBy",
            "answers"
          ]
        }
      },
      "additionalProperties": false
    },
    "refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "decider": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "by"
          ],
          "properties": {
            "by": {
              "const": "code"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "by",
            "agent",
            "verb",
            "tier",
            "model"
          ],
          "properties": {
            "by": {
              "const": "agent"
            },
            "agent": {
              "$ref": "#/$defs/agentId"
            },
            "verb": {
              "enum": [
                "refine-brief",
                "create-candidates",
                "check",
                "pin",
                "pick"
              ]
            },
            "tier": {
              "$ref": "#/$defs/tier"
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "skill": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "by",
            "who",
            "raise"
          ],
          "properties": {
            "by": {
              "const": "human"
            },
            "who": {
              "const": "owner"
            },
            "raise": {
              "enum": [
                "queue.pick",
                "queue.approve",
                "queue.clarify"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
