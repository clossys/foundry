{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clossys.preview/1",
  "title": "Preview view",
  "description": "Output of clossys preview <publication> (system.md 12.5). Not the int2 element preview record of the same id.",
  "type": "object",
  "required": [
    "schema",
    "publication",
    "buildId",
    "url",
    "routes",
    "overrides",
    "sample"
  ],
  "properties": {
    "schema": {
      "const": "clossys.preview/1"
    },
    "publication": {
      "type": "string",
      "minLength": 1
    },
    "buildId": {
      "type": "string",
      "pattern": "^preview-[0-9a-f]{12}$"
    },
    "url": {
      "type": "string",
      "minLength": 1
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "page",
          "locales"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "page": {
            "type": "string",
            "minLength": 1
          },
          "locales": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ref",
          "sha256"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        },
        "additionalProperties": false
      }
    },
    "sample": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
