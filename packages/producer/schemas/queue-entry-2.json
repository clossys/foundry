{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clossys.queue-entry/2",
  "title": "Queue entry",
  "description": "One queue entry: who requests, who is assigned and what it is about are fields, not separate queues or records. foundry-build-0048 U5 writes kind slot (SLOT-CREATE); U7 adds the work kinds change and fix and the route the router writes (queue/routing.ts): a requester slot, or the owner, names a slot no agent holds; the assignee agent reuses a placed slot or creates one. Written by `clossys request` (and by `clossys ia`, `clossys feedback` and the SCOPE scan) at clossys/agents/producer/queue.slot/entries/<id>.json; `clossys request <id> --close` links the requester slot-to-slot, notifies it and closes the entry. The clossys.queue-entry/1 writers (queue.pick, queue.approve, queue.clarify, queue.fix) are unchanged; a later unit moves them to this shape. `events` is the entry's own ledger: each event has an id `<entry id>#<n>`, and `opened`/`closed` name the raising and closing events. The validator has no conditionals: kind slot needs a slot-ref target and rel, a reuse decision needs reuse and overlaps, a create decision proposal and overlaps, and a closed entry decision, link, notified, closed and closedAt (records/request.ts requestIssues).",
  "type": "object",
  "required": [
    "schema",
    "id",
    "kind",
    "from",
    "assignee",
    "target",
    "status",
    "opened",
    "why",
    "source",
    "createdBy",
    "createdAt",
    "refs",
    "events"
  ],
  "properties": {
    "schema": {
      "const": "clossys.queue-entry/2"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{4}Z-[a-z0-9][a-z0-9-]*$"
    },
    "kind": {
      "description": "What is asked. pick, approve, clarify and fix are the clossys.queue-entry/1 queues; slot: a slot that does not exist yet; change: a change to a placed slot.",
      "enum": [
        "pick",
        "approve",
        "clarify",
        "fix",
        "slot",
        "change"
      ]
    },
    "from": {
      "description": "The requester: an agent slot ref, or the owner for a need with no requester slot.",
      "type": "string",
      "pattern": "^((director|designer|writer|publisher|producer)/[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*){1,3}|owner)$"
    },
    "assignee": {
      "description": "Who executes the entry: an agent id, or the owner.",
      "enum": [
        "director",
        "designer",
        "writer",
        "publisher",
        "producer",
        "owner"
      ]
    },
    "target": {
      "description": "What the entry is about: a slot ref <agent>/<slot id> (kind slot: the slot the requester names, which no slot holds when raised; kind change or fix: the placed slot) or an L2 home <agent>/<l1>/<l2>.",
      "type": "string",
      "pattern": "^(director|designer|writer|publisher|producer)/([a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*){1,3}|[a-z][a-z0-9.-]*/[a-z][a-z0-9.-]*)$"
    },
    "status": {
      "enum": [
        "open",
        "closed"
      ]
    },
    "opened": {
      "description": "The id of the raised ledger event (an id in events).",
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{4}Z-[a-z0-9][a-z0-9-]*#[1-9][0-9]*$"
    },
    "closed": {
      "description": "The id of the closed ledger event (an id in events).",
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{4}Z-[a-z0-9][a-z0-9-]*#[1-9][0-9]*$"
    },
    "link": {
      "description": "The closing slot ref: the slot the requester now cites (the created or reused one).",
      "$ref": "#/$defs/slotRef"
    },
    "rel": {
      "description": "kind slot: how the requester cites the slot once it exists.",
      "enum": [
        "input",
        "uses"
      ]
    },
    "why": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "enum": [
        "cli",
        "ia",
        "interview",
        "feedback",
        "scope",
        "check"
      ]
    },
    "createdBy": {
      "description": "Who raised the entry, as clossys.queue-entry/1 createdBy: the owner (with where the words were said), the planner, or the code verb that filed it.",
      "$ref": "#/$defs/actor"
    },
    "createdAt": {
      "$ref": "#/$defs/iso"
    },
    "refs": {
      "description": "As clossys.queue-entry/1 refs: the requester slot (rel raisedBy) when a slot raised the entry.",
      "$ref": "#/$defs/refs"
    },
    "overlaps": {
      "description": "kind slot: the overlap check over the assignee's placed slots (`clossys request <id> --check`): every slot the need may duplicate.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "slot",
          "why"
        ],
        "properties": {
          "slot": {
            "$ref": "#/$defs/slotRef"
          },
          "why": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "overlapReason": {
      "description": "kind slot, decision create over a listed overlap: why the proposal is a new leaf, not the overlapping slot. The owner signs it with the leaf.",
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "enum": [
        "reuse",
        "create"
      ]
    },
    "reuse": {
      "description": "decision reuse: the placed slot the requester cites instead.",
      "$ref": "#/$defs/slotRef"
    },
    "proposal": {
      "description": "kind slot, decision create: the new leaf the assignee proposes; the owner signs it before `ia` places it.",
      "type": "object",
      "required": [
        "slot",
        "under",
        "contract"
      ],
      "properties": {
        "slot": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*){1,3}$"
        },
        "under": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]*/[a-z][a-z0-9.-]*$"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "contract": {
          "type": "object"
        },
        "inputs": {
          "description": "The new leaf's inputs (slot refs): the placement overlap check compares them with the assignee's placed slots in the same L2.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "notified": {
      "description": "The ledger event addressed to the requester when the entry closed.",
      "type": "object",
      "required": [
        "to",
        "at"
      ],
      "properties": {
        "to": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "$ref": "#/$defs/iso"
        }
      },
      "additionalProperties": false
    },
    "closedAt": {
      "$ref": "#/$defs/iso"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "at",
          "op"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9]{8}T[0-9]{4}Z-[a-z0-9][a-z0-9-]*#[1-9][0-9]*$"
          },
          "at": {
            "$ref": "#/$defs/iso"
          },
          "op": {
            "enum": [
              "raised",
              "routed",
              "checked",
              "decided",
              "placed",
              "started",
              "rejected",
              "verified",
              "closed",
              "withdrawn"
            ]
          },
          "by": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string"
          },
          "via": {
            "enum": [
              "cli",
              "chat",
              "app"
            ]
          },
          "quote": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "route": {
      "description": "Written by the router only (queue/routing.ts routeEntry, foundry-build-0048 U7): the routing.json row that matched, the table's sha256, the assignee and either the agent's declared handler or the owner's MC packet. Re-deriving it from the table gives the same route.",
      "type": "object",
      "required": [
        "row",
        "table",
        "assignee"
      ],
      "properties": {
        "row": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]*$"
        },
        "table": {
          "$ref": "#/$defs/sha256"
        },
        "assignee": {
          "enum": [
            "director",
            "designer",
            "writer",
            "publisher",
            "producer",
            "owner"
          ]
        },
        "handler": {
          "type": "object",
          "required": [
            "skill",
            "loop"
          ],
          "properties": {
            "skill": {
              "type": "string",
              "minLength": 1
            },
            "loop": {
              "type": "string",
              "pattern": "^loop\\.[a-z][a-z0-9-]*$"
            }
          },
          "additionalProperties": false
        },
        "packet": {
          "type": "object",
          "required": [
            "queue"
          ],
          "properties": {
            "queue": {
              "enum": [
                "queue.pick",
                "queue.approve",
                "queue.clarify"
              ]
            },
            "step": {
              "type": "string",
              "minLength": 1
            },
            "skill": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "escalate": {
          "const": "package"
        }
      },
      "additionalProperties": false
    },
    "want": {
      "description": "kind change: what the requester wants of the placed slot.",
      "enum": [
        "repin",
        "candidate",
        "contract"
      ]
    },
    "check": {
      "description": "kind fix: the check that failed on the slot.",
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "description": "kind fix: the check's findings, verbatim.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cause": {
      "description": "kind fix: what broke the slot (the repin, run or record that changed).",
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "description": "A closed entry: what came of it.",
      "enum": [
        "reused",
        "created",
        "changed",
        "fixed",
        "declined"
      ]
    },
    "result": {
      "description": "A closed entry: the ref that resolves to the result (a slot, pin, candidate or answered queue entry).",
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "$defs": {
    "iso": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "slotRef": {
      "type": "string",
      "pattern": "^(director|designer|writer|publisher|producer)/[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*){1,3}$"
    },
    "agentId": {
      "enum": [
        "director",
        "designer",
        "writer",
        "publisher",
        "producer"
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tier": {
      "enum": [
        "low",
        "mid",
        "high"
      ]
    },
    "actor": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "actor",
            "package",
            "version"
          ],
          "properties": {
            "actor": {
              "const": "package"
            },
            "package": {
              "type": "string",
              "pattern": "^@clossys/(director|designer|writer|publisher|producer)$"
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "actor",
            "agent",
            "skill",
            "skillSha256",
            "model",
            "tier"
          ],
          "properties": {
            "actor": {
              "const": "agent"
            },
            "agent": {
              "$ref": "#/$defs/agentId"
            },
            "skill": {
              "type": "string",
              "minLength": 1
            },
            "skillSha256": {
              "$ref": "#/$defs/sha256"
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "tier": {
              "$ref": "#/$defs/tier"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "actor",
            "ref"
          ],
          "properties": {
            "actor": {
              "const": "owner"
            },
            "ref": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "actor",
            "ref"
          ],
          "properties": {
            "actor": {
              "const": "planner"
            },
            "ref": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "actor",
            "cli",
            "version"
          ],
          "properties": {
            "actor": {
              "const": "code"
            },
            "cli": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "ref": {
      "type": "object",
      "required": [
        "to",
        "rel"
      ],
      "properties": {
        "to": {
          "type": "string",
          "pattern": "^(facts|(director|designer|writer|publisher|producer)/[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*){1,3}(/(package:)?[a-z0-9][a-z0-9.-]*-v[1-9][0-9]*\\.(md|json|svg))?)$"
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "record": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "rel": {
          "enum": [
            "input",
            "uses",
            "consumedBy",
            "places",
            "cites",
            "raisedBy",
            "answers"
          ]
        }
      },
      "additionalProperties": false
    },
    "refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ref"
      }
    }
  }
}
