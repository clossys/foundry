{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clossys.ia/1",
  "title": "IA tree",
  "description": "A consumer clossys/agents/<agent>/ia.json (system.md 3, publisher.md 9.4). publications is the Publisher L2 data.",
  "type": "object",
  "required": [
    "schema",
    "id",
    "agent",
    "kind",
    "status",
    "createdBy",
    "createdAt",
    "refs"
  ],
  "properties": {
    "schema": {
      "const": "clossys.ia/1"
    },
    "id": {
      "type": "string",
      "pattern": "^(director|designer|writer|publisher|producer)/ia$"
    },
    "agent": {
      "$ref": "#/$defs/agentId"
    },
    "kind": {
      "const": "ia"
    },
    "status": {
      "enum": [
        "live"
      ]
    },
    "createdBy": {
      "$ref": "#/$defs/actor"
    },
    "createdAt": {
      "$ref": "#/$defs/iso"
    },
    "updatedAt": {
      "$ref": "#/$defs/iso"
    },
    "refs": {
      "$ref": "#/$defs/refs"
    },
    "publications": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "node",
          "starter",
          "root",
          "pages",
          "chrome",
          "release",
          "redirects"
        ],
        "properties": {
          "node": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(/[a-z][a-z0-9-]*)*$"
          },
          "starter": {
            "type": "string",
            "minLength": 1
          },
          "root": {
            "type": "string",
            "pattern": "^/"
          },
          "pages": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/slotId"
            }
          },
          "chrome": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/slotId"
            }
          },
          "release": {
            "$ref": "#/$defs/slotId"
          },
          "redirects": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "from",
                "to"
              ],
              "properties": {
                "from": {
                  "type": "string",
                  "pattern": "^/"
                },
                "to": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "agentId": {
      "enum": [
        "director",
        "designer",
        "writer",
        "publisher",
        "producer"
      ]
    },
    "slotId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*){1,3}$"
    },
    "candidateName": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*-v[1-9][0-9]*\\.(md|json|svg)$"
    },
    "iso": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tier": {
      "enum": [
        "low",
        "mid",
        "high"
      ]
    },
    "actor": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "actor",
            "package",
            "version"
          ],
          "properties": {
            "actor": {
              "const": "package"
            },
            "package": {
              "type": "string",
              "pattern": "^@clossys/(director|designer|writer|publisher|producer)$"
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "actor",
            "agent",
            "skill",
            "skillSha256",
            "model",
            "tier"
          ],
          "properties": {
            "actor": {
              "const": "agent"
            },
            "agent": {
              "$ref": "#/$defs/agentId"
            },
            "skill": {
              "type": "string",
              "minLength": 1
            },
            "skillSha256": {
              "$ref": "#/$defs/sha256"
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "tier": {
              "$ref": "#/$defs/tier"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "actor",
            "ref"
          ],
          "properties": {
            "actor": {
              "const": "owner"
            },
            "ref": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "actor",
            "ref"
          ],
          "properties": {
            "actor": {
              "const": "planner"
            },
            "ref": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "actor",
            "cli",
            "version"
          ],
          "properties": {
            "actor": {
              "const": "code"
            },
            "cli": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "ref": {
      "type": "object",
      "required": [
        "to",
        "rel"
      ],
      "properties": {
        "to": {
          "type": "string",
          "pattern": "^(facts|(director|designer|writer|publisher|producer)/[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*){1,3}(/(package:)?[a-z0-9][a-z0-9.-]*-v[1-9][0-9]*\\.(md|json|svg))?)$"
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "record": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "rel": {
          "enum": [
            "input",
            "uses",
            "consumedBy",
            "places",
            "cites",
            "raisedBy",
            "answers"
          ]
        }
      },
      "additionalProperties": false
    },
    "refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ref"
      }
    }
  }
}
