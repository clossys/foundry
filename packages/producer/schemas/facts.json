{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clossys.facts/1",
  "title": "Owner facts",
  "description": "clossys/facts.json: owner facts bound in prose as {fact:<id>} (writer.md 9.4).",
  "type": "object",
  "required": [
    "schema",
    "id",
    "status",
    "createdBy",
    "createdAt",
    "facts"
  ],
  "properties": {
    "schema": {
      "const": "clossys.facts/1"
    },
    "id": {
      "const": "facts"
    },
    "status": {
      "enum": [
        "live"
      ]
    },
    "createdBy": {
      "$ref": "#/$defs/actor"
    },
    "createdAt": {
      "$ref": "#/$defs/iso"
    },
    "updatedAt": {
      "$ref": "#/$defs/iso"
    },
    "facts": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "agentId": {
      "enum": [
        "director",
        "designer",
        "writer",
        "publisher",
        "producer"
      ]
    },
    "iso": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tier": {
      "enum": [
        "low",
        "mid",
        "high"
      ]
    },
    "actor": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "actor",
            "package",
            "version"
          ],
          "properties": {
            "actor": {
              "const": "package"
            },
            "package": {
              "type": "string",
              "pattern": "^@clossys/(director|designer|writer|publisher|producer)$"
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "actor",
            "agent",
            "skill",
            "skillSha256",
            "model",
            "tier"
          ],
          "properties": {
            "actor": {
              "const": "agent"
            },
            "agent": {
              "$ref": "#/$defs/agentId"
            },
            "skill": {
              "type": "string",
              "minLength": 1
            },
            "skillSha256": {
              "$ref": "#/$defs/sha256"
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "tier": {
              "$ref": "#/$defs/tier"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "actor",
            "ref"
          ],
          "properties": {
            "actor": {
              "const": "owner"
            },
            "ref": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "actor",
            "ref"
          ],
          "properties": {
            "actor": {
              "const": "planner"
            },
            "ref": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "actor",
            "cli",
            "version"
          ],
          "properties": {
            "actor": {
              "const": "code"
            },
            "cli": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
