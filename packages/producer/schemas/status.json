{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clossys.status/1",
  "title": "Status view",
  "description": "Output of clossys status --json (system.md 12.2, 14.9).",
  "type": "object",
  "required": [
    "schema",
    "at",
    "workspace",
    "agents",
    "queue",
    "ledger",
    "releases"
  ],
  "properties": {
    "schema": {
      "const": "clossys.status/1"
    },
    "at": {
      "$ref": "#/$defs/iso"
    },
    "workspace": {
      "type": "string",
      "minLength": 1
    },
    "stateSha256": {
      "$ref": "#/$defs/sha256"
    },
    "agents": {
      "type": "object",
      "required": [
        "director",
        "designer",
        "writer",
        "publisher",
        "producer"
      ],
      "properties": {
        "director": {
          "$ref": "#/$defs/census"
        },
        "designer": {
          "$ref": "#/$defs/census"
        },
        "writer": {
          "$ref": "#/$defs/census"
        },
        "publisher": {
          "$ref": "#/$defs/census"
        },
        "producer": {
          "$ref": "#/$defs/census"
        }
      },
      "additionalProperties": false
    },
    "queue": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "queue",
          "decider",
          "subject",
          "ask",
          "default",
          "raisedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9]{8}T[0-9]{4}Z-[a-z0-9][a-z0-9-]*$"
          },
          "queue": {
            "enum": [
              "queue.pick",
              "queue.approve",
              "queue.clarify",
              "queue.fix",
              "queue.slot",
              "queue.change",
              "queue.report"
            ]
          },
          "decider": {
            "type": "string",
            "pattern": "^(owner|agent:(director|designer|writer|publisher|producer))$"
          },
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "ask": {
            "type": "string",
            "minLength": 1
          },
          "default": {
            "type": [
              "string",
              "null"
            ]
          },
          "raisedAt": {
            "$ref": "#/$defs/iso"
          }
        },
        "additionalProperties": false
      }
    },
    "ledger": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "loop",
          "status",
          "outcome",
          "at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9]{8}T[0-9]{4}Z-[a-z0-9][a-z0-9-]*$"
          },
          "loop": {
            "type": "string",
            "pattern": "^loop\\.[a-z][a-z0-9-]*$"
          },
          "status": {
            "enum": [
              "done",
              "stopped",
              "pinned-ready"
            ]
          },
          "outcome": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "$ref": "#/$defs/iso"
          }
        },
        "additionalProperties": false
      }
    },
    "releases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "publication",
          "pinned",
          "stale"
        ],
        "properties": {
          "publication": {
            "type": "string",
            "minLength": 1
          },
          "pinned": {
            "oneOf": [
              {
                "$ref": "#/$defs/candidateName"
              },
              {
                "type": "null"
              }
            ]
          },
          "stale": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "stage": {
      "enum": [
        "setup",
        "strategy",
        "fill",
        "review",
        "release",
        "refine"
      ],
      "description": "The engagement stage, derived from records (clossys status --help states each rule)."
    },
    "next": {
      "description": "The step clossys run --dry stops at, with its model tier and the seat policy's model for it; null when nothing is open.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "step",
            "agent",
            "skill",
            "kind",
            "tier",
            "model"
          ],
          "properties": {
            "step": {
              "type": "string",
              "minLength": 1
            },
            "agent": {
              "type": "string",
              "minLength": 1
            },
            "skill": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "enum": [
                "plumb",
                "decide:creative",
                "decide:judgment"
              ]
            },
            "tier": {
              "enum": [
                "none",
                "mid",
                "high"
              ]
            },
            "model": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "minLength": 1
                }
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "candidateName": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*-v[1-9][0-9]*\\.(md|json|svg)$"
    },
    "iso": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "census": {
      "type": "object",
      "required": [
        "slots",
        "byState"
      ],
      "properties": {
        "slots": {
          "type": "integer",
          "minimum": 0
        },
        "byState": {
          "type": "object",
          "required": [
            "pinned",
            "confirm",
            "sample",
            "unresolved",
            "failing",
            "needsRefresh"
          ],
          "properties": {
            "pinned": {
              "type": "integer",
              "minimum": 0
            },
            "confirm": {
              "type": "integer",
              "minimum": 0
            },
            "sample": {
              "type": "integer",
              "minimum": 0
            },
            "unresolved": {
              "type": "integer",
              "minimum": 0
            },
            "failing": {
              "type": "integer",
              "minimum": 0
            },
            "needsRefresh": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "records": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}
