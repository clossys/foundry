    {
      "id": "home",
      "path": "/",
      "title": "Home",
      "frameId": "frames.studio-shell",
      "sectionIds": [
        "sections.studio.home"
      ],
      "body": "plain",
      "data": {
        "loader": "home"
      },
      "inputs": {
        "sections.studio.home": "home"
      },
      "manifest": {
        "frame": "frames.module",
        "navigator": "outline",
        "modules": [
          {
            "id": "outline",
            "icon": "assets.icon-outline",
            "label": "Outline",
            "section": "sections.module.outline",
            "source": "page.outline",
            "shortcut": "o",
            "defaultOpen": false,
            "input": "outline"
          },
          {
            "id": "checks",
            "icon": "assets.icon-checks",
            "label": "Checks",
            "section": "sections.module.checks",
            "source": "page.checks",
            "shortcut": "c",
            "defaultOpen": false,
            "input": "checks"
          }
        ],
        "actions": [
          {
            "id": "copy-link",
            "icon": "assets.icon-link",
            "label": "Copy link",
            "handler": {
              "kind": "copy-link"
            },
            "shortcut": "l",
            "cmdk": true
          }
        ],
        "wiring": [
          {
            "do": "toggle outline",
            "expect": "outline open, then closed"
          },
          {
            "do": "toggle checks",
            "expect": "checks open, then closed"
          },
          {
            "do": "select outline",
            "expect": "target in view and highlighted"
          },
          {
            "do": "action copy-link",
            "expect": "clipboard link"
          },
          {
            "do": "cmdk",
            "expect": "page commands listed with shortcuts"
          },
          {
            "do": "key o",
            "expect": "outline open"
          },
          {
            "do": "key escape",
            "expect": "top module closed"
          }
        ]
      }
    },
