{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clossys.com/schemas/producer/candidate-strings.schema.json",
  "title": "Writer strings candidate frontmatter (.md)",
  "description": "Derived from src/records/slot-model/validate.ts validateCandidate/validateStrings (frontmatter fields; record metadata lines are checked by clossys check).",
  "type": "object",
  "required": [
    "slot",
    "locales",
    "source"
  ],
  "additionalProperties": false,
  "properties": {
    "slot": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*){1,3}$"
    },
    "locales": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "source": {
      "$ref": "source.schema.json"
    }
  }
}
