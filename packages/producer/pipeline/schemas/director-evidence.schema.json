{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clossys.com/schemas/producer/director-evidence.schema.json",
  "title": "Director evidence (clossys/evidence/director/*.md frontmatter)",
  "description": "Owner answers and Director findings the Director cites; read by packages/director (evidence reader). Plain key: value frontmatter, read as strings; the body is free text.",
  "x-format": "scalar-frontmatter",
  "type": "object",
  "required": [
    "id",
    "source",
    "observed",
    "by"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "observed": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}"
    },
    "by": {
      "type": "string",
      "minLength": 1
    }
  }
}
