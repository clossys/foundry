{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clossys.com/schemas/producer/studio-map.schema.json",
  "title": "Studio map projection (studio/generated/studio-map.json)",
  "description": "Derived from scripts/generate-studio-map.mjs: the projection the Studio checks and capture read (routes are the capture list).",
  "type": "object",
  "required": [
    "publicationId",
    "homeId",
    "root",
    "map",
    "pages",
    "leaves",
    "tabs",
    "agents",
    "landings",
    "trails",
    "redirects",
    "items",
    "pageActions",
    "routes"
  ],
  "additionalProperties": false,
  "properties": {
    "publicationId": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "homeId": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "root": {
      "type": "object"
    },
    "map": {
      "type": "object"
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "leaves": {
      "type": "array"
    },
    "tabs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "agents": {
      "type": "array"
    },
    "landings": {
      "type": "object"
    },
    "trails": {
      "type": "object"
    },
    "redirects": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "pageActions": {
      "type": "object"
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    }
  }
}
