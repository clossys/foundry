{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clossys.com/schemas/producer/studio-map.schema.json",
  "title": "Studio map projection (studio/generated/studio-map.json)",
  "description": "Derived from scripts/generate-studio-map.mjs: the projection the Studio checks and capture read (routes are the capture list).",
  "type": "object",
  "required": [
    "publicationId",
    "homeId",
    "root",
    "map",
    "pages",
    "leaves",
    "tabs",
    "agents",
    "landings",
    "trails",
    "redirects",
    "items",
    "pageActions",
    "routes",
    "document",
    "shell"
  ],
  "additionalProperties": false,
  "properties": {
    "publicationId": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "homeId": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "root": {
      "type": "object"
    },
    "map": {
      "type": "object"
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "leaves": {
      "type": "array"
    },
    "tabs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "agents": {
      "type": "array"
    },
    "landings": {
      "type": "object"
    },
    "trails": {
      "type": "object"
    },
    "redirects": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "pageActions": {
      "type": "object"
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "document": {
      "description": "The publication document's Producer-served assets (studioDocument): stylesheets in order and the icon URLs.",
      "type": "object",
      "required": [
        "stylesheets",
        "icons"
      ],
      "additionalProperties": false,
      "properties": {
        "stylesheets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "href",
              "precedence"
            ],
            "additionalProperties": false,
            "properties": {
              "href": {
                "type": "string",
                "pattern": "^/"
              },
              "precedence": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "icons": {
          "type": "object",
          "required": [
            "icon",
            "apple"
          ],
          "additionalProperties": false,
          "properties": {
            "icon": {
              "type": "string",
              "pattern": "^/"
            },
            "apple": {
              "type": "string",
              "pattern": "^/"
            }
          }
        }
      }
    },
    "shell": {
      "description": "The publication's shell Publisher installed at the app root (studioShell): the document layout and each state.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "state",
          "entry"
        ],
        "additionalProperties": false,
        "properties": {
          "state": {
            "enum": [
              "document",
              "loading",
              "not-found",
              "error",
              "global-error"
            ]
          },
          "entry": {
            "type": "object",
            "required": [
              "file",
              "export"
            ],
            "additionalProperties": false,
            "properties": {
              "file": {
                "type": "string",
                "pattern": "^studio/app/"
              },
              "export": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
