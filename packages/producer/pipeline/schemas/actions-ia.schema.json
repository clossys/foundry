{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clossys.com/schemas/producer/actions-ia.schema.json",
  "title": "Action grouping (packages/<agent>/actions/ia.json)",
  "description": "The only place actions are grouped: L1 agent, L2 stage, L3 action id. Action folders stay flat.",
  "type": "object",
  "required": [
    "schema",
    "nodes"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "clossys.actions-ia/1"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "children"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "children": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "actions"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "actions": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)*$"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
