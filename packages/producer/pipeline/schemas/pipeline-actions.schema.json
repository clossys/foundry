{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clossys.com/schemas/producer/pipeline-actions.schema.json",
  "title": "Action snapshot (pipeline/actions.json)",
  "description": "Every action contract in pipeline order, generated by scripts/generate-pipeline-actions.mjs; the runtime loads steps from it.",
  "type": "object",
  "required": [
    "schema",
    "actions"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "clossys.pipeline-actions/1"
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "package",
          "path",
          "contract"
        ],
        "additionalProperties": false,
        "properties": {
          "package": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "contract": {
            "$ref": "action.schema.json"
          }
        }
      }
    }
  }
}
