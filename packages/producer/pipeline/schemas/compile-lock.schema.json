{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clossys.com/schemas/producer/compile-lock.schema.json",
  "title": "Studio compile lock (studio/compile.lock.json)",
  "description": "Derived from the clossys.compile-lock/1 file clossys compile writes (lands with claude/compile-pure).",
  "type": "object",
  "required": [
    "schema",
    "decisionInputs",
    "inputs",
    "outputs"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "clossys.compile-lock/1"
    },
    "decisionInputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
