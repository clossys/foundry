{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clossys.com/schemas/producer/pipeline-graph.schema.json",
  "title": "Pipeline graph (pipeline/graph.json)",
  "description": "Derived from src/pipeline/graph.ts PipelineGraph as graphJson writes it with --out (no live status).",
  "type": "object",
  "required": [
    "schema",
    "rule",
    "nodes",
    "edges",
    "untyped",
    "layout",
    "seats",
    "roster",
    "options"
  ],
  "additionalProperties": false,
  "$defs": {
    "port": {
      "type": "object",
      "required": [
        "glob"
      ],
      "additionalProperties": false,
      "properties": {
        "glob": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "schema": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        }
      }
    }
  },
  "properties": {
    "schema": {
      "const": "clossys.pipeline-graph/1"
    },
    "rule": {
      "const": "R-PIPELINE-IS-CODE"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "actor",
          "stage",
          "summary",
          "inputs",
          "outputs",
          "command",
          "checks",
          "holder",
          "layout",
          "agent",
          "package",
          "pass",
          "record",
          "uses"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]*$"
          },
          "kind": {
            "enum": [
              "decide:judgment",
              "decide:creative",
              "plumb"
            ]
          },
          "actor": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "stage": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)?$"
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "inputs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/port"
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/port"
            }
          },
          "command": {
            "type": "object"
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          },
          "open": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "seat": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "holder": {
            "type": "object",
            "required": [
              "id",
              "kind",
              "source",
              "tier"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "kind": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "tier": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                ]
              }
            }
          },
          "layout": {
            "type": "object",
            "required": [
              "lane",
              "stage",
              "rank",
              "x",
              "y"
            ],
            "additionalProperties": false,
            "properties": {
              "lane": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "stage": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)?$"
              },
              "rank": {
                "type": "integer",
                "minimum": 0
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            }
          },
          "agent": {
            "enum": [
              "director",
              "designer",
              "writer",
              "publisher",
              "producer",
              "owner"
            ]
          },
          "run": {
            "type": "string",
            "pattern": "^clossys [a-z]"
          },
          "gap": {
            "type": "object",
            "required": [
              "unit",
              "reason"
            ],
            "additionalProperties": false,
            "properties": {
              "unit": {
                "type": "string",
                "pattern": "^W[0-9][a-z0-9]*$"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "pass": {
            "type": "object",
            "required": [
              "command",
              "exit"
            ],
            "additionalProperties": false,
            "properties": {
              "command": {
                "type": "string",
                "pattern": "^clossys [a-z]"
              },
              "exit": {
                "type": "object",
                "required": [
                  "pass",
                  "fail",
                  "error"
                ],
                "additionalProperties": false,
                "properties": {
                  "pass": {
                    "const": [
                      0
                    ]
                  },
                  "fail": {
                    "const": [
                      1
                    ]
                  },
                  "error": {
                    "const": [
                      2
                    ]
                  }
                }
              }
            }
          },
          "record": {
            "const": "clossys.pipeline-run/1"
          },
          "decider": {
            "enum": [
              "owner",
              "agent"
            ]
          },
          "uses": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "package": {
            "enum": [
              "director",
              "designer",
              "writer",
              "publisher",
              "producer"
            ]
          },
          "packet": {
            "type": "object",
            "required": [
              "inputs",
              "write",
              "checks"
            ],
            "additionalProperties": false,
            "properties": {
              "inputs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "write": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "glob",
                    "schema"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "glob": {
                      "type": "string",
                      "minLength": 1
                    },
                    "schema": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]*$"
                    }
                  }
                }
              },
              "checks": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "via"
        ],
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "to": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "via": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "output",
                "input",
                "schema"
              ],
              "additionalProperties": false,
              "properties": {
                "output": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "input": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "schema": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                }
              }
            }
          }
        }
      }
    },
    "untyped": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "step",
          "port",
          "glob"
        ],
        "additionalProperties": false,
        "properties": {
          "step": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "port": {
            "enum": [
              "input",
              "output"
            ]
          },
          "glob": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "layout": {
      "type": "object",
      "required": [
        "constants",
        "crossings",
        "lanes",
        "stages",
        "cycleBreaks"
      ],
      "additionalProperties": false,
      "properties": {
        "constants": {
          "type": "object"
        },
        "crossings": {
          "type": "object"
        },
        "lanes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        },
        "rounds": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "index",
              "x",
              "y",
              "width",
              "stages"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "width": {
                "type": "number"
              },
              "stages": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*\\.[a-z0-9][a-z0-9-]*$"
                }
              }
            }
          }
        },
        "cycleBreaks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to"
            ],
            "additionalProperties": false,
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "to": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        }
      }
    },
    "seats": {
      "type": "object"
    },
    "roster": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "options": {
      "type": "object"
    }
  }
}
