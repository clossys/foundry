{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clossys.com/schemas/producer/standard.schema.json",
  "title": "Standard requirements (packages/<agent>/standards/<id>/requirements.json)",
  "description": "The judge of one slot kind or answer shape (R15.2, slot-constitution.md section 3). Read by src/records/standards.ts. mode adopt-first carries createGaps (the gap classes a create may name, R03.5); a craft standard has none. Only Designer standards list seeds (R15.9, checked in code against the agent policy.json). Requirements name criteria registered under src/constitution/criteria/*/index.json (R15.3); counts the validator cannot express (seed registries, criterion ids) are checked in code.",
  "type": "object",
  "required": [
    "schema",
    "id",
    "kinds",
    "mode",
    "craftTier",
    "seeds",
    "requirements"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "clossys.standard/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)*$"
    },
    "kinds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^(brief|element|strings|page|publication|seat)(/[a-z][a-z0-9-]*)?$"
      }
    },
    "mode": {
      "enum": [
        "adopt-first",
        "craft"
      ]
    },
    "craftTier": {
      "enum": [
        "high",
        "mid"
      ]
    },
    "seeds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^\\S+$"
      }
    },
    "createGaps": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirement"
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "mode": {
          "const": "adopt-first"
        }
      },
      "required": [
        "createGaps"
      ]
    },
    {
      "properties": {
        "mode": {
          "const": "craft"
        }
      },
      "not": {
        "required": [
          "createGaps"
        ]
      }
    }
  ],
  "$defs": {
    "requirement": {
      "type": "object",
      "required": [
        "check",
        "params"
      ],
      "additionalProperties": false,
      "properties": {
        "check": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$"
        },
        "params": {
          "type": "object"
        }
      }
    }
  }
}
