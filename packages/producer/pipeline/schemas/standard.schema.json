{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clossys.com/schemas/producer/standard.schema.json",
  "title": "Standard requirements (packages/<agent>/standards/<id>/requirements.json)",
  "description": "The judge of one slot kind or answer shape (R15.2, slot-constitution.md section 3). Read by src/records/standards.ts. mode adopt-first carries createGaps (the gap classes a create may name, R03.5); a craft standard has none. Only Designer standards list seeds (R15.9, checked in code against the agent policy.json). createOnly (const true, with a non-empty createOnlyReason; the two come together; only on a craft standard, never adopt-first; with seeds empty, expressed as not minItems 1 since the validator reads no maxItems) marks a standard whose slots have no seed and no package default: every candidate is created, and the reason says why (R15, K2). Requirements name criteria registered under src/constitution/criteria/*/index.json (R15.3); counts the validator cannot express (seed registries, criterion ids) are checked in code. preview.card (optional here, foundry-feedback-0014 SC-0) is the kind's slot-card preview contract that R18.13 requires of every standard: method inline (rendered from candidate data, intrinsicWidth null) or frame (an iframe of /__specimen at intrinsicWidth px, scaled and top-cropped to the 4:3 box); mustContain CSS selectors (R18.15); states from the shared five-state set. Method/width pairing and duplicate entries are checked in code.",
  "type": "object",
  "required": [
    "schema",
    "id",
    "kinds",
    "mode",
    "craftTier",
    "seeds",
    "requirements"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "clossys.standard/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)*$"
    },
    "kinds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^(brief|element|strings|page|publication|seat)(/[a-z][a-z0-9-]*)?$"
      }
    },
    "mode": {
      "enum": [
        "adopt-first",
        "craft"
      ]
    },
    "craftTier": {
      "enum": [
        "high",
        "mid"
      ]
    },
    "seeds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^\\S+$"
      }
    },
    "createOnly": {
      "const": true
    },
    "createOnlyReason": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "createGaps": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "preview": {
      "$ref": "#/$defs/preview"
    }
  },
  "oneOf": [
    {
      "properties": {
        "mode": {
          "const": "adopt-first"
        }
      },
      "required": [
        "createGaps"
      ],
      "not": {
        "required": [
          "createOnly"
        ]
      }
    },
    {
      "properties": {
        "mode": {
          "const": "craft"
        }
      },
      "not": {
        "required": [
          "createGaps"
        ]
      }
    }
  ],
  "$defs": {
    "requirement": {
      "type": "object",
      "required": [
        "check",
        "params"
      ],
      "additionalProperties": false,
      "properties": {
        "check": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$"
        },
        "params": {
          "type": "object"
        }
      }
    },
    "preview": {
      "type": "object",
      "required": [
        "card"
      ],
      "additionalProperties": false,
      "properties": {
        "card": {
          "$ref": "#/$defs/card"
        }
      }
    },
    "card": {
      "type": "object",
      "required": [
        "method",
        "intrinsicWidth",
        "mustContain",
        "states"
      ],
      "additionalProperties": false,
      "properties": {
        "method": {
          "enum": [
            "inline",
            "frame"
          ]
        },
        "intrinsicWidth": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "mustContain": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "states": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "loading",
              "not-needed",
              "no-preview",
              "failed",
              "not-pinned"
            ]
          }
        }
      }
    }
  },
  "anyOf": [
    {
      "not": {
        "anyOf": [
          {
            "required": [
              "createOnly"
            ]
          },
          {
            "required": [
              "createOnlyReason"
            ]
          }
        ]
      }
    },
    {
      "required": [
        "createOnly",
        "createOnlyReason"
      ],
      "properties": {
        "seeds": {
          "not": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
