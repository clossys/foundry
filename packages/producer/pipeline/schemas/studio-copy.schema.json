{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clossys.com/schemas/producer/studio-copy.schema.json",
  "title": "Studio copy (studio/generated/studio-copy.json)",
  "description": "Writer copy the Studio renders, generated by scripts/generate-studio-map.mjs from the pinned Writer candidates.",
  "type": "object",
  "required": [
    "id",
    "locale",
    "revision",
    "source",
    "entries"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "locale": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "required": [
        "kind",
        "reference"
      ]
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
