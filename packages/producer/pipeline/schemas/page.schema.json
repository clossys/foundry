{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clossys.com/schemas/producer/page.schema.json",
  "title": "Page record",
  "description": "Derived from src/records/slot-model/validate.ts validateJsonCandidate kind page (PAGE_SCHEMA).",
  "type": "object",
  "required": [
    "schema",
    "title",
    "frame",
    "sections",
    "copy"
  ],
  "properties": {
    "schema": {
      "const": "clossys.page/1"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "path": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "frame": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*){1,3}$"
        }
      ]
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*){1,3}$"
      }
    },
    "copy": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*){1,3}#[^\\s#]+$"
      }
    },
    "bindings": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*){1,3}(#[1-9][0-9]*)?$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "copy": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*){1,3}#[^\\s#]+$"
            }
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "required": [
        "path"
      ]
    },
    {
      "required": [
        "slug"
      ]
    }
  ]
}
