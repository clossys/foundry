{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clossys.com/schemas/producer/source.schema.json",
  "title": "Candidate source",
  "description": "Derived from src/records/slot-model/validate.ts validateSource and SourceDoc (types.ts).",
  "type": "object",
  "required": [
    "kind",
    "ref"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "enum": [
        "registry",
        "derived",
        "original",
        "composition"
      ]
    },
    "ref": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "slot",
          "files"
        ],
        "additionalProperties": false,
        "properties": {
          "slot": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*){1,3}$"
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "hash": {
      "type": "string"
    },
    "license": {
      "type": "string"
    }
  },
  "anyOf": [
    {
      "properties": {
        "kind": {
          "const": "original"
        }
      },
      "not": {
        "required": [
          "parts"
        ]
      }
    },
    {
      "properties": {
        "kind": {
          "const": "composition"
        }
      },
      "required": [
        "parts"
      ]
    },
    {
      "properties": {
        "kind": {
          "enum": [
            "registry",
            "derived"
          ]
        },
        "ref": {
          "type": "array",
          "minItems": 1
        }
      },
      "not": {
        "required": [
          "parts"
        ]
      }
    }
  ]
}
