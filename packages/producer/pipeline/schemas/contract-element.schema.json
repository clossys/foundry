{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clossys.com/schemas/producer/contract-element.schema.json",
  "title": "Element slot contract (contract in clossys/agents/designer/<slot>/slot.json)",
  "description": "Derived from src/records/slot-model/contract-fixture.ts contractFixtureIssues. The contract is otherwise free-form until W2-I's standards; R01.3 requires the fixture, this schema gives its shape: a clossys.element-preview/1 preview whose fixtures.props are declared in contract.props.",
  "type": "object",
  "properties": {
    "fixture": {
      "type": "object",
      "required": [
        "schema",
        "fixtures"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "clossys.element-preview/1"
        },
        "fixtures": {
          "type": "object",
          "required": [
            "file",
            "export",
            "props"
          ],
          "additionalProperties": false,
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "export": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "props": {
              "type": "object"
            }
          }
        },
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "copy": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "slots": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "container": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "theme": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "copy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        }
      }
    },
    "props": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
