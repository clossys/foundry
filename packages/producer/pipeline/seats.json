    "seats": {
      "by": "owner",
      "llm": {
        "model": "<model:mid>",
        "tier": "mid",
        "promptFile": "packages/producer/actions/seats/skill.md"
      },
      "human": {
        "procedure": "Decide who holds each decide step: an llm seat (model and prompt file), a human seat (procedure and the clossys command that records it), or both.",
        "command": "clossys seat"
