        "model": "<model:mid>",
        "tier": "mid",
        "promptFile": "packages/producer/actions/workspace.config/skill.md"
      },
      "human": {
        "procedure": "Decide the workspace config: which folder is the consumer workspace and the settings the CLI reads.",
        "command": "clossys config"
      }
