{
  "schema": "clossys.pipeline-seats/1",
  "about": "The Producer seat tree: one seat.<step> slot per decide step, under its round and stage, and each seat's package default. Generated from the pipeline steps by scripts/generate-pipeline-seats.mjs; the labels are authored. The model is a tier placeholder the consumer's seat-policy.json fills.",
  "nodes": [
    {
      "id": "direct",
      "label": "Direct",
      "children": [
        {
          "id": "direct.brief",
          "label": "Brief",
          "slots": [
            "seat.ia",
            "seat.standard",
            "seat.retire",
            "seat.evidence",
            "seat.workspace.config",
            "seat.seats",
            "seat.rules",
            "seat.owner.decisions"
          ]
        },
        {
          "id": "direct.make",
          "label": "Make",
          "slots": [
            "seat.director.candidates"
          ]
        },
        {
          "id": "direct.pin",
          "label": "Pin",
          "slots": [
            "seat.pick.director",
            "seat.pin.director"
          ]
        }
      ]
    },
    {
      "id": "design",
      "label": "Design",
      "children": [
        {
          "id": "design.make",
          "label": "Make",
          "slots": [
            "seat.designer.candidates",
            "seat.writer.candidates"
          ]
        },
        {
          "id": "design.pin",
          "label": "Pin",
          "slots": [
            "seat.pick.designer",
            "seat.pick.writer",
            "seat.writer.approve",
            "seat.pin.designer",
            "seat.pin.writer"
          ]
        }
      ]
    },
    {
      "id": "publish",
      "label": "Publish",
      "children": [
        {
          "id": "publish.make",
          "label": "Make",
          "slots": [
            "seat.publisher.candidates"
          ]
        },
        {
          "id": "publish.pin",
          "label": "Pin",
          "slots": [
            "seat.pick.publisher",
            "seat.pin.publisher"
          ]
        },
        {
          "id": "publish.assemble",
          "label": "Assemble",
          "slots": [
            "seat.critic",
            "seat.verdict",
            "seat.reissue"
          ]
        }
      ]
    }
  ],
  "seats": {
    "ia": {
      "by": "owner",
      "llm": {
        "model": "<model:mid>",
        "tier": "mid",
        "promptFile": "packages/producer/actions/ia/skill.md"
      },
      "human": {
        "procedure": "Decide where each L3 slot sits in its agent's IA tree (L1, L2) and what the slot is for: its contract in slot.json.",
        "command": "clossys ia"
      }
    },
    "standard": {
      "by": "owner",
      "llm": {
        "model": "<model:mid>",
        "tier": "mid",
        "promptFile": "packages/producer/actions/standard/skill.md"
      },
      "human": {
        "procedure": "Say what every candidate of a slot kind must satisfy, independently of whoever crafts it, through the verb, never by editing standard files by hand.",
        "command": "clossys standard"
      }
    },
    "retire": {
      "by": "owner",
      "llm": {
        "model": "<model:mid>",
        "tier": "mid",
        "promptFile": "packages/producer/actions/retire/skill.md"
      },
      "human": {
        "procedure": "Retire what a slot no longer needs, through the verb, never by moving files by hand.",
        "command": "clossys retire"
      }
    },
    "evidence": {
      "by": "owner",
      "llm": {
        "model": "<model:mid>",
        "tier": "mid",
        "promptFile": "packages/producer/actions/evidence/skill.md"
      },
      "human": {
        "procedure": "Decide which owner answers and findings the Director may cite.",
        "command": "clossys evidence"
