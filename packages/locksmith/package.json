{
  "name": "@clossys/locksmith",
  "version": "0.2.8",
  "private": false,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./infisical": {
      "types": "./dist/infisical/index.d.ts",
      "import": "./dist/infisical/index.js"
    }
  },
  "bin": {
    "clossys-secrets-infisical": "dist/infisical/cli.js",
    "vespene-secrets-infisical": "dist/infisical/cli.js",
    "clossys-locksmith-credential": "dist/bin.js",
    "locksmith-check": "dist/controlled-key-rate-cli.js",
    "clossys-locksmith-provider-custody": "dist/provider-custody-cli.js"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "skill"
  ],
  "sideEffects": false,
  "foundry": {
    "assessment": {
      "bin": "locksmith-check",
      "invocation": "single-json-input"
    }
  },
  "description": "Key custody, distribution, rotation, revocation, credential lifecycle evaluation, and provider-neutral secret resolution through environment, test, and optional Infisical adapters.",
  "keywords": [
    "secrets",
    "custody",
    "rotation",
    "revocation",
    "distribution",
    "key-management",
    "configuration",
    "dependency-injection",
    "environment",
    "typescript",
    "infisical",
    "oidc",
    "cli"
  ],
  "author": "Clossys",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clossys/foundry.git",
    "directory": "packages/locksmith"
  },
  "bugs": {
    "url": "https://github.com/clossys/foundry/issues"
  },
  "homepage": "https://github.com/clossys/foundry/tree/main/packages/locksmith#readme",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "node ../../scripts/check-name-collision.mjs . && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "typescript": "~6.0.0",
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
