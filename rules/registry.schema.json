{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "foundry.rule-registry/1",
  "title": "Foundry owner rule registry",
  "description": "Owner rules as code. scripts/check-rules.mjs (check:rules) validates this shape by hand and fails on unenforced rules, unreachable checks, checks that pass their violation fixture, and check scripts that map to no rule.",
  "type": "object",
  "required": [
    "schema",
    "rules"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema": {
      "const": "foundry.rule-registry/1"
    },
    "about": {
      "type": "string"
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "exemptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exemption"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "checkRef": {
      "description": "<package dir>#<npm script> (root is \".\"), or check:studio#<sub-check id> for a packages/producer check:studio manifest entry.",
      "type": "string",
      "pattern": "^(check:studio#.+|[^#]+#[^#]+)$"
    },
    "rule": {
      "type": "object",
      "required": [
        "id",
        "owner_words",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^R-[A-Z0-9-]+$"
        },
        "audit_rule": {
          "type": "integer",
          "minimum": 1,
          "description": "Row number in the 2026-11-03 rules audit."
        },
        "owner_words": {
          "type": "object",
          "required": [
            "quote",
            "date"
          ],
          "properties": {
            "quote": {
              "type": "string",
              "maxLength": 200,
              "pattern": "^[^\\n]+$"
            },
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          },
          "additionalProperties": false
        },
        "status": {
          "enum": [
            "enforced",
            "unenforced",
            "pending-wire"
          ],
          "description": "unenforced and pending-wire always fail check:rules (pending-wire is reported as unwired)."
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/checkRef"
          },
          "description": "Checks that enforce the rule; each must be reachable from root check and fail on the fixture."
        },
        "related": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/checkRef"
          },
          "description": "Checks that map to the rule but claim no enforcement."
        },
        "fixture": {
          "type": "string",
          "description": "Repository-relative minimal violation fixture directory."
        },
        "fixture_runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fixtureRun"
          }
        },
        "note": {
          "type": "string",
          "pattern": "^[^\\n]+$"
        },
        "pending_wire": {
          "type": "object",
          "required": [
            "check",
            "branch"
          ],
          "description": "The check being built elsewhere and the branch it lands from.",
          "properties": {
            "check": {
              "type": "string",
              "pattern": "^[^\\n]+$"
            },
            "branch": {
              "type": "string",
              "pattern": "^[^\\n]+$"
            }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "enforced"
              }
            }
          },
          "then": {
            "required": [
              "checks",
              "fixture",
              "fixture_runs"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "unenforced"
              }
            }
          },
          "then": {
            "required": [
              "note"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "pending-wire"
              }
            }
          },
          "then": {
            "required": [
              "pending_wire",
              "note"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "fixtureRun": {
      "type": "object",
      "required": [
        "check",
        "cwd",
        "run",
        "expect"
      ],
      "properties": {
        "check": {
          "$ref": "#/$defs/checkRef"
        },
        "cwd": {
          "type": "string",
          "description": "Repository-relative working directory."
        },
        "fixture": {
          "type": "string",
          "description": "Overrides the rule fixture for this run."
        },
        "run": {
          "type": "string",
          "description": "The check's own command with a fixture-root flag; {fixture} and {out} are substituted."
        },
        "expect": {
          "type": "string",
          "description": "Multiline regular expression the output must match, proving the check saw the violation."
        },
        "expect_exit": {
          "type": "integer",
          "default": 1
        }
      },
      "additionalProperties": false
    },
    "exemption": {
      "type": "object",
      "required": [
        "check",
        "reason"
      ],
      "properties": {
        "check": {
          "$ref": "#/$defs/checkRef"
        },
        "reason": {
          "type": "string",
          "minLength": 20,
          "pattern": "^[^\\n]+$"
        }
      },
      "additionalProperties": false
    }
  }
}
